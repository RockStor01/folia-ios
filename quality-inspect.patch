+// src/services/localSongRawTags.ts
+// 車機的 MediaMetadataRetriever 會用錯編碼解標籤，整串變成 �（位元組已經被丟掉，事後再修也救不回來）。
+// 這裡改成自己讀檔案的原始位元組：ID3v2（mp3／wav／aiff／tta／dsf／dff）、VORBIS_COMMENT（flac）、
+// MP4 ilst（m4a／alac）、RIFF INFO（wav）、APEv2（ape／wv／tak），
+// 再按標籤自己的編碼位元組／BOM／UTF-8 有效性解一次，拿到的就是正確原文。
+import { fetchNativeRange } from './nativeLinkedStorage';
+import { getLocalSongs, saveLocalSongs } from './db';
+import type { LocalSong } from '../types';
+
+export interface RawTagStrings {
+    title?: string;
+    artist?: string;
+    album?: string;
+}
+
+const TAG_HEAD_BYTES = 4 * 1024 * 1024;
+// APEv2 的 footer 在檔案最尾端，DSF／DFF 的 ID3 也常貼在資料區後面，所以頭讀不到時再讀尾巴。
+const TAG_TAIL_BYTES = 512 * 1024;
+
+const utf8Strict = new TextDecoder('utf-8', { fatal: true });
+
+const decodeStrict = (bytes: Uint8Array, label: string): string | null => {
+    try {
+        return new TextDecoder(label, { fatal: true }).decode(bytes);
+    } catch {
+        return null;
+    }
+};
+
+/** 標籤位元組→字串：先看 BOM，再 UTF-8 嚴格解，最後才退回 GB18030／Big5／Latin-1。 */
+const decodeTextBytes = (bytes: Uint8Array, declared?: 'latin1' | 'utf16' | 'utf16be' | 'utf8'): string => {
+    if (bytes.length === 0) return '';
+    if (bytes[0] === 0xff && bytes[1] === 0xfe) {
+        const text = decodeStrict(bytes.subarray(2), 'utf-16le');
+        if (text) return text;
+    }
+    if (bytes[0] === 0xfe && bytes[1] === 0xff) {
+        const text = decodeStrict(bytes.subarray(2), 'utf-16be');
+        if (text) return text;
+    }
+    if (declared === 'utf16') {
+        const le = decodeStrict(bytes, 'utf-16le');
+        const be = decodeStrict(bytes, 'utf-16be');
+        // 沒有 BOM 的 UTF-16：看得出哪一種才用。
+        if (le && !/\ufffd/u.test(le) && /[\u4e00-\u9fff\u0020-\u007e]/u.test(le)) return le;
+        if (be && !/\ufffd/u.test(be)) return be;
+    }
+    if (declared === 'utf16be') {
+        const be = decodeStrict(bytes, 'utf-16be');
+        if (be) return be;
+    }
+    const utf8 = decodeStrict(bytes, 'utf-8');
+    if (utf8) return utf8;
+    // 不是合法 UTF-8：老盤多半是 GBK（簡中）或 Big5（繁中）。兩者都可能解得出來，挑沒有壞字元、中文多的。
+    const gbk = decodeStrict(bytes, 'gb18030');
+    const big5 = decodeStrict(bytes, 'big5');
+    const score = (value: string | null): number => {
+        if (!value) return -Infinity;
+        let total = 0;
+        for (const char of Array.from(value)) {
+            if (/\ufffd/u.test(char)) total -= 4;
+            else if (/[\u4e00-\u9fff]/u.test(char)) total += 2;
+            else if (char.codePointAt(0)! < 0x80) total += 0.2;
+        }
+        return total;
+    };
+    if (score(gbk) >= score(big5) && gbk) return gbk;
+    if (big5) return big5;
+    return new TextDecoder('latin1').decode(bytes);
+};
+
+const clean = (value: string): string => value.replace(/\u0000+$/u, '').replace(/^\u0000+/u, '').trim();
+
+const readSynchsafe = (bytes: Uint8Array, offset: number): number => (
+    ((bytes[offset] & 0x7f) << 21)
+    | ((bytes[offset + 1] & 0x7f) << 14)
+    | ((bytes[offset + 2] & 0x7f) << 7)
+    | (bytes[offset + 3] & 0x7f)
+);
+
+const readUint32BE = (bytes: Uint8Array, offset: number): number => (
+    ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) >>> 0
+);
+
+const readUint32LE = (bytes: Uint8Array, offset: number): number => (
+    (bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)) >>> 0
+);
+
+const ascii = (bytes: Uint8Array, offset: number, length: number): string => {
+    let out = '';
+    for (let index = 0; index < length; index += 1) out += String.fromCharCode(bytes[offset + index] ?? 0);
+    return out;
+};
+
+/** ID3v2：逐個 frame 找 TIT2／TPE1／TALB，照 frame 開頭的編碼位元組解。 */
+const readId3Tags = (bytes: Uint8Array, out: RawTagStrings): void => {
+    if (bytes.length < 10 || ascii(bytes, 0, 3) !== 'ID3') return;
+    const major = bytes[3];
+    const flags = bytes[5];
+    let offset = 10;
+    const tagSize = readSynchsafe(bytes, 6);
+    const end = Math.min(bytes.length, offset + tagSize);
+    if ((flags & 0x80) !== 0) return; // 整段 unsynchronised 的少見，直接交給既有的修法。
+    while (offset + 10 <= end) {
+        const id = ascii(bytes, offset, 4);
+        if (!/^[A-Z0-9]{4}$/u.test(id)) break;
+        const rawSize = readUint32BE(bytes, offset + 4);
+        // v2.3 的 frame 長度是普通 32-bit，v2.4 才是 synchsafe；不合理就換另一種讀法。
+        let size = rawSize;
+        if (major === 4 || size > end - offset - 10) size = readSynchsafe(bytes, offset + 4);
+        const payloadStart = offset + 10;
+        if (size <= 0 || payloadStart + size > end) break;
+        const encoding = bytes[payloadStart];
+        const declared = encoding === 0 ? 'latin1' : encoding === 1 ? 'utf16' : encoding === 2 ? 'utf16be' : 'utf8';
+        const value = clean(decodeTextBytes(bytes.subarray(payloadStart + 1, payloadStart + size), declared));
+        if (value) {
+            if (id === 'TIT2' && !out.title) out.title = value;
+            else if (id === 'TPE1' && !out.artist) out.artist = value;
+            else if (id === 'TALB' && !out.album) out.album = value;
+        }
+        offset = payloadStart + size;
+    }
+};
+
+/** FLAC：metadata block type 4 = VORBIS_COMMENT，內容一律 UTF-8。 */
+const readFlacTags = (bytes: Uint8Array, out: RawTagStrings): void => {
+    let offset = 4;
+    while (offset + 4 <= bytes.length) {
+        const header = bytes[offset];
+        const type = header & 0x7f;
+        const length = ((bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]) >>> 0;
+        const bodyStart = offset + 4;
+        if (bodyStart + length > bytes.length) break;
+        if (type === 4) {
+            let cursor = bodyStart;
+            const vendorLength = readUint32LE(bytes, cursor);
+            cursor += 4 + vendorLength;
+            const count = readUint32LE(bytes, cursor);
+            cursor += 4;
+            for (let index = 0; index < count && cursor + 4 <= bodyStart + length; index += 1) {
+                const commentLength = readUint32LE(bytes, cursor);
+                cursor += 4;
+                const comment = decodeTextBytes(bytes.subarray(cursor, cursor + commentLength), 'utf8');
+                cursor += commentLength;
+                const equals = comment.indexOf('=');
+                if (equals <= 0) continue;
+                const key = comment.slice(0, equals).toUpperCase();
+                const value = clean(comment.slice(equals + 1));
+                if (key === 'TITLE' && !out.title) out.title = value;
+                else if (key === 'ARTIST' && !out.artist) out.artist = value;
+                else if (key === 'ALBUM' && !out.album) out.album = value;
+            }
+            return;
+        }
+        if ((header & 0x80) !== 0) return;
+        offset = bodyStart + length;
+    }
+};
+
+/** MP4／M4A／ALAC：在 moov/udta/meta/ilst 裡找 ©nam／©ART／©alb 的 data box。 */
+const readMp4Tags = (bytes: Uint8Array, out: RawTagStrings): void => {
+    const wanted: Array<[string, keyof RawTagStrings]> = [
+        ['\u00a9nam', 'title'],
+        ['\u00a9ART', 'artist'],
+        ['\u00a9alb', 'album'],
+    ];
+    for (const [name, key] of wanted) {
+        const needle = [0xa9, name.charCodeAt(1), name.charCodeAt(2), name.charCodeAt(3)];
+        for (let index = 8; index + 16 < bytes.length; index += 1) {
+            if (bytes[index] !== needle[0] || bytes[index + 1] !== needle[1]
+                || bytes[index + 2] !== needle[2] || bytes[index + 3] !== needle[3]) continue;
+            // 緊接著應該是 data box。
+            const dataBoxStart = index + 4;
+            if (ascii(bytes, dataBoxStart + 4, 4) !== 'data') continue;
+            const dataSize = readUint32BE(bytes, dataBoxStart);
+            const payloadStart = dataBoxStart + 16;
+            const payloadEnd = Math.min(bytes.length, dataBoxStart + Math.max(0, dataSize));
+            if (payloadStart >= payloadEnd) continue;
+            const value = clean(decodeTextBytes(bytes.subarray(payloadStart, payloadEnd), 'utf8'));
+            if (value && !out[key]) out[key] = value;
+            break;
+        }
+    }
+};
+
+/** WAV：RIFF 內的 LIST/INFO（INAM／IART／IPRD），或 RIFF 裡的 id3 chunk。 */
+const readWavTags = (bytes: Uint8Array, out: RawTagStrings): void => {
+    let offset = 12;
+    while (offset + 8 <= bytes.length) {
+        const id = ascii(bytes, offset, 4);
+        const size = readUint32LE(bytes, offset + 4);
+        const bodyStart = offset + 8;
+        const bodyEnd = Math.min(bytes.length, bodyStart + size);
+        if (id === 'LIST' && ascii(bytes, bodyStart, 4) === 'INFO') {
+            let cursor = bodyStart + 4;
+            while (cursor + 8 <= bodyEnd) {
+                const subId = ascii(bytes, cursor, 4);
+                const subSize = readUint32LE(bytes, cursor + 4);
+                const value = clean(decodeTextBytes(bytes.subarray(cursor + 8, Math.min(bodyEnd, cursor + 8 + subSize))));
+                if (value) {
+                    if (subId === 'INAM' && !out.title) out.title = value;
+                    else if (subId === 'IART' && !out.artist) out.artist = value;
+                    else if (subId === 'IPRD' && !out.album) out.album = value;
+                }
+                cursor += 8 + subSize + (subSize & 1);
+            }
+        } else if (id === 'id3 ' || id === 'ID3 ') {
+            readId3Tags(bytes.subarray(bodyStart, bodyEnd), out);
+        }
+        offset = bodyStart + size + (size & 1);
+    }
+};
+
+/** AIFF／AIFC：FORM 內的 'ID3 ' chunk（大端長度）。 */
+const readAiffTags = (bytes: Uint8Array, out: RawTagStrings): void => {
+    let offset = 12;
+    while (offset + 8 <= bytes.length) {
+        const id = ascii(bytes, offset, 4);
+        const size = readUint32BE(bytes, offset + 4);
+        const bodyStart = offset + 8;
+        if (bodyStart + size > bytes.length) break;
+        if (id === 'ID3 ') readId3Tags(bytes.subarray(bodyStart, bodyStart + size), out);
+        offset = bodyStart + size + (size & 1);
+    }
+};
+
+/** APEv2：footer 在檔案最尾端，也可能有 header；item 依序是長度／flags／key…／值。 */
+const readApeTags = (bytes: Uint8Array, out: RawTagStrings): boolean => {
+    // 找最後一個 APETAGEX。
+    let footer = -1;
+    for (let index = bytes.length - 32; index >= 0; index -= 1) {
+        if (ascii(bytes, index, 8) === 'APETAGEX') { footer = index; break; }
+    }
+    if (footer < 0) return false;
+    const tagSize = readUint32LE(bytes, footer + 12);
+    const count = readUint32LE(bytes, footer + 16);
+    if (tagSize < 32) return false;
+    const itemsStart = Math.max(0, footer - (tagSize - 32));
+    let cursor = itemsStart;
+    for (let index = 0; index < count && cursor + 9 <= footer; index += 1) {
+        const itemSize = readUint32LE(bytes, cursor);
+        if (itemSize <= 9 || cursor + itemSize > footer) break;
+        const keyStart = cursor + 8;
+        let keyEnd = keyStart;
+        while (keyEnd < cursor + itemSize && bytes[keyEnd] !== 0) keyEnd += 1;
+        const key = ascii(bytes, keyStart, keyEnd - keyStart).toLowerCase();
+        const value = clean(decodeTextBytes(bytes.subarray(keyEnd + 1, cursor + itemSize), 'utf8'));
+        if (value) {
+            if ((key === 'title' || key === 'name') && !out.title) out.title = value;
+            else if (key === 'artist' && !out.artist) out.artist = value;
+            else if (key === 'album' && !out.album) out.album = value;
+        }
+        cursor += itemSize;
+    }
+    return true;
+};
+
+/** DSF／DFF／TAK／TTA 這些把 ID3v2 塞在容器裡或檔尾：直接掃 'ID3' 標記。 */
+const scanEmbeddedId3 = (bytes: Uint8Array, out: RawTagStrings): void => {
+    for (let index = 0; index + 10 <= bytes.length; index += 1) {
+        if (bytes[index] !== 0x49 || bytes[index + 1] !== 0x44 || bytes[index + 2] !== 0x33) continue;
+        const major = bytes[index + 3];
+        if (major < 2 || major > 4) continue;
+        const copy: RawTagStrings = {};
+        readId3Tags(bytes.subarray(index), copy);
+        if (copy.title || copy.artist || copy.album) {
+            if (copy.title && !out.title) out.title = copy.title;
+            if (copy.artist && !out.artist) out.artist = copy.artist;
+            if (copy.album && !out.album) out.album = copy.album;
+            return;
+        }
+    }
+};
+
+/**
+ * 解析一份位元組（可以是檔頭，也可以是檔尾）；認得的容器都試一輪。
+ * 副檔名只用來決定要不要試 MP4，其餘靠 magic 判斷。
+ */
+export const parseRawTags = (bytes: Uint8Array, fileName: string): RawTagStrings | null => {
+    const out: RawTagStrings = {};
+    const lower = fileName.toLowerCase();
+    try {
+        if (bytes.length >= 10 && ascii(bytes, 0, 3) === 'ID3') readId3Tags(bytes, out);
+        else if (ascii(bytes, 0, 4) === 'fLaC') readFlacTags(bytes, out);
+        else if (ascii(bytes, 0, 4) === 'RIFF') readWavTags(bytes, out);
+        else if (ascii(bytes, 0, 4) === 'FORM') readAiffTags(bytes, out);
+        else if (lower.endsWith('.m4a') || lower.endsWith('.mp4') || lower.endsWith('.alac')) readMp4Tags(bytes, out);
+        if (!out.title && !out.artist && !out.album) readApeTags(bytes, out);
+        if (!out.title && !out.artist && !out.album) scanEmbeddedId3(bytes, out);
+    } catch (error) {
+        console.warn('[RawTags] parse failed', error);
+        return null;
+    }
+    return Object.keys(out).length > 0 ? out : null;
+};
+
+/**
+ * 從原始位元組重讀一首連結歌曲的標籤：先讀檔頭 4 MB，APEv2／DSF 這類貼在檔尾的再讀尾巴 512 KB。
+ */
+export const readLinkedSongRawTags = async (
+    filePath: string,
+    fileName: string,
+    fileSize?: number,
+): Promise<RawTagStrings | null> => {
+    const head = await fetchNativeRange(filePath, TAG_HEAD_BYTES, 0);
+    if (head) {
+        const tags = parseRawTags(new Uint8Array(head), fileName);
+        if (tags) return tags;
+    }
+    const size = fileSize ?? 0;
+    if (size <= 0) return null;
+    const tailLength = Math.min(TAG_TAIL_BYTES, size);
+    const tail = await fetchNativeRange(filePath, tailLength, size - tailLength);
+    if (!tail) return null;
+    return parseRawTags(new Uint8Array(tail), fileName);
+};
+
+/**
+ * 一段文字是不是「已經壞掉」。
+ * v0.9.18：不只 U+FFFD，問號也算——Android 的 MediaMetadataRetriever 用錯編碼時，
+ * 有些機型是把位元組換成 U+FFFD，有些是直接換成 '?'（同一個位元組被丟掉，事後一樣救不回來）。
+ * 判定刻意保守：連續三個以上的 ?、兩個以上 ? 夾在中文之間、或 ? 佔全長一半以上（且至少 3 個）；
+ * 單一問號與句尾的「真的??」都不算，避免把歌名本身就帶問號的正常檔當成壞檔。
+ */
+const CJK_RANGE = '\u3400-\u9fff\uf900-\ufaff';
+const PLACEHOLDER_RUN = /\?\?\?/u;
+const PLACEHOLDER_BETWEEN_CJK = new RegExp(`[${CJK_RANGE}]\\?\\?+[${CJK_RANGE}]`, 'u');
+/** 單一個問號夾在兩個中文字之間；一個不算（可能是歌名本身的問號），兩個以上就當成被吃掉的字。 */
+const QUESTION_BETWEEN_CJK = new RegExp(`[${CJK_RANGE}](?=\\?[${CJK_RANGE}])`, 'gu');
+
+export const hasLostChars = (value: string | null | undefined): boolean => {
+    if (!value) return false;
+    if (/\ufffd/u.test(value)) return true;
+    const trimmed = value.trim();
+    // 整串只有問號（「?」「????」）幾乎不可能是一個正常歌名。
+    if (/^\?+$/u.test(trimmed)) return true;
+    const questionMarks = (value.match(/\?/g) ?? []).length;
+    if (questionMarks === 0) return false;
+    if (PLACEHOLDER_RUN.test(value)) return true;
+    // 開頭就是兩個以上問號：正常歌名不會這樣起頭（句尾的「真的??」仍然放行）。
+    if (/^\?\?/u.test(trimmed)) return true;
+    if (PLACEHOLDER_BETWEEN_CJK.test(value)) return true;
+    if (questionMarks >= 2) {
+        const between = value.match(QUESTION_BETWEEN_CJK) ?? [];
+        if (between.length >= 2) return true;
+    }
+    // 半數以上是問號，且整串夠長（太短像「真的??」這種正常寫法不判）
+    return questionMarks >= 2 && trimmed.length >= 5 && questionMarks / trimmed.length >= 0.5;
+};
+
+/**
+ * 標題救不回來時，退而用檔名（去掉副檔名、開頭的曲目編號、底線）。
+ * 檔名本身也壞掉就回空字串，呼叫端不要拿它去覆蓋。
+ */
+export const fileNameToTitle = (fileName: string): string => {
+    const stem = (fileName ?? '').replace(/\.([a-z0-9]{2,5})$/iu, '');
+    const title = stem
+        .replace(/^\[\d+\]\s*/u, '')
+        .replace(/^\d{1,3}[.\-_\s]+/u, '')
+        .replace(/_+/gu, ' ')
+        .replace(/\s{2,}/gu, ' ')
+        .trim();
+    if (!title || hasLostChars(title)) return '';
+    return title;
+};
+
+/**
+ * 決定一首歌要怎麼補：原始標籤優先，標籤也壞掉就退到檔名（只補標題，歌手／專輯沒有檔名可退）。
+ * 回 null = 沒東西可改，呼叫端不要白寫一次 DB。
+ */
+export const planTagPatch = (song: LocalSong, tags: RawTagStrings): LocalSong | null => {
+    const meta = song.importedMetadata;
+    const titleLost = hasLostChars(song.title);
+    const artistLost = hasLostChars(meta.artistNames.join(''));
+    const albumLost = hasLostChars(meta.albumName);
+    if (!titleLost && !artistLost && !albumLost) return null;
+
+    const next: LocalSong = { ...song, importedMetadata: { ...meta } };
+    let changed = false;
+
+    if (titleLost) {
+        if (tags.title && !hasLostChars(tags.title)) {
+            next.title = tags.title;
+            next.importedMetadata.title = tags.title;
+            changed = true;
+        } else {
+            const fromFileName = fileNameToTitle(song.fileName);
+            if (fromFileName) {
+                next.title = fromFileName;
+                next.importedMetadata.title = fromFileName;
+                next.importedMetadata.titleSource = 'filename';
+                changed = true;
+            }
+        }
+    }
+    if (artistLost && tags.artist && !hasLostChars(tags.artist)) {
+        next.importedMetadata.artistNames = [tags.artist];
+        changed = true;
+    }
+    if (albumLost && tags.album && !hasLostChars(tags.album)) {
+        next.importedMetadata.albumName = tags.album;
+        changed = true;
+    }
+    return changed ? next : null;
+};
