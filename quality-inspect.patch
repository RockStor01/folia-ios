+    options.onProgress?.({ done: candidates.length, total: candidates.length, fileName: '' });
+    if (result.songs.length > 0) notifyLocalMusicUpdated();
+    console.log(`[LocalMusic][Link] Linked ${result.songs.length} file(s), skipped ${result.skipped}, failed ${result.failed.length}`);
+    return result;
