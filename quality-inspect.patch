+                const localSong: LocalSong = {
+                    id: songId,
+                    fileName: file.name,
+                    filePath: `${IMPORTED_LOCAL_ROOT_NAME}/${file.name}`,
+                    duration,
+                    fileSize: file.size,
+                    fileLastModified: file.lastModified,
+                    fileSignature: `${file.name}:${file.size}:${file.lastModified}`,
+                    mimeType: file.type || 'audio/mpeg',
+                    bitrate: embeddedMetadata.bitrate || 0,
+                    addedAt: Date.now(),
+                    title: importedMetadata.title,
+                    titleOrigin: 'import',
+                    importedMetadata,
+                    trackNumber: embeddedMetadata.trackNumber,
+                    discNumber: embeddedMetadata.discNumber,
+                    localCoverAssetId,
+                    localCoverSource: localCoverAssetId ? 'embedded' : undefined,
+                    hasManualLyricSelection: false,
+                    folderName: IMPORTED_LOCAL_ROOT_NAME,
+                    hasEmbeddedLyrics: !!embeddedMetadata.lyrics,
+                    embeddedLyricsContent: embeddedMetadata.lyrics,
+                    hasEmbeddedTranslationLyrics: !!embeddedMetadata.translationLyrics,
+                    embeddedTranslationLyricsContent: embeddedMetadata.translationLyrics,
+                    replayGain: embeddedMetadata.replayGain,
+                    replayGainTrackGain: embeddedMetadata.replayGainTrackGain,
+                    replayGainTrackPeak: embeddedMetadata.replayGainTrackPeak,
+                    replayGainAlbumGain: embeddedMetadata.replayGainAlbumGain,
+                    replayGainAlbumPeak: embeddedMetadata.replayGainAlbumPeak,
+                };
+
+                existingSignatures.add(signature);
+                result.songs.push(localSong);
+                pendingSave.push(localSong);
+                // 存檔分批：見 IMPORT_SAVE_BATCH_SIZE 的說明。
+                if (pendingSave.length >= IMPORT_SAVE_BATCH_SIZE) {
+                    await saveLocalSongs(pendingSave.splice(0));
+                    // 每批寫完就通知一次：兩千多首要跑十幾分鐘，若等到全部跑完才刷新，
+                    // 使用者這十幾分鐘都只看得到「暫無本地音樂」，像沒在做事。
+                    notifyLocalMusicUpdated();
+                }
+            } catch (error) {
+                console.error(`[LocalMusic][Import] Failed to import ${file.name}:`, error);
+                result.failed.push({ fileName: file.name, reason: (error as Error)?.message || 'unknown' });
+            }
+        }
+    }
+
+    // 尾巴那批沒滿的也寫進去。
+    if (pendingSave.length > 0) await saveLocalSongs(pendingSave.splice(0));
+    options.onProgress?.({ done: candidates.length, total: candidates.length, fileName: '' });
+
+    if (result.songs.length > 0) notifyLocalMusicUpdated();
+    console.log(`[LocalMusic][Import] Imported ${result.songs.length} file(s), skipped ${result.skipped}, failed ${result.failed.length}`);
+    return result;
