+import type { LocalSong } from '../types';
+import { LOCAL_MUSIC_UPDATED_EVENT } from './localMusicService';
+import { putLocalSong } from './repositories/localSongRepository';
+import {
+    fetchNativeRange,
+    isLinkedStorageSupported,
+    nativeAudioUrl,
+    listNativeLyrics,
+} from './nativeLinkedStorage';
+
+// src/services/localSongFileLyrics.ts
+// 「連結模式」的歌詞：檔案旁邊的 .lrc／.vtt，或音檔內嵌的歌詞（ID3 USLT、FLAC Vorbis
+// LYRICS、M4A ©lyr）。
+//
+// 為什麼要有這支：Aurora 這類播放器顯示歌詞靠的是檔案本身，而車機上的歌全部留在原地
+// （不抄進 App），WebView 又不可能自己去掃資料夾，所以之前這些歌在歌詞頁一律空白。
+// 這裡把「列同資料夾的歌詞檔」交給原生（listLyrics），內容與解碼都留在 JS：
+// 可以先在瀏覽器與單元測試裡驗證，出問題也只看得到一種解析路徑。
+
+const LYRIC_PREFERENCE = ['lrc', 'vtt'] as const;
+
+export interface FileLyricsPayload {
+    /** 同資料夾的歌詞檔內容。 */
+    localLyrics?: { content: string; format?: 'vtt' };
+    /** 音檔內嵌的歌詞。 */
+    embeddedLyrics?: string;
+    /** 是從哪裡拿到的，只給除錯訊息用。 */
+    origin?: string;
+}
+
+const decodeWith = (bytes: Uint8Array, label: string): string | null => {
+    try {
+        return new TextDecoder(label, { fatal: true }).decode(bytes);
+    } catch {
+        return null;
+    }
+};
+
+/**
+ * 歌詞檔的編碼跟 ID3 一樣會騙人：老盤的 .lrc 常是 GBK／Big5 卻沒有宣告。
+ * 依序試 UTF-8 → GBK → Big5，最後才退回寬鬆的 UTF-8。
+ */
+export const decodeLyricBytes = (bytes: Uint8Array): string => {
+    const strictUtf8 = decodeWith(bytes, 'utf-8');
+    if (strictUtf8) return strictUtf8;
+    const gbk = decodeWith(bytes, 'gbk');
+    if (gbk) return gbk;
+    const big5 = decodeWith(bytes, 'big5');
+    if (big5) return big5;
+    try {
+        return new TextDecoder('utf-8').decode(bytes);
+    } catch {
+        return '';
+    }
+};
+
+const readSynchsafe = (bytes: Uint8Array, offset: number): number => (
+    ((bytes[offset] & 0x7F) << 21)
+    | ((bytes[offset + 1] & 0x7F) << 14)
+    | ((bytes[offset + 2] & 0x7F) << 7)
+    | (bytes[offset + 3] & 0x7F)
+);
+
+const readUint32 = (bytes: Uint8Array, offset: number): number => (
+    ((bytes[offset] & 0xFF) * 0x1000000)
+    + ((bytes[offset + 1] & 0xFF) << 16)
+    + ((bytes[offset + 2] & 0xFF) << 8)
+    + (bytes[offset + 3] & 0xFF)
+);
+
+const readUint32LE = (bytes: Uint8Array, offset: number): number => (
+    (bytes[offset] & 0xFF)
+    + ((bytes[offset + 1] & 0xFF) << 8)
+    + ((bytes[offset + 2] & 0xFF) << 16)
+    + ((bytes[offset + 3] & 0xFF) * 0x1000000)
+);
+
+const decodeId3Text = (bytes: Uint8Array): string => {
+    // 0 = ISO-8859-1（實務上常是 GBK／Big5），1 = UTF-16（帶 BOM），2 = UTF-16BE，3 = UTF-8。
+    const encoding = bytes[0];
+    const body = bytes.subarray(1);
+    if (encoding === 3) return decodeWith(body, 'utf-8') ?? decodeLyricBytes(body);
+    if (encoding === 1 || encoding === 2) {
+        const label = encoding === 1 ? 'utf-16' : 'utf-16be';
+        return decodeWith(body, label) ?? decodeWith(body, 'utf-16le') ?? '';
+    }
+    const latin = decodeWith(body, 'latin1') ?? '';
+    // 西歐字元以外就當成 CJK 編碼處理：純英文歌詞走這條也得到同樣結果。
+    if (!/[^\x00-\xFF]/.test(latin)) {
+        const text = decodeLyricBytes(body);
+        return text;
+    }
+    return latin;
+};
+
+/** 從 ID3v2 標籤裡找 USLT（未同步歌詞）。 */
+const extractId3Uslt = (bytes: Uint8Array): string | null => {
+    if (bytes.length < 10) return null;
+    const version = bytes[3];
+    // v2.3（老盤最常見）的長度是普通 32-bit big-endian，v2.4 才是 synchsafe。
+    const tagSize = version >= 4 ? readSynchsafe(bytes, 6) : readUint32(bytes, 6);
+    const tagEnd = Math.min(bytes.length, 10 + tagSize);
+    let offset = 10;
+    if ((bytes[5] & 0x40) !== 0) offset += 4; // extended header
+    while (offset + 10 <= tagEnd) {
+        const id = String.fromCharCode(bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
+        if (!/^[\x20-\x7E]{4}$/.test(id)) break;
+        const size = version >= 4 ? readSynchsafe(bytes, offset + 4) : readUint32(bytes, offset + 4);
+        const dataStart = offset + 10;
+        const dataEnd = Math.min(tagEnd, dataStart + size);
+        if (size <= 0 || dataEnd <= dataStart) break;
+        if (id === 'USLT') {
+            const body = bytes.subarray(dataStart, dataEnd);
+            // encoding(1) + language(3) + content descriptor（以終止符結束）+ 歌詞本體
+            const enc = body[0];
+            const terminatorLength = (enc === 1 || enc === 2) ? 2 : 1;
+            let cursor = 4;
+            while (cursor + terminatorLength <= body.length) {
+                const isTerminator = terminatorLength === 2
+                    ? body[cursor] === 0 && body[cursor + 1] === 0
+                    : body[cursor] === 0;
+                cursor += isTerminator ? terminatorLength : 1;
+                if (isTerminator) break;
+            }
+            const text = decodeId3Text(new Uint8Array([enc, ...body.subarray(cursor)]));
+            const trimmed = text.trim();
+            if (trimmed) return trimmed;
+        }
+        offset = dataStart + size;
+    }
+    return null;
+};
+
+/** FLAC：VORBIS_COMMENT 裡的 LYRICS／UNSYNCEDLYRICS。 */
+const extractFlacLyrics = (bytes: Uint8Array): string | null => {
+    if (bytes.length < 8) return null;
+    let offset = 4; // "fLaC"
+    while (offset + 4 <= bytes.length) {
+        const header = bytes[offset];
+        const isLast = (header & 0x80) !== 0;
+        const type = header & 0x7F;
+        const size = (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3];
+        const start = offset + 4;
+        const end = Math.min(bytes.length, start + size);
+        if (type === 4) {
+            const vendorLength = readUint32LE(bytes, start);
+            let cursor = start + 4 + vendorLength;
+            if (cursor + 4 > end) return null;
+            const count = readUint32LE(bytes, cursor);
+            cursor += 4;
+            for (let index = 0; index < count && cursor + 4 <= end; index += 1) {
+                const length = readUint32LE(bytes, cursor);
+                cursor += 4;
+                if (cursor + length > end) break;
+                const entry = decodeWith(bytes.subarray(cursor, cursor + length), 'utf-8')
+                    ?? decodeLyricBytes(bytes.subarray(cursor, cursor + length));
+                const equals = entry.indexOf('=');
+                if (equals > 0) {
+                    const key = entry.slice(0, equals).trim().toUpperCase();
+                    if (key === 'LYRICS' || key === 'UNSYNCEDLYRICS' || key === 'UNSYNCED LYRICS') {
+                        const value = entry.slice(equals + 1).replace(/\\n/g, '\n').trim();
+                        if (value) return value;
+                    }
+                }
+                cursor += length;
+            }
+            return null;
+        }
+        if (isLast) break;
+        offset = start + size;
+    }
+    return null;
+};
+
+/** M4A：©lyr 這顆資料 atom（內容是 UTF-8）。 */
+const extractM4aLyrics = (bytes: Uint8Array): string | null => {
+    const marker = [0xA9, 0x6C, 0x79, 0x72]; // '©lyr'
+    for (let index = 0; index + 32 < bytes.length; index += 1) {
+        if (bytes[index] !== marker[0] || bytes[index + 1] !== marker[1]
+            || bytes[index + 2] !== marker[2] || bytes[index + 3] !== marker[3]) continue;
+        // 之後找最近的一個 'data' box，payload 就是歌詞。
+        for (let scan = index + 4; scan + 16 < bytes.length; scan += 4) {
+            if (bytes[scan] !== 0x64 || bytes[scan + 1] !== 0x61 || bytes[scan + 2] !== 0x74 || bytes[scan + 3] !== 0x61) continue;
+            const size = readUint32(bytes, scan - 4);
+            const payloadStart = scan + 12; // 'data' + version/flags(4) + type(4)
+            const payloadEnd = Math.min(bytes.length, scan - 4 + size);
+            if (payloadEnd > payloadStart) {
+                const text = decodeWith(bytes.subarray(payloadStart, payloadEnd), 'utf-8') ?? decodeLyricBytes(bytes.subarray(payloadStart, payloadEnd));
+                const trimmed = text.trim();
+                if (trimmed) return trimmed;
+            }
+            break;
+        }
+    }
+    return null;
+};
