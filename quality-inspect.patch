diff --git a/src/library/suites/tui/libraryTuiQuality.ts b/src/library/suites/tui/libraryTuiQuality.ts
new file mode 100644
index 0000000..aa3000b
--- /dev/null
+++ b/src/library/suites/tui/libraryTuiQuality.ts
@@ -0,0 +1,32 @@
+// src/library/suites/tui/libraryTuiQuality.ts
+// 曲庫列表「音質」欄的文字：容器自稱的採樣率／位深 + 真假無損的結論。
+// 純格式化，i18n 由呼叫端傳 t 進來（與其他 TUI 行一致，不在這裡抓全域）。
+
+import type { TrackQualityRow } from '../../../hooks/useTrackQualityLabels';
+
+type Translate = (key: string) => string;
+
+const rateText = (hz: number): string => {
+    if (!hz) return '';
+    const k = hz / 1000;
+    return `${Number.isInteger(k) ? k.toFixed(0) : k.toFixed(1)}k`;
+};
+
+/**
+ * 有損編碼只寫「有損」（採樣率照樣帶上，44.1k 有損一眼就懂）；
+ * 無損容器量到之前是「量測中」，量完才是真無損／假無損／無法判斷。
+ */
+export const formatTrackQuality = (row: TrackQualityRow | undefined, t: Translate): string => {
+    if (!row) return '';
+    const spec = [rateText(row.sampleRate), row.bitDepth ? `${row.bitDepth}bit` : ''].filter(Boolean).join('/');
+    const verdict = row.verdict === 'trueLossless'
+        ? t('libraryTui.qualityTrueLossless')
+        : row.verdict === 'fakeLossless'
+            ? t('libraryTui.qualityFakeLossless')
+            : row.verdict === 'lossy'
+                ? t('libraryTui.qualityLossy')
+                : row.verdict === 'unknown'
+                    ? t('libraryTui.qualityUnknown')
+                    : t('libraryTui.qualityPending');
+    return spec ? `${spec} ${verdict}` : verdict;
+};
diff --git a/src/perf/carPerformancePreset.ts b/src/perf/carPerformancePreset.ts
new file mode 100644
index 0000000..21630c6
--- /dev/null
+++ b/src/perf/carPerformancePreset.ts
@@ -0,0 +1,143 @@
+import i18n from '../i18n/config';
+import { setStatusMessage } from '../stores/useStatusMessageStore';
+import { useThemeSettingsStore } from '../stores/useThemeSettingsStore';
+import { usePlayerChromeSettingsStore } from '../stores/usePlayerChromeSettingsStore';
+import { useVisualizerSettingsStore } from '../stores/useVisualizerSettingsStore';
+import { useMotionSettingsStore, MOTION_SURFACE_IDS } from '../stores/useMotionSettingsStore';
+
+// src/perf/carPerformancePreset.ts
+// 車機一鍵效能檔：Android WebView 的車機（梁山嘟嘟 S3 8+128 這類八核 + 8GB 的機器）跑的是同一個
+// Chromium，但 GPU 是車規 SoC 的內顯，9 吋 1280×720 左右的屏，最吃資源的分別是：歌詞可視化的每幀畫布、
+// 首頁動態背景、播放頁的原生模糊、以及各種過場動畫。這裡把這些一起壓到「流暢優先」。
+//
+// 套用前把原值存起來，可以一鍵還原；只寫 localStorage 與 zustand，不改任何渲染邏輯。
+
+const PRESET_BACKUP_KEY = 'folia_car_perf_preset_backup';
+const PRESET_APPLIED_KEY = 'folia_car_perf_preset_applied';
+
+/** 車機 = Android WebView，且不是桌面殼。 */
+export const isCarUnit = (): boolean => (
+    typeof navigator !== 'undefined'
+    && !(typeof window !== 'undefined' && window.electron)
+    && /Android/i.test(navigator.userAgent)
+);
+
+type Backup = {
+    staticMode: boolean;
+    homeBackgroundOff: boolean;
+    nativeBlur: boolean;
+    frameRate: string;
+    lyricQuality: { scale: number; antialias: string };
+    visualizerMode: string;
+    backgroundMode: string | null;
+    vignetteOff: boolean;
+    geometricOff: boolean;
+    reducedMotion: Record<string, boolean>;
+};
+
+const readBackup = (): Backup | null => {
+    try {
+        const raw = localStorage.getItem(PRESET_BACKUP_KEY);
+        return raw ? JSON.parse(raw) as Backup : null;
+    } catch {
+        return null;
+    }
+};
+
+const takeBackup = (): Backup => ({
+    staticMode: useThemeSettingsStore.getState().staticMode,
+    homeBackgroundOff: useThemeSettingsStore.getState().disableHomeDynamicBackground,
+    nativeBlur: usePlayerChromeSettingsStore.getState().enablePlayerPageNativeBlur,
+    frameRate: String(useVisualizerSettingsStore.getState().visualizerFrameRate),
+    lyricQuality: { ...useVisualizerSettingsStore.getState().lyricRenderQuality },
+    visualizerMode: useVisualizerSettingsStore.getState().visualizerMode,
+    backgroundMode: useVisualizerSettingsStore.getState().visualizerBackgroundMode ?? null,
+    vignetteOff: useVisualizerSettingsStore.getState().disableVisualizerVignette,
+    geometricOff: useVisualizerSettingsStore.getState().disableVisualizerGeometricBackground,
+    reducedMotion: { ...useMotionSettingsStore.getState().reducedMotionSurfaces },
+});
+
+/** 套用車機效能檔。quiet=true 時不跳提示（自動套用那條路自己會講）。 */
+export const applyCarPerformancePreset = (options: { quiet?: boolean } = {}) => {
+    if (!readBackup()) {
+        try {
+            localStorage.setItem(PRESET_BACKUP_KEY, JSON.stringify(takeBackup()));
+        } catch {
+            // 存不進去就沒有還原，仍然先套用。
+        }
+    }
+
+    const theme = useThemeSettingsStore.getState();
+    const chrome = usePlayerChromeSettingsStore.getState();
+    const vis = useVisualizerSettingsStore.getState();
+    const motion = useMotionSettingsStore.getState();
+
+    // 1. 動態背景、畫面特效全關：這兩個是首頁／播放頁最貴的兩筆。
+    theme.handleToggleStaticMode(true);
+    theme.handleToggleDisableHomeDynamicBackground(true);
+    chrome.handleTogglePlayerPageNativeBlur(false);
+
+    // 2. 歌詞畫布：60 FPS 上限（再低會明顯頓）+ 0.75 倍解析度 + 關抗鋸齒。9 吋屏上肉眼看不出差，填充率省一半以上。
+    vis.handleSetVisualizerFrameRate(60);
+    vis.handleSetLyricRenderQuality({ scale: 0.75, antialias: 'off' });
+    // 3. 歌詞樣式換成最輕的「靜態」：不跑逐字動畫、不開著色器；背景也換回內建最簡的一種。
+    vis.handleSetVisualizerMode('still', { notify: false });
+    vis.handleSetVisualizerBackgroundMode('common');
+    vis.handleToggleDisableVisualizerVignette(true);
+    vis.handleToggleDisableVisualizerGeometricBackground(true);
+
+    // 4. 界面動效全降級：換頁、牆面、轉場、微互動都不再跑彈簧曲線。
+    for (const surface of MOTION_SURFACE_IDS) {
+        motion.handleToggleReducedMotionSurface(surface, true);
+    }
+
+    if (!options.quiet) {
+        setStatusMessage({ type: 'success', text: i18n.t('localMusic.carPerfApplied') });
+    }
+};
+
+/** 還原成套用前的值。沒有備份時只回一句「沒有可還原的設定」。 */
+export const revertCarPerformancePreset = () => {
+    const backup = readBackup();
+    if (!backup) {
+        setStatusMessage({ type: 'info', text: i18n.t('localMusic.carPerfNoBackup') });
+        return;
+    }
+
+    useThemeSettingsStore.getState().handleToggleStaticMode(backup.staticMode);
+    useThemeSettingsStore.getState().handleToggleDisableHomeDynamicBackground(backup.homeBackgroundOff);
+    usePlayerChromeSettingsStore.getState().handleTogglePlayerPageNativeBlur(backup.nativeBlur);
+    useVisualizerSettingsStore.getState().handleSetVisualizerFrameRate(backup.frameRate as never);
+    useVisualizerSettingsStore.getState().handleSetLyricRenderQuality(backup.lyricQuality as never);
+    useVisualizerSettingsStore.getState().handleSetVisualizerMode(backup.visualizerMode as never, { notify: false });
+    if (backup.backgroundMode) {
+        useVisualizerSettingsStore.getState().handleSetVisualizerBackgroundMode(backup.backgroundMode as never);
+    } else {
+        useVisualizerSettingsStore.getState().handleResetVisualizerBackgroundMode();
+    }
+    useVisualizerSettingsStore.getState().handleToggleDisableVisualizerVignette(backup.vignetteOff);
+    useVisualizerSettingsStore.getState().handleToggleDisableVisualizerGeometricBackground(backup.geometricOff);
+    for (const surface of MOTION_SURFACE_IDS) {
+        useMotionSettingsStore.getState().handleToggleReducedMotionSurface(surface, Boolean(backup.reducedMotion[surface]));
+    }
+
+    try {
+        localStorage.removeItem(PRESET_BACKUP_KEY);
+    } catch {
+        // 忽略。
+    }
+    setStatusMessage({ type: 'success', text: i18n.t('localMusic.carPerfReverted') });
+};
+
+/** 車機第一次開這個版本時自動套一次；之後不再打擾（設置頁仍可重新套用／還原）。 */
+export const maybeApplyCarPerformancePresetOnce = () => {
+    if (!isCarUnit()) return;
+    try {
+        if (localStorage.getItem(PRESET_APPLIED_KEY)) return;
+        localStorage.setItem(PRESET_APPLIED_KEY, '1');
+    } catch {
+        return;
+    }
+    applyCarPerformancePreset({ quiet: true });
+    setStatusMessage({ type: 'info', text: i18n.t('localMusic.carPerfAutoApplied') });
+};
diff --git a/src/services/audioQuality/inspectAudioQuality.ts b/src/services/audioQuality/inspectAudioQuality.ts
new file mode 100644
index 0000000..89e8db8
--- /dev/null
+++ b/src/services/audioQuality/inspectAudioQuality.ts
@@ -0,0 +1,220 @@
+// src/services/audioQuality/inspectAudioQuality.ts
+// 一次體檢：檔頭讀容器的自稱規格 → 用 Web Audio 解碼 → 量頻譜 → 出結論。
+//
+// 這是 Aurora（com.aurora.music）那套「音質檢測」的網頁／iOS 版：iOS 沒有 ffmpeg，
+// 所以解碼靠 decodeAudioData，量化靠 qualitySpectrum.ts 的 FFT。平台限制也寫在這裡：
+// WebKit 的 OfflineAudioContext 取樣率上限 96 kHz，超過的檔案只能標記為「無法在此裝置判斷」。
+
+import { decodeAtRate } from '../analysis/trackAudio';
+import { probeContainer, type ContainerProbe } from './qualityProbe';
+import { averageSpectrum, summariseBand } from './qualitySpectrum';
+
+export type QualityLevel = 'ok' | 'info' | 'warn' | 'bad';
+
+export type QualityVerdictKind =
+    | 'ok'
+    | 'fakeLossless'
+    | 'narrowBand'
+    | 'upsampled'
+    | 'depthMismatch'
+    | 'lossy'
+    | 'containerUnknown';
+
+export interface QualityVerdict {
+    kind: QualityVerdictKind;
+    /** 已經格式化好的字串，直接丟進 i18n 的 {{}} 佔位符。 */
+    params: Record<string, string>;
+}
+
+export interface QualityMeasurement {
+    cutoffHz: number | null;
+    nyquistHz: number;
+    transitionHz: number | null;
+    refDb: number;
+    frames: number;
+    /** 畫圖用的頻譜曲線：對數頻率軸上等距取樣，值是相對參考電平的 dB（已夾在 −90…+5）。 */
+    curve: QualityCurve | null;
+}
+
+export interface QualityCurve {
+    /** 取樣點數。第 i 點的頻率是 20 * (nyquist / 20) ** (i / (points - 1))。 */
+    points: number[];
+    /** 對數軸的起點與終點（Hz），畫圖時用它把第 i 點換回頻率。 */
+    minHz: number;
+    maxHz: number;
+}
+
+export interface QualityInspectResult {
+    fileName: string;
+    ok: boolean;
+    /** 失敗原因，也是 i18n 鍵（qualityCheck.error.*）。 */
+    error?: 'unsupportedContainer' | 'decodeFailed' | 'tooShort' | 'hiresTooWide';
+    container: ContainerProbe | null;
+    measured: QualityMeasurement | null;
+    verdicts: QualityVerdict[];
+    level: QualityLevel;
+}
+
+/** 分析的窗長（秒）、WebKit 的取樣率上限，以及 FFT 至少需要一整窗。 */
+const WINDOW_SECONDS = 20;
+const MAX_CONTEXT_RATE = 96000;
+const QUALITY_MIN_SAMPLES = 8192;
+
+/** 有損編碼器按截止點反推的碼率區間；只是粗略對照，不是量測。 */
+const approximateBitrate = (cutoffHz: number): string => {
+    const ratio = cutoffHz / 44100;
+    if (ratio < 0.35) return '64–96';
+    if (ratio < 0.42) return '128';
+    if (ratio < 0.47) return '192';
+    if (ratio < 0.49) return '256–320';
+    return '';
+};
+
+const fmtK = (hz: number): string => (hz / 1000).toFixed(2);
+const fmtRate = (hz: number): string => (hz / 1000).toFixed(hz % 1000 === 0 ? 0 : 1);
+
+/** 取中段一段樣本，避開片頭淡入與靜音段。 */
+const pickWindow = (buffer: AudioBuffer): Float32Array => {
+    const rate = buffer.sampleRate;
+    const wantFrames = Math.min(buffer.length, Math.round(WINDOW_SECONDS * rate));
+    const start = buffer.length > wantFrames * 2
+        ? Math.min(Math.round(buffer.length * 0.25), buffer.length - wantFrames)
+        : 0;
+    const left = buffer.getChannelData(0);
+    const samples = new Float32Array(wantFrames);
+    if (buffer.numberOfChannels > 1) {
+        const right = buffer.getChannelData(1);
+        for (let i = 0; i < wantFrames; i += 1) samples[i] = (left[start + i] + right[start + i]) / 2;
+    } else {
+        for (let i = 0; i < wantFrames; i += 1) samples[i] = left[start + i];
+    }
+    return samples;
+};
+
+/** 曲線點數：夠密看不出折線，又不至於讓每筆結果變成一大塊資料。 */
+const CURVE_POINTS = 240;
+const CURVE_MIN_HZ = 20;
+
+/** 把 dB 譜換成對數頻率軸上的等距取樣，供頻譜圖直接畫。 */
+const buildCurve = (db: Float64Array, freqPerBin: number, refDb: number, nyquist: number): QualityCurve => {
+    const points: number[] = [];
+    for (let i = 0; i < CURVE_POINTS; i += 1) {
+        const hz = CURVE_MIN_HZ * (nyquist / CURVE_MIN_HZ) ** (i / (CURVE_POINTS - 1));
+        const bin = Math.min(db.length - 1, Math.max(0, Math.round(hz / freqPerBin)));
+        const relative = db[bin] - refDb;
+        points.push(Math.max(-90, Math.min(5, Math.round(relative * 10) / 10)));
+    }
+    return { points, minHz: CURVE_MIN_HZ, maxHz: nyquist };
+};
+
+const judge = (container: ContainerProbe | null, cutoffHz: number | null, transitionHz: number | null): { verdicts: QualityVerdict[]; level: QualityLevel } => {
+    const verdicts: QualityVerdict[] = [];
+    let level: QualityLevel = 'ok';
+
+    if (!container || !container.sampleRate) {
+        verdicts.push({ kind: 'containerUnknown', params: {} });
+        return { verdicts, level: 'info' };
+    }
+
+    const nyquist = container.sampleRate / 2;
+    const gap = cutoffHz ? nyquist - cutoffHz : null;
+
+    if (container.lossless && cutoffHz && gap !== null && gap > 1500 && cutoffHz < nyquist * 0.97) {
+        if (transitionHz !== null && transitionHz < 800) {
+            verdicts.push({ kind: 'fakeLossless', params: { sampleRate: fmtRate(container.sampleRate), cutoff: fmtK(cutoffHz), transition: String(transitionHz) } });
+            level = 'bad';
+        } else {
+            verdicts.push({ kind: 'narrowBand', params: { cutoff: fmtK(cutoffHz), transition: String(transitionHz ?? 0) } });
+            level = 'warn';
+        }
+    }
+
+    if (container.sampleRate >= 88200 && cutoffHz && cutoffHz <= nyquist * 0.6) {
+        verdicts.push({ kind: 'upsampled', params: { sampleRate: fmtRate(container.sampleRate), cutoff: fmtK(cutoffHz) } });
+        level = 'bad';
+    }
+
+    if (container.bitDepth > 0 && container.bitDepth <= 16 && container.sampleRate >= 88200) {
+        verdicts.push({ kind: 'depthMismatch', params: { bitDepth: String(container.bitDepth), sampleRate: fmtRate(container.sampleRate) } });
+        if (level !== 'bad') level = 'warn';
+    }
+
+    if (!container.lossless && cutoffHz) {
+        const bitrate = approximateBitrate(cutoffHz);
+        verdicts.push({
+            kind: 'lossy',
+            params: { codec: container.codec.toUpperCase(), cutoff: fmtK(cutoffHz), bitrate },
+        });
+        if (level === 'ok') level = 'info';
+    }
+
+    if (!verdicts.length) {
+        verdicts.push({
+            kind: 'ok',
+            params: {
+                sampleRate: fmtRate(container.sampleRate),
+                bitDepth: container.bitDepth ? String(container.bitDepth) : '?',
+                cutoff: fmtK(cutoffHz ?? nyquist),
+            },
+        });
+    }
+    return { verdicts, level };
+};
+
+/**
+ * 檢查一份音訊的位元組。檔案名稱只用來判斷格式與顯示。
+ * `knownContainer` 是量測切片時由檔頭段帶進來的規格（切片本身可能讀不出容器，
+ * 例如 MP3 從中段切、FLAC 少了 STREAMINFO），有了它就不必再猜一次 Nyquist。
+ */
+export const inspectAudioBytes = async (
+    bytes: ArrayBuffer,
+    fileName: string,
+    knownContainer?: ContainerProbe | null,
+): Promise<QualityInspectResult> => {
+    const container = knownContainer === undefined ? probeContainer(bytes) : knownContainer;
+    const failed = (error: QualityInspectResult['error']): QualityInspectResult => ({
+        fileName, ok: false, error, container, measured: null, verdicts: [], level: 'warn',
+    });
+
+    if (container && container.sampleRate > MAX_CONTEXT_RATE) return failed('hiresTooWide');
+
+    // 容器取樣率就是解碼取樣率：decodeAudioData 會重採樣到 context 的取樣率，
+    // 用它自己的取樣率建 context，量到的 Nyquist 才跟容器說的一致。
+    const rate = container?.sampleRate
+        ? Math.min(Math.max(container.sampleRate, 8000), MAX_CONTEXT_RATE)
+        : 48000;
+    const decoded = await decodeAtRate(bytes, rate);
+    if (!decoded) return failed('decodeFailed');
+    if (decoded.length < QUALITY_MIN_SAMPLES) return failed('tooShort');
+
+    const spectrum = averageSpectrum(pickWindow(decoded), decoded.sampleRate);
+    if (!spectrum) return failed('tooShort');
+    const band = summariseBand(spectrum);
+    const { verdicts, level } = judge(container, band.cutoffHz, band.transitionHz);
+
+    return {
+        fileName,
+        ok: true,
+        container,
+        measured: {
+            cutoffHz: band.cutoffHz,
+            nyquistHz: decoded.sampleRate / 2,
+            transitionHz: band.transitionHz,
+            refDb: Math.round(band.refDb * 10) / 10,
+            frames: spectrum.frames,
+            curve: buildCurve(spectrum.db, spectrum.freqPerBin, band.refDb, decoded.sampleRate / 2),
+        },
+        verdicts,
+        level,
+    };
+};
+
+/** 檔案選擇器拿到的 File。 */
+export const inspectAudioFile = async (file: File): Promise<QualityInspectResult> => {
+    try {
+        return await inspectAudioBytes(await file.arrayBuffer(), file.name);
+    } catch (error) {
+        console.warn('[QualityInspect] could not read file', error);
+        return { fileName: file.name, ok: false, error: 'decodeFailed', container: null, measured: null, verdicts: [], level: 'warn' };
+    }
+};
