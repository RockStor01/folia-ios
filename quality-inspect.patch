+// src/services/localSongRawTagBackfill.ts
+// v0.9.18：把「標籤壞成 � 或 ?」的歌，回檔案讀原始位元組補回來。
+// v0.9.21：一次啟動就掃完整庫，而不是每次啟動只補 25 首；修不了的歌記下來，下次不再重試，
+// 免得前 25 首永遠佔著名額、後面的歌排不到（那正是「有些歌一直是問號」的原因）。
+//
+// 為什麼要另開一支：localSongRawTags 不能直接 import localMusicService（那邊反過來 import 它，會成環），
+// 所以「怎麼讀位元組」留在這裡，localSongRawTags 只負責解析與決定要不要補。
+// 連結模式走原生 Range（不用把整首讀進來），匯入模式走 FileHandle slice。
+
+import type { LocalSong } from '../types';
+import { getLocalSongs, saveLocalSongs } from './db';
+import { getLocalSongRangeBytes } from './localMusicService';
+import { fetchNativeRange } from './nativeLinkedStorage';
+import { hasLostChars, parseRawTags, planTagPatch, type RawTagStrings } from './localSongRawTags';
+
+/** 檔頭 4 MB 足以蓋住 ID3v2、flac 的 Vorbis comment、m4a 的 moov。 */
+const HEAD_BYTES = 4 * 1024 * 1024;
+/** APEv2、DSF 的內嵌 ID3 貼在檔尾。 */
+const TAIL_BYTES = 512 * 1024;
+/** 每批處理幾首：批與批之間讓出主執行緒，兩千首也不會把車機卡住。 */
+const BATCH_SIZE = 20;
+
+// 試過但救不回來的歌 id（標籤本來就是「?」、檔名也壞、檔案讀不到）。記下來才不會每次啟動重試同一批。
+const ATTEMPTED_STORAGE_KEY = 'folia_raw_tag_repair_attempted';
+
+const readAttempted = (): Set<string> => {
+    if (typeof window === 'undefined') return new Set();
+    try {
+        const parsed = JSON.parse(localStorage.getItem(ATTEMPTED_STORAGE_KEY) || '[]');
+        return new Set(Array.isArray(parsed) ? parsed.filter((id): id is string => typeof id === 'string') : []);
+    } catch {
+        return new Set();
+    }
+};
+
+const writeAttempted = (ids: Set<string>): void => {
+    if (typeof window === 'undefined') return;
+    try {
+        localStorage.setItem(ATTEMPTED_STORAGE_KEY, JSON.stringify([...ids]));
+    } catch {
+        // 額滿就算了：下次重試同一首歌也不致命。
+    }
+};
+
+const readRange = async (song: LocalSong, startAt: number, byteLength: number): Promise<ArrayBuffer | null> => {
+    if (song.linkedFilePath) return await fetchNativeRange(song.linkedFilePath, byteLength, startAt);
+    return await getLocalSongRangeBytes(song, startAt, byteLength);
+};
+
+export const readSongRawTags = async (song: LocalSong): Promise<RawTagStrings | null> => {
+    try {
+        const head = await readRange(song, 0, HEAD_BYTES);
+        if (head && head.byteLength > 0) {
+            const tags = parseRawTags(new Uint8Array(head), song.fileName);
+            if (tags) return tags;
+        }
+        const size = Math.max(0, song.fileSize || 0);
+        if (size <= 0) return null;
+        const tailLength = Math.min(TAIL_BYTES, size);
+        const tail = await readRange(song, size - tailLength, tailLength);
+        if (!tail || tail.byteLength === 0) return null;
+        return parseRawTags(new Uint8Array(tail), song.fileName);
+    } catch (error) {
+        console.warn('[RawTags] read failed:', song.fileName, error);
+        return null;
+    }
+};
+
+const isLost = (song: LocalSong): boolean => hasLostChars(song.title)
+    || hasLostChars(song.importedMetadata.artistNames.join(''))
+    || hasLostChars(song.importedMetadata.albumName);
+
+export interface LostTagRepairResult {
+    /** 掃過幾首壞掉的歌。 */
+    scanned: number;
+    /** 其中修好幾首。 */
+    fixed: number;
+}
+
+const yieldToMain = (): Promise<void> => new Promise<void>(resolve => {
+    setTimeout(resolve, 0);
+});
+
+/**
+ * 回填全庫：標題／歌手／專輯壞掉的歌逐首回檔案讀原始標籤。
+ * `includeAttempted` 為 true 時連上次試過的也重來（手動「重跑全部」用）。
+ */
+export const repairLostTags = async (options: {
+    includeAttempted?: boolean;
+    onProgress?: (done: number, total: number) => void;
+} = {}): Promise<LostTagRepairResult> => {
+    const attempted = options.includeAttempted ? new Set<string>() : readAttempted();
+    let scanned = 0;
+    let fixed = 0;
+    try {
+        const songs = await getLocalSongs();
+        const targets = songs.filter(song => isLost(song) && !attempted.has(song.id));
+        const total = targets.length;
+        if (total === 0) return { scanned: 0, fixed: 0 };
+
+        for (let start = 0; start < targets.length; start += BATCH_SIZE) {
+            const chunk = targets.slice(start, start + BATCH_SIZE);
+            const patched: LocalSong[] = [];
+            for (const song of chunk) {
+                scanned += 1;
+                attempted.add(song.id);
+                const tags = await readSongRawTags(song);
+                // 標籤讀不到（容器不認、檔案讀取失敗）時照樣往檔名退：標題至少還能從檔名救回來。
+                const next = planTagPatch(song, tags ?? {});
+                if (next) patched.push(next);
+            }
+            if (patched.length > 0) {
+                await saveLocalSongs(patched);
+                fixed += patched.length;
+            }
+            writeAttempted(attempted);
+            options.onProgress?.(Math.min(scanned, total), total);
+            // 讓出主執行緒：車機一邊播歌一邊掃，不要一次吃掉幾秒。
+            await yieldToMain();
+        }
+        if (fixed > 0) {
+            window.dispatchEvent(new CustomEvent('folia-local-music-updated'));
+            console.info(`[RawTags] repaired ${fixed} of ${scanned} song(s) from raw tag bytes`);
+        }
+        return { scanned, fixed };
+    } catch (error) {
+        console.warn('[RawTags] repair failed', error);
+        return { scanned, fixed };
+    }
+};
+
+/** 清掉「試過了」的記錄，下一次啟動（或手動）會從頭再掃一遍。 */
+export const resetLostTagRepairAttempts = (): void => {
+    if (typeof window === 'undefined') return;
+    localStorage.removeItem(ATTEMPTED_STORAGE_KEY);
+};
+
+/**
+ * 背景回填：只處理「標題／歌手／專輯壞掉」的歌，一次啟動掃完整庫（每批 20 首，批與批之間讓出主執行緒）。
+ * 修不回來的歌記下來，下次啟動不會再由它們佔住名額。
+ */
+export const backfillLostTagSongs = async (): Promise<number> => {
+    const result = await repairLostTags();
+    return result.fixed;
+};
