--- /dev/null
+++ b/src/components/audioQuality/SpectrumChart.tsx
@@ -0,0 +1,104 @@
+// src/components/audioQuality/SpectrumChart.tsx
+// 體檢結果的頻譜圖：橫軸是對數頻率，縱軸是相對電平，截止點畫一條虛線，右邊整片標紅。
+//
+// 畫的是 Aurora 那張圖的意思：曲線一路平到某個頻率就掉下去，掉下去的位置就是「內容真的到哪」。
+// 資料在 services/audioQuality/inspectAudioQuality.ts 就算好了（對數軸等距 240 點），這裡只負責畫。
+//
+// 曲線用 SVG（viewBox 固定 320×96、preserveAspectRatio="none"，讓它撐滿寬度）；
+// 文字不用 SVG 畫 —— 非等比拉伸會把字壓扁，所以標籤一律用 HTML 疊在上面。
+
+import React from 'react';
+import type { QualityCurve } from '../../services/audioQuality/inspectAudioQuality';
+
+/** 縱軸範圍：+5 dB 到 −90 dB，跟曲線資料夾的範圍一致。 */
+const TOP_DB = 5;
+const BOTTOM_DB = -90;
+
+const WIDTH = 320;
+/** 曲線本身的高度；底下的頻率標籤是 HTML，不佔 SVG。 */
+const PLOT_HEIGHT = 88;
+
+type SpectrumChartProps = {
+    curve: QualityCurve;
+    cutoffHz: number | null;
+    nyquistHz: number;
+    /** 已經格式化的截止點標籤，例如 "20.23 kHz"；null 時不畫虛線。 */
+    cutoffLabel: string | null;
+};
+
+const SpectrumChart: React.FC<SpectrumChartProps> = ({ curve, cutoffHz, nyquistHz, cutoffLabel }) => {
+    const logRange = Math.log(curve.maxHz / curve.minHz);
+
+    /** 頻率 → 圖上的相對位置（0–1）。 */
+    const xOf = (hz: number): number => (logRange ? Math.min(1, Math.max(0, Math.log(hz / curve.minHz) / logRange)) : 0);
+    /** 相對電平 → 圖上的相對高度（0 是最上面）。 */
+    const yOf = (db: number): number => (TOP_DB - Math.max(BOTTOM_DB, Math.min(TOP_DB, db))) / (TOP_DB - BOTTOM_DB);
+
+    const linePath = curve.points
+        .map((db, index) => {
+            const hz = curve.minHz * (curve.maxHz / curve.minHz) ** (index / (curve.points.length - 1));
+            return `${index === 0 ? 'M' : 'L'}${(xOf(hz) * WIDTH).toFixed(2)},${(yOf(db) * PLOT_HEIGHT).toFixed(2)}`;
+        })
+        .join(' ');
+    const areaPath = `${linePath} L${WIDTH},${PLOT_HEIGHT} L0,${PLOT_HEIGHT} Z`;
+
+    const cutoffRatio = cutoffHz ? xOf(cutoffHz) : null;
+    const cutoffPercent = cutoffRatio === null ? null : cutoffRatio * 100;
+    const labelFlip = cutoffPercent !== null && cutoffPercent > 62;
+
+    return (
+        <div className="relative select-none" style={{ height: PLOT_HEIGHT + 14 }}>
+            <svg
+                viewBox={`0 0 ${WIDTH} ${PLOT_HEIGHT}`}
+                preserveAspectRatio="none"
+                className="block w-full"
+                style={{ height: PLOT_HEIGHT }}
+                role="img"
+                aria-label={cutoffLabel ?? 'spectrum'}
+            >
+                {/* 截止點右邊：內容已經是數位零，整片標紅 */}
+                {cutoffPercent !== null && cutoffPercent < 100 && (
+                    <rect x={(cutoffRatio! * WIDTH).toFixed(2)} y={0} width={(WIDTH - cutoffRatio! * WIDTH).toFixed(2)}
+                        height={PLOT_HEIGHT} fill="#ef4444" opacity="0.16" />
+                )}
+
+                <path d={areaPath} fill="#7dd3fc" fillOpacity="0.18" />
+                <path d={linePath} fill="none" stroke="#7dd3fc" strokeWidth="1.1" vectorEffect="non-scaling-stroke" />
+
+                {/* 判定線：−45 dB 以下就算「這裡沒內容了」，截止點就是最後一次跨過它的地方 */}
+                <line x1="0" y1={(yOf(-45) * PLOT_HEIGHT).toFixed(2)} x2={WIDTH} y2={(yOf(-45) * PLOT_HEIGHT).toFixed(2)}
+                    stroke="#ffffff" strokeOpacity="0.16" strokeWidth="1" strokeDasharray="2 4" vectorEffect="non-scaling-stroke" />
+
+                {/* 參考電平 0 dB */}
+                <line x1="0" y1={(yOf(0) * PLOT_HEIGHT).toFixed(2)} x2={WIDTH} y2={(yOf(0) * PLOT_HEIGHT).toFixed(2)}
+                    stroke="#ffffff" strokeOpacity="0.08" strokeWidth="1" vectorEffect="non-scaling-stroke" />
+
+                {/* 截止點虛線 */}
+                {cutoffPercent !== null && (
+                    <line x1={(cutoffRatio! * WIDTH).toFixed(2)} y1={0} x2={(cutoffRatio! * WIDTH).toFixed(2)} y2={PLOT_HEIGHT}
+                        stroke="#ef4444" strokeWidth="1" strokeDasharray="3 3" vectorEffect="non-scaling-stroke" />
+                )}
+            </svg>
+
+            {/* 截止點標籤（在線的左邊或右邊，靠邊時翻向內側） */}
+            {cutoffPercent !== null && cutoffLabel && (
+                <div
+                    className="pointer-events-none absolute top-1 rounded bg-black/55 px-1 py-0.5 text-[10px] leading-none text-[#f87171]"
+                    style={labelFlip
+                        ? { right: `${(100 - cutoffPercent).toFixed(1)}%`, marginRight: 4 }
+                        : { left: `${cutoffPercent.toFixed(1)}%`, marginLeft: 4 }}
+                >
+                    {cutoffLabel}
+                </div>
+            )}
+
+            {/* 頻率軸端點 */}
+            <div className="absolute inset-x-0 bottom-0 flex justify-between pr-1 text-[10px] leading-none text-[color:var(--st-t3)]">
+                <span>20 Hz</span>
+                <span>{(nyquistHz / 1000).toFixed(nyquistHz % 1000 === 0 ? 0 : 1)} kHz</span>
+            </div>
+        </div>
+    );
+};
+
+export default SpectrumChart;
