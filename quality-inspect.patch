--- /dev/null
+++ b/src/services/nativeLinkedStorage.ts
@@ -0,0 +1,299 @@
+// src/services/nativeLinkedStorage.ts
+// 「連結模式」的 JS 側：把 Android 原生層（FoliaNativeStorage.java）的介面收斂成幾個型別安全的函式。
+//
+// 存在的理由見 native/FoliaNativeStorage.java 的註解：車機上不想把 3~6 GB 的音檔抄進 IndexedDB，
+// 就地讀、就地把檔案以 HTTP Range 串給 WebView 播放。這支模組在不是車機 APK（瀏覽器、iPhone）時
+// 全部回 false / null，呼叫端不用判斷平台。
+
+export interface NativeStorageRoot {
+    name: string;
+    path: string;
+    /** 原生層能不能列這個目錄（不能通常是沒掛載或權限不足，仍讓使用者點進去看到原因）。 */
+    readable?: boolean;
+}
+
+export interface NativeStorageDir {
+    name: string;
+    path: string;
+}
+
+export interface NativeStorageFile {
+    name: string;
+    path: string;
+    size: number;
+    lastModified: number;
+}
+
+export interface NativeProbeResult {
+    name?: string;
+    path?: string;
+    size?: number;
+    lastModified?: number;
+    mime?: string;
+    title?: string;
+    artist?: string;
+    album?: string;
+    duration?: number;
+    bitrate?: number;
+    sampleRate?: number;
+    bitsPerSample?: number;
+    /** 原生層落在快取目錄的封面絕對路徑（只當識別用，不給 JS 讀）。 */
+    coverPath?: string;
+    /** 可直接 fetch 的封面相對路徑，例如 /c/xxxx。 */
+    coverUrl?: string;
+    error?: string;
+}
+
+interface NativeBridge {
+    ping: () => string;
+    serverPort: () => number;
+    setPlaybackState?: (isPlaying: boolean) => void;
+    reportPlaybackState?: (isPlaying: boolean, positionMs: number, durationMs: number) => void;
+    canTranscode?: () => boolean;
+    startWavTranscode?: (filePath: string) => string;
+    wavTranscodeStatus?: (jobId: string) => string;
+    listLyrics?: (dirPath: string) => string;
+    diagnose?: () => string;
+    hasPermission: () => boolean;
+    requestPermission: () => void;
+    roots: () => string;
+    list: (dirPath: string) => string;
+    scan: (dirPath: string) => string;
+    probe: (filePath: string) => string;
+}
+
+declare global {
+    interface Window {
+        FoliaNativeStorage?: NativeBridge;
+    }
+}
+
+const bridge = (): NativeBridge | undefined => (
+    typeof window === 'undefined' ? undefined : window.FoliaNativeStorage
+);
+
+export const isLinkedStorageSupported = (): boolean => Boolean(bridge());
+
+export const hasStoragePermission = (): boolean => {
+    try {
+        return Boolean(bridge()?.hasPermission());
+    } catch {
+        return false;
+    }
+};
+
+export const requestStoragePermission = (): void => {
+    try {
+        bridge()?.requestPermission();
+    } catch (error) {
+        console.warn('[LinkedStorage] Permission request failed', error);
+    }
+};
+
+const parse = <T>(raw: string, fallback: T): T => {
+    try {
+        const value = JSON.parse(raw) as T;
+        return value ?? fallback;
+    } catch (error) {
+        console.warn('[LinkedStorage] Could not parse native payload', error);
+        return fallback;
+    }
+};
+
+export const listStorageRoots = (): NativeStorageRoot[] => {
+    try {
+        const raw = bridge()?.roots();
+        return raw ? parse<NativeStorageRoot[]>(raw, []) : [];
+    } catch (error) {
+        console.warn('[LinkedStorage] roots failed', error);
+        return [];
+    }
+};
+
+export const listStorageDirectory = (dirPath: string): { dirs: NativeStorageDir[]; files: NativeStorageFile[]; error?: string } => {
+    try {
+        const raw = bridge()?.list(dirPath);
+        if (!raw) return { dirs: [], files: [] };
+        const payload = parse<{ dirs?: NativeStorageDir[]; files?: NativeStorageFile[]; error?: string }>(raw, {});
+        return { dirs: payload.dirs ?? [], files: payload.files ?? [], error: payload.error };
+    } catch (error) {
+        console.warn('[LinkedStorage] list failed', error);
+        return { dirs: [], files: [] };
+    }
+};
+
+export const scanStorageDirectory = (dirPath: string): NativeStorageFile[] => {
+    try {
+        const raw = bridge()?.scan(dirPath);
+        return raw ? parse<NativeStorageFile[]>(raw, []) : [];
+    } catch (error) {
+        console.warn('[LinkedStorage] scan failed', error);
+        return [];
+    }
+};
+
+/** 把播放狀態回報給原生 MediaSession，方控的 PLAY_PAUSE 才知道該播還是該停。 */
+export const setNativePlaybackState = (isPlaying: boolean): void => {
+    try {
+        bridge()?.setPlaybackState?.(isPlaying);
+    } catch {
+        // 非車機環境沒有這個方法，靜靜跳過。
+    }
+};
+
+/**
+ * 帶播放位置的版本（v0.9.8）：車機面板的進度、以及「這個 session 還活著」都靠它。
+ * 原生層每秒會自己把位置往前走，暫停時才停。
+ */
+export const reportNativePlayback = (isPlaying: boolean, positionMs: number, durationMs: number): void => {
+    try {
+        const native = bridge();
+        if (native?.reportPlaybackState) {
+            native.reportPlaybackState(isPlaying, Math.max(0, positionMs || 0), Math.max(0, durationMs || 0));
+            return;
+        }
+        native?.setPlaybackState?.(isPlaying);
+    } catch {
+        // 非車機環境沒有這個方法，靜靜跳過。
+    }
+};
+
+export interface NativeWavTranscodeStatus {
+    state: 'running' | 'done' | 'failed' | 'missing';
+    jobId?: string;
+    progress?: number;
+    url?: string;
+    error?: string;
+}
+
+/** 原生層能不能把系統解碼器解得的格式（ALAC／APE／WMA／DSF 等）轉成 WAV 給 WebView 播。 */
+export const canNativeTranscode = (): boolean => {
+    try {
+        return Boolean(bridge()?.canTranscode?.());
+    } catch {
+        return false;
+    }
+};
+
+export const startNativeWavTranscode = (filePath: string): NativeWavTranscodeStatus | null => {
+    try {
+        const raw = bridge()?.startWavTranscode?.(filePath);
+        return raw ? parse<NativeWavTranscodeStatus>(raw, { state: 'failed' }) : null;
+    } catch (error) {
+        console.warn('[LinkedStorage] startWavTranscode failed', error);
+        return null;
+    }
+};
+
+export const pollNativeWavTranscode = (jobId: string): NativeWavTranscodeStatus | null => {
+    try {
+        const raw = bridge()?.wavTranscodeStatus?.(jobId);
+        return raw ? parse<NativeWavTranscodeStatus>(raw, { state: 'missing' }) : null;
+    } catch {
+        return null;
+    }
+};
+
+export interface NativeLyricFile {
+    name: string;
+    path: string;
+    size?: number;
+}
+
+/** 同一個資料夾裡的 .lrc／.vtt（給連結模式的歌詞用；內容之後用 /f/ 網址抓）。 */
+export const listNativeLyrics = (dirPath: string): NativeLyricFile[] => {
+    try {
+        const raw = bridge()?.listLyrics?.(dirPath);
+        return raw ? parse<NativeLyricFile[]>(raw, []) : [];
+    } catch (error) {
+        console.warn('[LinkedStorage] listLyrics failed', error);
+        return [];
+    }
+};
+
+/** 「找不到外接裝置」時用的診斷字串（掛載點、權限、目錄內容）。 */
+export const readNativeDiagnostics = (): string | null => {
+    try {
+        return bridge()?.diagnose?.() ?? null;
+    } catch (error) {
+        console.warn('[LinkedStorage] diagnose failed', error);
+        return null;
+    }
+};
+
+export const probeNativeFile = (filePath: string): NativeProbeResult | null => {
+    try {
+        const raw = bridge()?.probe(filePath);
+        return raw ? parse<NativeProbeResult | null>(raw, null) : null;
+    } catch (error) {
+        console.warn('[LinkedStorage] probe failed', error);
+        return null;
+    }
+};
+
+/** 原生服務的埠號；拿不到就 0（呼叫端要當成「連結模式不可用」）。 */
+let cachedPort = 0;
+export const nativeServerPort = (): number => {
+    if (cachedPort > 0) return cachedPort;
+    try {
+        const value = bridge()?.serverPort();
+        if (typeof value === 'number' && value > 0) cachedPort = value;
+    } catch (error) {
+        console.warn('[LinkedStorage] serverPort failed', error);
+    }
+    return cachedPort;
+};
+
+const base64UrlEncode = (value: string): string => {
+    const bytes = new TextEncoder().encode(value);
+    let binary = '';
+    for (let index = 0; index < bytes.length; index += 1) {
+        binary += String.fromCharCode(bytes[index]);
+    }
+    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};
+
+/** 原生層的串流位址：`<audio src>`、`fetch` 都能用，支援 Range。 */
+export const nativeAudioUrl = (filePath: string): string | null => {
+    const port = nativeServerPort();
+    if (!port) return null;
+    return `http://127.0.0.1:${port}/f/${base64UrlEncode(filePath)}`;
+};
+
+export const nativeCoverUrl = (coverRelativePath: string): string | null => {
+    const port = nativeServerPort();
+    if (!port) return null;
+    if (!coverRelativePath.startsWith('/c/')) return null;
+    return `http://127.0.0.1:${port}${coverRelativePath}`;
+};
+
+/**
+ * 只讀檔頭或中段：音質欄的取樣率／位深只讀 64 KB；真假無損量測則取中間一段（自訂起點），
+ * 避免為了看檔頭或量 20 秒把整首 50 MB 拉進來。
+ */
+export const fetchNativeRange = async (filePath: string, byteLength: number, startAt = 0): Promise<ArrayBuffer | null> => {
+    const url = nativeAudioUrl(filePath);
+    if (!url) return null;
+    const start = Math.max(0, Math.floor(startAt));
+    try {
+        const response = await fetch(url, { headers: { Range: `bytes=${start}-${start + Math.max(0, byteLength - 1)}` } });
+        if (!response.ok && response.status !== 206) return null;
+        return await response.arrayBuffer();
+    } catch (error) {
+        console.warn('[LinkedStorage] Range fetch failed', error);
+        return null;
+    }
+};
+
+export const fetchNativeBlob = async (filePath: string): Promise<Blob | null> => {
+    const url = nativeAudioUrl(filePath);
+    if (!url) return null;
+    try {
+        const response = await fetch(url);
+        if (!response.ok && response.status !== 206) return null;
+        return await response.blob();
+    } catch (error) {
+        console.warn('[LinkedStorage] Blob fetch failed', error);
+        return null;
+    }
+};
