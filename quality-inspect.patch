+// test/unit/textEncodingRepair.test.ts
+// 亂碼修復的回歸測試：這裡的「壞字串」都是真的會被 parser 產生的樣子，
+// 不是手寫的假資料 —— 用 latin1 表示位元組，正是 music-metadata 把 ID3 的 encoding byte 0
+// 當 ISO-8859-1 解出來的結果。
+//
+// 為什麼要有這批用例：Aurora 那類播放器在解 ID3 時是「先試 GBK，看起來像人話才用」，
+// 所以中英混排的歌名（"Track 01 愛"）與單字標籤都能正常顯示；我們以前要求「九成以上是中文」，
+// 這兩類就一直留在亂碼。下面第一組就是照這個差異補的。
+
+import { describe, expect, it } from 'vitest';
+import { repairTagText, repairTagTextList, repairLocalSongTagText } from '../../src/utils/textEncodingRepair';
+import { buildImportedMetadataSnapshot } from '../../src/utils/localSongMetadata';
+
+/** UTF-8 位元組被當西歐編碼解（"Ã¦ÂµÂ" 這型）。 */
+const utf8Mojibake = (text: string): string => {
+    const bytes = Buffer.from(text, 'utf8');
+    return Array.from(bytes).map(byte => String.fromCharCode(byte)).join('');
+};
+describe('repairTagText', () => {
+    it('GBK 標籤（簡中）還原', () => {
+        expect(repairTagText('¸ÃËÀµÄÎÂÈá')).toBe('该死的温柔');
+        expect(repairTagText('ÂíÌìÓî')).toBe('马天宇');
+        expect(repairTagText('Óî¹âÊ®É«')).toBe('宇光十色');
+    });
+
+    it('Big5 標籤（繁中）還原', () => {
+        expect(repairTagText('\u00adS\u00afS\u00a6\u00e8')).toBe('范特西');
+        expect(repairTagText('\u00a9P\u00aaN\u00ad\u00db')).toBe('周杰倫');
+        expect(repairTagText('\u00b8\u00ad\u00b4f\u00ac\u00fc')).toBe('葉惠美');
+    });
+
+    it('UTF-8 被誤讀一次也還原', () => {
+        expect(repairTagText(utf8Mojibake('起风了'))).toBe('起风了');
+        expect(repairTagText(utf8Mojibake('大约'))).toBe('大约');
+    });
+
+    it('中英混排的歌名與單字標籤（Aurora 有、我們以前沒修）', () => {
+        expect(repairTagText('Track 01 \u0090\u00db')).toBe('Track 01 愛');
+        expect(repairTagText('\u00c0\u00ee')).toBe('李');
+        expect(repairTagText('\u00d5\u00c5\u00f6\u00a6\u00d3\u00b1')).toBe('张靓颖');
+    });
+
+    it('真的西歐文字不被動到', () => {
+        expect(repairTagText('Björk')).toBe('Björk');
+        expect(repairTagText('Café')).toBe('Café');
+        expect(repairTagText('Mötley Crüe')).toBe('Mötley Crüe');
+        expect(repairTagText('Motörhead')).toBe('Motörhead');
+        expect(repairTagText('Homogenic')).toBe('Homogenic');
+    });
+
+    it('正常中日韓與 ASCII 原樣返回', () => {
+        expect(repairTagText('该死的温柔')).toBe('该死的温柔');
+        expect(repairTagText('周杰倫')).toBe('周杰倫');
+        expect(repairTagText('起风了')).toBe('起风了');
+        expect(repairTagText('夜に駆ける')).toBe('夜に駆ける');
+        expect(repairTagText('Track 01')).toBe('Track 01');
+        expect(repairTagText('')).toBe('');
+        expect(repairTagText(null)).toBe('');
+        expect(repairTagText(undefined)).toBe('');
+    });
+
+    it('歌手清單逐項修、空字串丟掉', () => {
+        expect(repairTagTextList(['¸ÃËÀµÄÎÂÈá', 'Björk', '', null, 'ÂíÌìÓî']))
+            .toEqual(['该死的温柔', 'Björk', '马天宇']);
+    });
+
+    it('只修匯入值，手動改過的歌名不動', () => {
+        const song = {
+            id: 'a',
+            title: '¸ÃËÀµÄÎÂÈá',
+            titleOrigin: 'import',
+            importedMetadata: { title: '¸ÃËÀµÄÎÂÈá', artistNames: ['ÂíÌìÓî'], albumName: 'Óî¹âÊ®É«' },
+        };
+        const repaired = repairLocalSongTagText(song).song;
+        expect(repaired.title).toBe('该死的温柔');
+        expect(repaired.importedMetadata.artistNames).toEqual(['马天宇']);
+
+        const manual = { ...song, titleOrigin: 'manual' as const, title: '我自己改的名字' };
+        expect(repairLocalSongTagText(manual).song.title).toBe('我自己改的名字');
+    });
+
+    it('匯入快照：檔名與內嵌標籤都先修一次', () => {
+        const snapshot = buildImportedMetadataSnapshot({
+            fileName: '05 - ¸ÃËÀµÄÎÂÈá.mp3',
+            embeddedTitle: '¸ÃËÀµÄÎÂÈá',
+            embeddedArtists: ['ÂíÌìÓî'],
+            embeddedAlbum: 'Óî¹âÊ®É«',
+        });
+        expect(snapshot.title).toBe('该死的温柔');
+        expect(snapshot.artistNames).toEqual(['马天宇']);
+        expect(snapshot.albumName).toBe('宇光十色');
+
+        // 沒有內嵌標籤時退回檔名，檔名裡的亂碼也要修掉。
+        const fromFileName = buildImportedMetadataSnapshot({ fileName: 'Track 01 \u0090\u00db.mp3' });
+        expect(fromFileName.title).toBe('Track 01 愛');
+        expect(fromFileName.titleSource).toBe('filename');
+    });
+});
