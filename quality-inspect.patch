+// src/services/audioQuality/inspectLocalLibrary.ts
+// 掃本地曲庫：把每一首已經在庫裡的本機檔案拿來體檢，找出被撐大的「無損」。
+//
+// 一次只讀一首、量完就丟（decodeAudioData 的 AudioBuffer 動輒幾十 MB，iOS 上不能留），
+// 而且照順序跑：同時解碼好幾首會直接把手機記憶體打爆。掃描可以中止，結果逐筆回報。
+
+import { getLocalSongs } from '../db';
+import { getLocalSongArrayBuffer } from '../localMusicService';
+import type { LocalSong } from '../../types';
+import { inspectAudioBytes, type QualityInspectResult } from './inspectAudioQuality';
+
+export interface LibraryScanOptions {
+    /** 最多檢查幾首（從最近加入的開始）；不給就全部。 */
+    limit?: number;
+    abort?: AbortSignal;
+    /** 每完成一首就回報一次，讓介面即時長出結果。 */
+    onProgress?: (done: number, total: number) => void;
+    onResult?: (result: QualityInspectResult) => void;
+}
+
+const AUDIO_FILE = /\.(flac|wav|aiff|aif|mp3|m4a|aac|ogg|opus|wma|ape|wv|dsf|dff)$/i;
+
+/** 讀不到的檔案（權限掉了、檔案搬走了）不算結果，跳過就好。 */
+export const scanLocalLibraryQuality = async ({ limit, abort, onProgress, onResult }: LibraryScanOptions = {}): Promise<QualityInspectResult[]> => {
+    const songs = (await getLocalSongs() as LocalSong[])
+        .filter(song => AUDIO_FILE.test(song.fileName))
+        .sort((a, b) => (b.addedAt ?? 0) - (a.addedAt ?? 0));
+    const queue = limit && limit > 0 ? songs.slice(0, limit) : songs;
+
+    const results: QualityInspectResult[] = [];
+    for (let index = 0; index < queue.length; index += 1) {
+        if (abort?.aborted) break;
+        const song = queue[index];
+        try {
+            const bytes = await getLocalSongArrayBuffer(song);
+            if (bytes) {
+                const result = await inspectAudioBytes(bytes, song.fileName);
+                results.push(result);
+                onResult?.(result);
+            }
+        } catch (error) {
+            console.warn('[QualityInspect] could not inspect a local song', song.fileName, error);
+        }
+        onProgress?.(index + 1, queue.length);
+    }
+    return results;
+};
+
+/** 曲庫裡有多少首能檢查的檔案（介面上先說清楚範圍）。 */
+export const countInspectableLocalSongs = async (): Promise<number> => {
+    const songs = await getLocalSongs() as LocalSong[];
+    return songs.filter(song => AUDIO_FILE.test(song.fileName)).length;
+};
