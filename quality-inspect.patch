+                                <button type="button" onClick={goManual} className="border border-white/30 px-2 py-1 text-sm hover:bg-white/10">
+                                    {`[${t('localMusic.linkedGoToPath')}]`}
+                                </button>
+                            </div>
+                        ) : null}
+
+                        {/* 找不到外接裝置時，把這台車機實際的掛載狀況攤出來：使用者截圖或貼回來就知道怎麼回事。 */}
+                        {!folder ? (
+                            <div className="mt-3">
+                                <button
+                                    type="button"
+                                    onClick={() => setDiagnostics(readNativeDiagnostics())}
+                                    className="border border-white/20 px-2 py-1 text-xs opacity-70 hover:bg-white/10 hover:opacity-100"
+                                >
+                                    {`[${t('localMusic.linkedDiagnose')}]`}
+                                </button>
