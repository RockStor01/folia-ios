+const acceptableCandidate = (original: string, candidate: string): boolean => {
+    if (!CJK_TEXT_PATTERN.test(candidate) || looksBroken(candidate)) return false;
+    const { ratio, count, visible } = cjkProfile(candidate);
+    const mostlyChinese = ratio >= 0.3 && count >= 2;
+    const tiny = visible <= 2 && count >= 1;
+    const rescueBroken = looksBroken(original) && count >= 1;
+    if (!mostlyChinese && !tiny && !rescueBroken) return false;
+    // 候選要比原字串明顯更像人話，否則寧可原樣返回。
+    return plausibility(candidate) - plausibility(original) >= 1.2;
+};
+
+const decodeCandidate = (label: 'gbk' | 'big5', bytes: Uint8Array, original: string): string | null => {
+    const decoded = decode(label, bytes);
+    if (!decoded) return null;
+    return acceptableCandidate(original, decoded) ? decoded : null;
+};
+
+/** 所有候選一起比：UTF-8 重解、ID3 專用 GBK 修法、GBK 重解、Big5 重解。 */
+const collectCandidates = (text: string): string[] => {
+    const out: string[] = [];
+    const utf8 = tryUtf8Reinterpretation(text);
+    if (utf8) out.push(utf8);
+    const bytes = latin1Bytes(text);
+    if (bytes) {
+        // 舊的 ID3 專用修法只看 0xA1–0xFE 的位元組對，對「整段都是 GBK」最可靠。
+        const legacy = repairLatin1DecodedGbkText(text);
+        if (legacy !== text) out.push(legacy);
+        const gbk = decodeCandidate('gbk', bytes, text);
+        if (gbk) out.push(gbk);
+        const big5 = decodeCandidate('big5', bytes, text);
+        if (big5) out.push(big5);
+    }
+    return Array.from(new Set(out)).filter(candidate => acceptableCandidate(text, candidate));
+};
+
