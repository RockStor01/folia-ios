 import { useLyricSettingsStore } from '../stores/useLyricSettingsStore';
 import { getLocalLyricFilePriority, isSameLocalLyricFormatOrder, normalizeLocalLyricFormatOrder, type LocalLyricFileFormat } from '../utils/lyrics/localLyricFormatOrder';
 import { readLyricFile } from '../utils/lyrics/lyricFileDecoding';
@@ -1204,6 +1205,187 @@ export async function importFolder(expectedRootName?: string): Promise<LocalSong
     }
 }
 
+/** 手機／平板匯入的那批歌掛在這個虛擬根目錄下，跟資料夾掃描進來的歌分得開。 */
+export const IMPORTED_LOCAL_ROOT_NAME = '本機匯入';
+
+export interface ImportAudioFilesResult {
+    songs: LocalSong[];
+    skipped: number;
+    failed: { fileName: string; reason: string }[];
+}
+
+export interface ImportAudioFilesOptions {
+    /** 每處理完一個檔就叫一次，讓介面能顯示「第幾首／共幾首」。 */
+    onProgress?: (info: { done: number; total: number; fileName: string }) => void;
+}
+
+/**
+ * 一次寫進資料庫的批次大小。
+ *
+ * 為什麼要批次：每次寫入都會先跑 ensureLocalLibraryInitialized（把整庫主鍵掃兩遍），
+ * 2216 首的曲子庫、一首一首地存，就等於把整庫掃了 2000 多次——畫面看起來就是「卡死不動」。
+ * 25 首一存，同一個成本只付 1/25。
+ */
+const IMPORT_SAVE_BATCH_SIZE = 25;
+
+/**
+ * 直接吃 <input type=file> 挑回來的檔案，把它們當成本地曲庫裡的歌。
+ *
+ * 存在的理由：iOS 沒有 showDirectoryPicker，資料夾匯入在 iPhone 上根本走不通，於是「本地」
+ * 頁籤永遠是空的。這裡把檔案本體存進 imported 音檔庫，歌曲記錄照資料夾匯入的同一套欄位寫
+ * （時長、抽到的標籤、內嵌封面、ReplayGain 都照舊），所以之後的播放、歌單、歌詞匹配、音質
+ * 體檢都不用改，看到的就是一群普通的本機歌曲。
+ */
+export async function importAudioFiles(
+    files: File[],
+    options: ImportAudioFilesOptions = {},
+): Promise<ImportAudioFilesResult> {
+    const result: ImportAudioFilesResult = { songs: [], skipped: 0, failed: [] };
+    const candidates = files.filter(file => KNOWN_AUDIO_EXTENSIONS.test(file.name));
+    if (candidates.length === 0) return result;
+
+    const allSongs = await getLocalSongs();
+    const existingSignatures = new Set(
+        allSongs
+            .filter(song => song.folderName === IMPORTED_LOCAL_ROOT_NAME)
+            .map(song => `${song.fileName}:${song.fileSize}:${song.fileLastModified ?? 0}`),
+    );
+
+    const pendingSave: LocalSong[] = [];
+    /**
+     * 先並行讀幾首的標籤，再照順序存檔。
+     *
+     * 這裡是整批匯入最花時間的一段：讀檔頭、抽封面、算雜湊。以前是「解析一首、存一首」串著做，
+     * 兩千多首等於把解析排成一條長龍；改成一次先把三首丟給 worker 並行算，算完再依序入庫，
+     * 壁鐘時間大約砍到三分之一，而寫入順序、id、封面都跟原本一樣。
+     */
+    const PARSE_WINDOW = 3;
+    let processedCount = 0;
+
+    for (let start = 0; start < candidates.length; start += PARSE_WINDOW) {
+        const window = candidates.slice(start, start + PARSE_WINDOW);
+        const fresh = window.filter(file => !existingSignatures.has(`${file.name}:${file.size}:${file.lastModified}`));
+        result.skipped += window.length - fresh.length;
+
+        // 先並行解析（解析在 worker 裡，主執行緒這時是空的，不會卡畫面）。
+        const parsed = new Map<File, { embeddedMetadata: EmbeddedMetadata; duration: number }>();
+        await Promise.all(fresh.map(async file => {
+            let embeddedMetadata: EmbeddedMetadata = {};
+            try {
+                embeddedMetadata = await extractEmbeddedMetadata(file, true);
+            } catch (error) {
+                console.warn(`[LocalMusic][Import] Failed to parse metadata for ${file.name}:`, error);
+            }
+            parsed.set(file, { embeddedMetadata, duration: embeddedMetadata.duration || 0 });
+        }));
+
+        for (const file of fresh) {
+            options.onProgress?.({ done: processedCount, total: candidates.length, fileName: file.name });
+            // 每十首讓出一次主執行緒，進度與畫面才跟得上。
+            if (processedCount > 0 && processedCount % 10 === 0) {
+                await new Promise<void>(resolve => { setTimeout(resolve, 0); });
