+// src/components/local/LinkedFolderPicker.tsx
+// 車機「連結模式」的資料夾選擇器：選一個原生目錄，之後只登記路徑、不複製檔案。
+//
+// 為什麼要自己做一個而不是用系統選檔器：Android 的 ACTION_OPEN_DOCUMENT_TREE 只能給 SAF 的
+// DocumentFile，列兩千多筆要幾分鐘，比複製還慢；這裡走的是「所有檔案存取」權限下的 java.io.File，
+// 原生列目錄幾秒就跑完。代價是使用者要自己去系統設定點一次授權，所以第一屏就是講清楚這件事。
+
+import React, { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+    hasStoragePermission,
+    readNativeDiagnostics,
+    listStorageDirectory,
+    listStorageRoots,
+    requestStoragePermission,
+    type NativeStorageDir,
+    type NativeStorageFile,
+    type NativeStorageRoot,
+} from '../../services/nativeLinkedStorage';
+
+interface LinkedFolderPickerProps {
+    onCancel: () => void;
+    onImport: (rootPath: string, rootName: string) => void;
+}
+
+interface CurrentFolder {
+    name: string;
+    path: string;
+    dirs: NativeStorageDir[];
+    files: NativeStorageFile[];
+    error?: string;
+}
+
+const PermissionGate: React.FC<{ onGranted: () => void }> = ({ onGranted }) => {
+    const { t } = useTranslation();
+    useEffect(() => {
+        // 授權頁在系統設定裡，沒有回呼；只能輪詢。使用者按返回就代表放棄，這裡不逼他。
+        const timer = window.setInterval(() => {
+            if (hasStoragePermission()) {
+                window.clearInterval(timer);
+                onGranted();
+            }
+        }, 1200);
+        return () => window.clearInterval(timer);
+    }, [onGranted]);
+    return (
+        <div className="flex flex-col gap-3">
+            <p className="text-sm opacity-80">{t('localMusic.linkedPermissionNeeded')}</p>
+            <p className="text-xs opacity-50">{t('localMusic.linkedFolderHint')}</p>
+            <button
+                type="button"
+                onClick={requestStoragePermission}
+                className="self-start border border-white/30 px-3 py-1.5 text-sm hover:bg-white/10"
+            >
+                {`[${t('localMusic.linkedPermissionAction')}]`}
+            </button>
+        </div>
+    );
+};
+
+export const LinkedFolderPicker: React.FC<LinkedFolderPickerProps> = ({ onCancel, onImport }) => {
+    const { t } = useTranslation();
+    const [permitted, setPermitted] = useState(hasStoragePermission());
+    const [roots, setRoots] = useState<NativeStorageRoot[]>([]);
+    const [folder, setFolder] = useState<CurrentFolder | null>(null);
+    const [diagnostics, setDiagnostics] = useState<string | null>(null);
+
+    const refreshRoots = useCallback(() => {
+        setRoots(listStorageRoots());
+    }, []);
+
+    useEffect(() => {
+        if (permitted) refreshRoots();
+    }, [permitted, refreshRoots]);
+
+    const enter = useCallback((path: string, name: string) => {
+        const listing = listStorageDirectory(path);
+        setFolder({ name, path, dirs: listing.dirs, files: listing.files, error: listing.error });
+    }, []);
+    // 自動探測撈不到的時候（車機把 USB 掛在奇怪的地方），留一條手動輸入路徑的路。
+    const [manualPath, setManualPath] = useState('');
+    const [diagnostic, setDiagnostic] = useState<string | null>(null);
+    const goManual = useCallback(() => {
+        const value = manualPath.trim();
+        if (!value) return;
+        setManualPath('');
+        enter(value, value.split('/').filter(Boolean).pop() ?? value);
+    }, [enter, manualPath]);
+
+    const goUp = useCallback(() => {
+        if (!folder) return;
+        const parent = folder.path.replace(/\/[^/]+\/?$/, '') || '/';
+        if (parent === '/' || parent === folder.path) {
+            setFolder(null);
+            return;
+        }
+        const name = parent.split('/').filter(Boolean).pop() ?? parent;
+        enter(parent, name);
+    }, [enter, folder]);
+
+    return (
+        <div className="fixed inset-0 z-[70] flex items-center justify-center bg-black/70 p-4" onClick={onCancel}>
+            <div
+                className="max-h-[80vh] w-full max-w-[560px] overflow-y-auto border border-white/20 bg-neutral-950 p-4 text-neutral-100"
+                onClick={event => event.stopPropagation()}
+                data-linked-folder-picker
+            >
+                <div className="mb-3 flex items-center justify-between gap-3">
+                    <span className="text-base">{t('localMusic.linkedPickFolder')}</span>
+                    <button type="button" onClick={onCancel} className="opacity-60 hover:opacity-100">{`[${t('localMusic.cancel')}]`}</button>
+                </div>
+
+                {!permitted ? (
+                    <PermissionGate onGranted={() => setPermitted(true)} />
+                ) : (
+                    <>
+                        <div className="mb-2 break-all text-xs opacity-50">{folder ? folder.path : '/'}</div>
+
+                        {folder ? (
+                            <>
+                                <button type="button" onClick={goUp} className="mb-2 block text-sm opacity-70 hover:opacity-100">
+                                    {`← ${t('localMusic.linkedUpFolder')}`}
+                                </button>
+                                {folder.error ? (
+                                    <p className="py-2 text-sm text-amber-300/90">{t('localMusic.linkedUnreadable')}</p>
+                                ) : null}
+                                {!folder.error && folder.dirs.length === 0 && folder.files.length === 0 ? (
+                                    <p className="py-3 text-sm opacity-60">{t('localMusic.linkedEmptyFolder')}</p>
+                                ) : null}
+                                <ul className="mb-3 flex flex-col">
+                                    {folder.dirs.map(directory => (
+                                        <li key={directory.path}>
+                                            <button
+                                                type="button"
+                                                onClick={() => enter(directory.path, directory.name)}
+                                                className="w-full break-all py-1.5 text-left text-sm hover:bg-white/10"
+                                            >
+                                                {`${directory.name}/`}
+                                            </button>
+                                        </li>
+                                    ))}
+                                </ul>
+                                {folder.files.length > 0 ? (
+                                    <p className="mb-3 text-xs opacity-50">
+                                        {t('localMusic.linkedFoundCount', { count: folder.files.length })}
+                                    </p>
+                                ) : null}
+                                <button
+                                    type="button"
+                                    onClick={() => onImport(folder.path, folder.name)}
+                                    className="border border-white/30 px-3 py-1.5 text-sm hover:bg-white/10"
+                                >
+                                    {`[${t('localMusic.linkedUseThisFolder')}]`}
+                                </button>
+                            </>
+                        ) : (
+                            <ul className="flex flex-col">
+                                {roots.length === 0 ? (
+                                    <li className="py-3 text-sm opacity-60">{t('localMusic.linkedNoFolder')}</li>
+                                ) : null}
+                                {roots.map(root => (
+                                    <li key={root.path}>
+                                        <button
+                                            type="button"
+                                            onClick={() => enter(root.path, root.name)}
+                                            className="w-full break-all py-1.5 text-left text-sm hover:bg-white/10"
+                                        >
+                                            {`${root.name}（${root.path}）${root.readable === false ? '  ⚠' : ''}`}
+                                        </button>
+                                    </li>
+                                ))}
+                            </ul>
+                        )}
+
+                        {!folder ? (
+                            <div className="mt-3 flex items-center gap-2">
+                                <input
+                                    value={manualPath}
+                                    onChange={event => setManualPath(event.target.value)}
+                                    onKeyDown={event => { if (event.key === 'Enter') goManual(); }}
+                                    placeholder="/storage/1234-5678"
+                                    className="min-w-0 flex-1 border border-white/20 bg-transparent px-2 py-1 text-sm outline-none"
+                                />
+                                <button type="button" onClick={goManual} className="border border-white/30 px-2 py-1 text-sm hover:bg-white/10">
+                                    {`[${t('localMusic.linkedGoToPath')}]`}
+                                </button>
+                            </div>
+                        ) : null}
+
+                        {/* 找不到外接裝置時，把這台車機實際的掛載狀況攤出來：使用者截圖或貼回來就知道怎麼回事。 */}
+                        {!folder ? (
+                            <div className="mt-3">
+                                <button
+                                    type="button"
+                                    onClick={() => setDiagnostics(readNativeDiagnostics())}
+                                    className="border border-white/20 px-2 py-1 text-xs opacity-70 hover:bg-white/10 hover:opacity-100"
+                                >
+                                    {`[${t('localMusic.linkedDiagnose')}]`}
+                                </button>
+                                {diagnostics ? (
+                                    <>
+                                        <p className="mt-2 text-xs opacity-50">{t('localMusic.linkedDiagnoseHint')}</p>
+                                        <pre className="mt-1 max-h-[30vh] overflow-auto whitespace-pre-wrap break-all border border-white/20 p-2 text-[11px] leading-relaxed opacity-80">{diagnostics}</pre>
+                                    </>
+                                ) : null}
+                            </div>
+                        ) : null}
+
+                        <p className="mt-3 text-xs opacity-40">{t('localMusic.linkedFolderHint')}</p>
+                    </>
+                )}
+            </div>
+        </div>
+    );
+};
+
+export default LinkedFolderPicker;
