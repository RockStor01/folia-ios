index 0000000..09351ac
--- /dev/null
+++ b/src/services/audioQuality/qualityProbe.ts
@@ -0,0 +1,415 @@
+// src/services/audioQuality/qualityProbe.ts
+// 只讀檔頭：容器「自稱」是幾 kHz、幾 bit，不碰音訊資料。
+//
+// Web Audio 的 decodeAudioData 只給回解碼後的 AudioBuffer，取樣率已經被重採樣到 context 的
+// 取樣率，所以「容器標稱」必須從位元組自己讀，否則量到的 Nyquist 永遠是我們自己選的。
+// v0.9.6 起把常見但以前讀不出來的容器也認了：m4a/mp4（AAC、ALAC）、ogg（Vorbis、Opus）、
+// dsf（DSD）。讀不出規格的容器仍然回 null，呼叫端會標成「無法判斷」而不是留白。
+
+export interface ContainerProbe {
+    codec: string;
+    /** 容器自稱的取樣率（Hz）；0 = 讀不出來。 */
+    sampleRate: number;
+    /** 容器自稱的位元（FLAC / WAV / AIFF / DSF 才有）；0 = 不知道。 */
+    bitDepth: number;
+    channels: number;
+    /** 容器本身是否無損（判斷「假無損」的前提）。 */
+    lossless: boolean;
+    /** 總長（秒）；null = 不知道。 */
+    durationSec: number | null;
+}
+
+const MPEG1_RATES = [44100, 48000, 32000];
+const MPEG2_RATES = [22050, 24000, 16000];
+const MPEG25_RATES = [11025, 12000, 8000];
+
+const ascii = (bytes: Uint8Array, offset: number, length = 4): string => {
+    let text = '';
+    for (let i = 0; i < length; i += 1) text += String.fromCharCode(bytes[offset + i] ?? 0);
+    return text;
+};
+
+const u16 = (bytes: Uint8Array, offset: number): number => (bytes[offset] | (bytes[offset + 1] << 8));
+const u32 = (bytes: Uint8Array, offset: number): number =>
+    (bytes[offset] | (bytes[offset + 1] << 8) | (bytes[offset + 2] << 16) | (bytes[offset + 3] << 24)) >>> 0;
+const i32be = (bytes: Uint8Array, offset: number): number =>
+    ((bytes[offset] << 24) | (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3]);
+/** MP4 的 box 內容一律是 big-endian，別跟 DSF / Ogg 的 little-endian 讀法混用。 */
+const be16 = (bytes: Uint8Array, offset: number): number => ((bytes[offset] << 8) | bytes[offset + 1]);
+const be32 = (bytes: Uint8Array, offset: number): number =>
+    ((bytes[offset] * 2 ** 24) + (bytes[offset + 1] << 16) + (bytes[offset + 2] << 8) + bytes[offset + 3]) >>> 0;
+
+const probeFlac = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 34 || bytes[0] !== 0x66 || bytes[1] !== 0x4c || bytes[2] !== 0x61 || bytes[3] !== 0x43) return null;
+    // STREAMINFO 的資料從 offset 8 開始：minBlock 2 + maxBlock 2 + minFrame 3 + maxFrame 3 = 10 bytes
+    // 之後 8 bytes 依序是：取樣率 20 bit、聲道 3 bit、位深 5 bit、總樣本數 36 bit。
+    const b18 = bytes[18];
+    const b19 = bytes[19];
+    const b20 = bytes[20];
+    const b21 = bytes[21];
+    const sampleRate = (b18 << 12) | (b19 << 4) | (b20 >> 4);
+    const channels = ((b20 >> 1) & 0x07) + 1;
+    const bitDepth = (((b20 & 0x01) << 4) | (b21 >> 4)) + 1;
+    const totalSamples = (b21 & 0x0f) * 2 ** 32
+        + bytes[22] * 2 ** 24 + bytes[23] * 2 ** 16 + bytes[24] * 2 ** 8 + bytes[25];
+    if (!sampleRate) return null;
+    return {
+        codec: 'flac',
+        sampleRate,
+        bitDepth,
+        channels,
+        lossless: true,
+        durationSec: totalSamples ? totalSamples / sampleRate : null,
+    };
+};
+
+const probeWav = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 44) return null;
+    const tag = ascii(bytes, 0);
+    if (tag !== 'RIFF') return null;
+    if (ascii(bytes, 8) !== 'WAVE') return null;
+
+    let offset = 12;
+    let sampleRate = 0;
+    let channels = 0;
+    let bitDepth = 0;
+    let dataBytes = 0;
+    while (offset + 8 <= bytes.length) {
+        const id = ascii(bytes, offset);
+        const size = bytes[offset + 4] | (bytes[offset + 5] << 8) | (bytes[offset + 6] << 16) | (bytes[offset + 7] << 24);
+        const body = offset + 8;
+        if (id === 'fmt ' && body + 16 <= bytes.length) {
+            channels = bytes[body + 2] | (bytes[body + 3] << 8);
+            sampleRate = bytes[body + 4] | (bytes[body + 5] << 8) | (bytes[body + 6] << 16) | (bytes[body + 7] << 24);
+            bitDepth = bytes[body + 14] | (bytes[body + 15] << 8);
+            if (!bitDepth) {
+                // WAVE_FORMAT_EXTENSIBLE：容器位深在 validBitsPerSample
+                const valid = body + 18 <= bytes.length ? (bytes[body + 18] | (bytes[body + 19] << 8)) : 0;
+                bitDepth = valid || 0;
+            }
+        } else if (id === 'data') {
+            dataBytes = Math.max(0, size);
+            break;
+        }
+        offset = body + size + (size % 2);
+        if (size <= 0) break;
+    }
+    if (!sampleRate) return null;
+    const durationSec = (channels && bitDepth && dataBytes)
+        ? dataBytes / (sampleRate * channels * Math.max(1, bitDepth / 8))
+        : null;
+    return { codec: 'wav', sampleRate, bitDepth, channels, lossless: true, durationSec };
+};
+
+/** AIFF 的取樣率是 80-bit IEEE 754 extended 格式。 */
+const readExtendedFloat = (bytes: Uint8Array, offset: number): number => {
+    const sign = bytes[offset] & 0x80 ? -1 : 1;
+    const exponent = ((bytes[offset] & 0x7f) << 8) | bytes[offset + 1];
+    if (exponent === 0 && bytes[offset + 2] === 0) return 0;
+    let mantissa = 0;
+    for (let i = 0; i < 8; i += 1) mantissa = mantissa * 256 + bytes[offset + 2 + i];
+    return sign * mantissa * 2 ** (exponent - 16383 - 63);
+};
+
+const probeAiff = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 12) return null;
+    if (ascii(bytes, 0) !== 'FORM') return null;
+    const form = ascii(bytes, 8);
+    if (form !== 'AIFF' && form !== 'AIFC') return null;
+
+    let offset = 12;
+    while (offset + 8 <= bytes.length) {
+        const id = ascii(bytes, offset);
+        const size = bytes[offset + 4] * 2 ** 24 + bytes[offset + 5] * 2 ** 16 + bytes[offset + 6] * 2 ** 8 + bytes[offset + 7];
+        const body = offset + 8;
+        if (id === 'COMM' && body + 18 <= bytes.length) {
+            const channels = bytes[body] * 2 ** 8 + bytes[body + 1];
+            const frames = bytes[body + 2] * 2 ** 24 + bytes[body + 3] * 2 ** 16 + bytes[body + 4] * 2 ** 8 + bytes[body + 5];
+            const bitDepth = bytes[body + 6] * 2 ** 8 + bytes[body + 7];
+            const sampleRate = readExtendedFloat(bytes, body + 8);
+            if (!sampleRate) return null;
+            return {
+                codec: form === 'AIFC' ? 'aifc' : 'aiff',
+                sampleRate: Math.round(sampleRate),
+                bitDepth,
+                channels,
+                lossless: true,
+                durationSec: frames ? frames / sampleRate : null,
+            };
+        }
+        if (size <= 0) break;
+        offset = body + size + (size % 2);
+    }
+    return null;
+};
+
+const MPEG1_L3_BITRATES = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320];
+const MPEG2_L3_BITRATES = [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160];
+const MPEG1_L1_BITRATES = [0, 32, 64, 96, 128, 160, 192, 224, 256, 288, 320, 352, 384, 416, 448];
+const MPEG1_L2_BITRATES = [0, 32, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384];
+const MPEG2_L1_BITRATES = [0, 32, 48, 56, 64, 80, 96, 112, 128, 144, 160, 176, 192, 224, 256];
+
+interface Mp3Frame { versionBits: number; layerBits: number; rateIndex: number; bitrateIndex: number; padding: number; frameLength: number }
+
+const readMp3Frame = (bytes: Uint8Array, i: number): Mp3Frame | null => {
+    if (i + 4 > bytes.length) return null;
+    if (bytes[i] !== 0xff || (bytes[i + 1] & 0xe0) !== 0xe0) return null;
+    const versionBits = (bytes[i + 1] >> 3) & 0x03;
+    const layerBits = (bytes[i + 1] >> 1) & 0x03;
+    const bitrateIndex = (bytes[i + 2] >> 4) & 0x0f;
+    const rateIndex = (bytes[i + 2] >> 2) & 0x03;
+    const padding = (bytes[i + 2] >> 1) & 0x01;
+    if (versionBits === 1 || layerBits === 0 || rateIndex === 3) return null;
+    if (bitrateIndex === 0 || bitrateIndex === 0x0f) return null;
+    const rates = versionBits === 3 ? MPEG1_RATES : versionBits === 2 ? MPEG2_RATES : MPEG25_RATES;
+    const rate = rates[rateIndex];
+    const table = layerBits === 3 ? (versionBits === 3 ? MPEG1_L1_BITRATES : MPEG2_L1_BITRATES)
+        : layerBits === 2 ? MPEG1_L2_BITRATES
+            : (versionBits === 3 ? MPEG1_L3_BITRATES : MPEG2_L3_BITRATES);
+    const bitrate = table[bitrateIndex] * 1000;
+    // Layer I：384 samples/幀；Layer II：1152；Layer III：MPEG1 1152、MPEG2/2.5 576。
+    const samplesPerFrame = layerBits === 3 ? 384 : layerBits === 2 ? 1152 : (versionBits === 3 ? 1152 : 576);
+    const frameLength = Math.floor(samplesPerFrame / 8 * bitrate / rate) + padding;
+    if (frameLength < 4) return null;
+    return { versionBits, layerBits, rateIndex, bitrateIndex, padding, frameLength };
+};
+
+const probeMp3 = (bytes: Uint8Array): ContainerProbe | null => {
+    let start = 0;
+    if (bytes.length > 10 && bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) {
+        // ID3v2 標頭 10 bytes，大小是 syncsafe 整數；v2.4 可能帶 10 bytes footer。
+        const size = (bytes[6] & 0x7f) * 2 ** 21 + (bytes[7] & 0x7f) * 2 ** 14 + (bytes[8] & 0x7f) * 2 ** 7 + (bytes[9] & 0x7f);
+        const version = bytes[3];
+        const footer = version >= 4 && (bytes[5] & 0x10) ? 10 : 0;
+        start = 10 + size + footer;
+    }
+    // 有些檔在 ID3 之後還夾著 APE 標籤或零碎資料，所以往前多找一點（最多 1 MB）。
+    // 但壓縮資料裡出現位元組 0xFF 的機率不低，所以要求「下一幀確實在 frameLength 之後」才算數。
+    const limit = Math.min(bytes.length - 4, Math.max(start + 4096, start + 1024 * 1024));
+    for (let i = Math.max(0, start); i < limit; i += 1) {
+        const frame = readMp3Frame(bytes, i);
+        if (!frame) continue;
+        const next = readMp3Frame(bytes, i + frame.frameLength);
+        const confirmed = next
+            && next.versionBits === frame.versionBits
+            && next.layerBits === frame.layerBits
+            && next.rateIndex === frame.rateIndex;
+        // 檔案太短、切在最後一幀時沒有下一幀可驗：只有在檔案開頭（連續兩幀都讀得到）才放行。
+        if (!confirmed && i > 4096) continue;
+        const rates = frame.versionBits === 3 ? MPEG1_RATES : frame.versionBits === 2 ? MPEG2_RATES : MPEG25_RATES;
+        return {
+            codec: 'mp3',
+            sampleRate: rates[frame.rateIndex],
+            bitDepth: 0,
+            channels: ((bytes[i + 3] >> 6) & 0x03) === 3 ? 1 : 2,
+            lossless: false,
+            durationSec: null,
+        };
+    }
+    return null;
+};
+
+// ---------------------------------------------------------------- MP4 / M4A
+
+const MP4_AUDIO_CODECS: Record<string, { lossless: boolean }> = {
+    mp4a: { lossless: false },
+    alac: { lossless: true },
+    'ac-3': { lossless: false },
+    'ec-3': { lossless: false },
+    fLaC: { lossless: true },
+    Opus: { lossless: false },
+    sowt: { lossless: true },
+    lpcm: { lossless: true },
+};
+
+const findBox = (bytes: Uint8Array, from: number, to: number, type: string): { start: number; end: number } | null => {
+    let offset = from;
+    while (offset + 8 <= to) {
+        let size = i32be(bytes, offset);
+        const boxType = ascii(bytes, offset + 4);
+        let headerSize = 8;
+        if (size === 1) {
+            // 64-bit largesize
+            if (offset + 16 > to) return null;
+            size = i32be(bytes, offset + 8) * 2 ** 32 + (i32be(bytes, offset + 12) >>> 0);
+            headerSize = 16;
+        } else if (size === 0) {
+            size = to - offset;
+        }
+        if (size < headerSize) return null;
+        const start = offset + headerSize;
+        const end = Math.min(to, offset + size);
+        if (boxType === type) return { start, end };
+        offset += size;
+    }
+    return null;
+};
+
+const probeMp4 = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 16) return null;
+    // moov 可能在檔頭（faststart）也可能在檔尾（ffmpeg 預設）。檔尾視窗沒有 ftyp，
+    // 所以這裡不強求 ftyp，只要求找得到 moov。
+
+    // moov 可能在檔頭（faststart），也可能在檔尾；這裡只讀得到檔頭，讀不到就交給呼叫端加大視窗。
+    const moov = findBox(bytes, 0, bytes.length, 'moov');
+    if (!moov) return null;
+
+    let sampleRate = 0;
+    let channels = 0;
+    let bitDepth = 0;
+    let codec = '';
+    let lossless = false;
+    let durationSec: number | null = null;
+
+    const mvhd = findBox(bytes, moov.start, moov.end, 'mvhd');
+    if (mvhd) {
+        const version = bytes[mvhd.start];
+        const cursor = mvhd.start + 4 + (version === 1 ? 16 : 8);
+        const timescale = be32(bytes, cursor);
+        const duration = version === 1
+            ? (be32(bytes, cursor + 8) * 2 ** 32 + be32(bytes, cursor + 12))
+            : be32(bytes, cursor + 4);
+        if (timescale) durationSec = duration / timescale;
+    }
+
+    const trak = findBox(bytes, moov.start, moov.end, 'trak');
+    const mdia = trak ? findBox(bytes, trak.start, trak.end, 'mdia') : null;
+    const minf = mdia ? findBox(bytes, mdia.start, mdia.end, 'minf') : null;
+    const stbl = minf ? findBox(bytes, minf.start, minf.end, 'stbl') : null;
+    const stsd = stbl ? findBox(bytes, stbl.start, stbl.end, 'stsd') : null;
+    if (stsd) {
+        // stsd：version/flags 4 bytes + entryCount 4 bytes，之後是 sample entry。
+        const entryStart = stsd.start + 8;
+        const entryEnd = Math.min(stsd.end, bytes.length);
+        if (entryStart + 36 <= entryEnd) {
+            const entryType = ascii(bytes, entryStart + 4);
+            if (MP4_AUDIO_CODECS[entryType]) {
+                codec = entryType === 'mp4a' ? 'aac' : entryType.toLowerCase();
+                lossless = MP4_AUDIO_CODECS[entryType].lossless;
+                // AudioSampleEntry（起點＝entryStart，前面 8 bytes 是 size+type）：
+                // +8 6 reserved、+14 dataRefIndex、+16 version、+18 revision、+20 vendor(4)、
+                // +24 channels、+26 sampleSize、+28 compressionId、+30 packetSize、+32 sampleRate(16.16)
+                channels = be16(bytes, entryStart + 24);
+                bitDepth = be16(bytes, entryStart + 26);
+                sampleRate = Math.round(be32(bytes, entryStart + 32) / 65536);
+            }
+        }
+    }
+
+    if (!sampleRate) return null;
+    return {
+        codec: codec || 'mp4',
+        sampleRate,
+        bitDepth,
+        channels,
+        lossless,
+        durationSec,
+    };
+};
+
+// ---------------------------------------------------------------- Ogg
+
+const probeOgg = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 64 || ascii(bytes, 0) !== 'OggS') return null;
+    // 第一頁的 payload 緊接在 segment table 之後。
+    const segments = bytes[26];
+    const payload = 27 + segments;
+    if (payload + 16 > bytes.length) return null;
+
+    if (ascii(bytes, payload + 1, 6) === 'vorbis') {
+        // 0x01 'vorbis' version(4) channels(1) sampleRate(4)
+        const channels = bytes[payload + 11];
+        const sampleRate = u32(bytes, payload + 12);
+        if (!sampleRate) return null;
+        return {
+            codec: 'vorbis', sampleRate, bitDepth: 0, channels, lossless: false,
+            durationSec: null,
+        };
+    }
+    if (ascii(bytes, payload, 8) === 'OpusHead') {
+        // OpusHead version(1) channels(1) preskip(2) inputSampleRate(4)
+        const channels = bytes[payload + 9];
+        const inputRate = u32(bytes, payload + 12);
+        return {
+            codec: 'opus',
+            // Opus 內部一律 48 kHz；標稱的 input rate 只是原始素材的提示。
+            sampleRate: inputRate || 48000,
+            bitDepth: 0,
+            channels: channels || 2,
+            lossless: false,
+            durationSec: null,
+        };
+    }
+    return null;
+};
+
+// ---------------------------------------------------------------- DSD
+
+const probeDsf = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 64 || ascii(bytes, 0) !== 'DSD ') return null;
+    let offset = 28; // 'DSD ' chunk（28 bytes：id+size+fileSize+metadataPtr）
+    while (offset + 12 <= bytes.length) {
+        const id = ascii(bytes, offset);
+        // DSF 的 chunk 大小是 8 bytes little-endian 的「整個 chunk 長度」
+        const size = bytes[offset + 4] | (bytes[offset + 5] << 8) | (bytes[offset + 6] << 16) | (bytes[offset + 7] << 24);
+        const body = offset + 12;
+        if (id === 'fmt ') {
+            const channels = u32(bytes, body + 8);
+            const sampleRate = u32(bytes, body + 12);
+            const bitDepth = u32(bytes, body + 16);
+            const sampleCount = u32(bytes, body + 24) * 2 ** 32 + u32(bytes, body + 20);
+            if (!sampleRate) return null;
+            return {
+                codec: 'dsd',
+                sampleRate,
+                bitDepth: bitDepth || 1,
+                channels: channels || 2,
+                lossless: true,
+                durationSec: sampleCount ? sampleCount / sampleRate : null,
+            };
+        }
+        if (size <= 0) break;
+        offset += size;
+    }
+    return null;
+};
+
+const probeDff = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 32 || ascii(bytes, 0) !== 'FRM8') return null;
+    if (ascii(bytes, 12) !== 'DSD ') return null;
+    // 找 PROP 底下的 SND 裡的 FS  （取樣率）與 CHNL（聲道）。
+    let sampleRate = 0;
+    let channels = 0;
+    for (let i = 16; i + 4 <= Math.min(bytes.length, 4096); i += 1) {
+        const id = ascii(bytes, i);
+        if (id === 'FS  ') {
+            const value = (bytes[i + 4] << 24 >>> 0) + (bytes[i + 5] << 16) + (bytes[i + 6] << 8) + bytes[i + 7];
+            sampleRate = value;
+        } else if (id === 'CHNL') {
+            channels = (bytes[i + 8] << 8) | bytes[i + 9];
+        }
+    }
+    if (!sampleRate) return null;
+    return {
+        codec: 'dsd', sampleRate, bitDepth: 1, channels: channels || 2, lossless: true, durationSec: null,
+    };
+};
+
+/** 檔尾視窗：沒有 faststart 的 m4a 把 moov 放在最後，只讀尾巴也要能認出來。 */
+export const probeContainerFromTail = (buffer: ArrayBuffer): ContainerProbe | null =>
+    probeMp4(new Uint8Array(buffer, 0, buffer.byteLength));
+
+/** 讀檔頭得到容器自稱的規格；讀不出來時回 null。 */
+export const probeContainer = (buffer: ArrayBuffer): ContainerProbe | null => {
+    const bytes = new Uint8Array(buffer, 0, buffer.byteLength);
+    // 先用 magic 決定走哪一支：壓縮過的音訊資料很容易「看起來像」MP3 幀，
+    // 所以認得 magic 的容器就不再往下試 MP3，避免把 m4a 標成 44.1k 有損。
+    if (ascii(bytes, 4) === 'ftyp') return probeMp4(bytes);
+    if (ascii(bytes, 0) === 'OggS') return probeOgg(bytes);
+    if (ascii(bytes, 0) === 'DSD ') return probeDsf(bytes);
+    if (ascii(bytes, 0) === 'FRM8') return probeDff(bytes);
+    return probeFlac(bytes)
+        ?? probeWav(bytes)
+        ?? probeAiff(bytes)
+        ?? probeMp3(bytes);
+};
