+        "alacDepth": "ALAC bit depth and channel count used to read as 0; they now match the file (24bit, for example).",
+        "unknownRetry": "Results that the previous version gave up on are judged again (cache prefix bumped to v2)."
+      }
+    },
+    "v0_9_5": {
+      "intro": "0.9.5 does one thing: it fixes song titles, albums and artists that came out garbled. Existing libraries do not need re-importing — broken text already stored is repaired the next time the app opens.",
+      "mojibakeFix": {
+        "title": "Automatic mojibake repair (GBK / UTF-8 / Big5)",
+        "description": "Old rips often put GBK bytes into ID3 frames declared as ISO-8859-1, and Android's native tag API returns them the same way. Imports and reads of existing records now try the correct decoding first: UTF-8 misread, GBK misread and Traditional Chinese Big5 misread are all recovered, while normal Chinese, Japanese, Björk or Café are left untouched.",
+      },
