+// src/services/musicbrainzSearch.ts
+// 線上補標籤：拿歌名＋歌手去 MusicBrainz 查錄音，回傳最可信的幾筆候選（歌名／歌手／專輯／年份）。
+// 只查「文字資料」，不下載任何音檔；MusicBrainz 開放 CORS，車機有網路就能用。
+const MB_ENDPOINT = 'https://musicbrainz.org/ws/2/recording';
+const USER_AGENT = 'Folia/0.9.16 (https://github.com/RockStor01/folia-ios)';
+
+export interface MusicBrainzMatch {
+    recordingId: string;
+    title: string;
+    artist: string;
+    album?: string;
+    year?: string;
+    score: number;
+}
+
+const escapeLucene = (value: string): string => value.replace(/["\\]/g, ' ').trim();
+
+/** 查錄音候選。查不到或網路不通就回空陣列，呼叫端只顯示「查不到」，不影響其他功能。 */
+export const searchMusicBrainzRecordings = async (
+    title: string,
+    artist?: string,
+    limit = 5,
+): Promise<MusicBrainzMatch[]> => {
+    const cleanTitle = escapeLucene(title);
+    if (!cleanTitle) return [];
+    const cleanArtist = artist ? escapeLucene(artist) : '';
+    const query = cleanArtist
+        ? `recording:"${cleanTitle}" AND artist:"${cleanArtist}"`
+        : `recording:"${cleanTitle}"`;
+    const url = `${MB_ENDPOINT}?query=${encodeURIComponent(query)}&fmt=json&limit=${Math.min(Math.max(limit, 1), 10)}`;
+    try {
+        const response = await fetch(url, { headers: { 'User-Agent': USER_AGENT, Accept: 'application/json' } });
+        if (!response.ok) return [];
+        const data = await response.json() as {
+            recordings?: Array<{
+                id?: string;
+                title?: string;
+                score?: number;
+                'artist-credit'?: Array<{ name?: string; artist?: { name?: string } }>;
+                releases?: Array<{ title?: string; date?: string }>;
+            }>;
+        };
+        const rows = data.recordings ?? [];
+        return rows.map(row => {
+            const artists = (row['artist-credit'] ?? [])
+                .map(credit => credit.name || credit.artist?.name || '')
+                .filter(Boolean);
+            const release = row.releases?.find(item => item.title);
+            return {
+                recordingId: row.id ?? '',
+                title: String(row.title ?? '').trim(),
+                artist: artists.join(' / '),
+                album: release?.title,
+                year: release?.date?.slice(0, 4),
+                score: Number(row.score ?? 0),
+            };
+        }).filter(match => match.recordingId && match.title);
+    } catch (error) {
+        console.warn('[MusicBrainz] search failed', error);
+        return [];
+    }
+};
