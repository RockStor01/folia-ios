--- /dev/null
+++ b/src/services/audioQuality/localQualityIndex.ts
@@ -0,0 +1,204 @@
+// src/services/audioQuality/localQualityIndex.ts
+// 曲庫列表上的「音質」欄：採樣率／位深幾乎不用算（讀前 64 KB 的檔頭就有），真假無損才要解碼量頻譜。
+// 所以這裡分兩段：
+//   1. 檔頭段：`probeContainer` 讀容器自稱的規格。有損編碼直接標「有損」，到此為止。
+//   2. 量測段：只有無損容器才值得驗——讀中段一小段（預設 12 MB）解 20 秒、量截止點，判斷有沒有被撐大。
+//      切片解不開（moov 在檔尾之類）才回頭整首讀，這是慢路徑。
+// 結果寫進 metadata_cache（key 帶版本號），同一個檔案第二次開清單就不再解碼。
+// v0.9.6：快取前綴升到 v2（舊版留下的 unknown 判決一律重判），並把「讀不到」也記在記憶體裡，
+// 免得每滾一次清單就把同一個壞檔重試一次。
+
+import type { LocalSong } from '../../types';
+import { getLocalSongHeaderBytes, getLocalSongRangeBytes, getLocalSongArrayBuffer } from '../localMusicService';
+import { getLocalSong } from '../db';
+import { putCacheEntry, readCacheEntry } from '../repositories/cacheRepository';
+import { probeContainer, probeContainerFromTail, type ContainerProbe } from './qualityProbe';
+import { inspectAudioBytes, type QualityInspectResult } from './inspectAudioQuality';
+
+/** 量測結論。`unknown` 是解不開／取樣率超出 WebKit 上限，介面上顯示成「待檢」而不是判它假。 */
+export type QualityVerdictLabel = 'trueLossless' | 'fakeLossless' | 'unknown' | 'lossy';
+
+export interface LocalQualityEntry {
+    songId: string;
+    codec: string;
+    sampleRate: number;
+    bitDepth: number;
+    /** 容器本身是否無損（flac / wav / aiff / alac / dsd）。 */
+    lossless: boolean;
+    /** 量測結論；null = 還沒量（無損容器要解碼才算），有損編碼一律 `lossy`。 */
+    verdict: QualityVerdictLabel | null;
+}
+
+/** 舊版（v1）判過 `unknown` 的結果會永遠卡著，換前綴讓它們重判一次。 */
+const CACHE_PREFIX = 'local_quality_v2:';
+/** 記憶體快取：清單滾動時同一首會被反覆問，別每次都打 IndexedDB。 */
+const memory = new Map<string, LocalQualityEntry>();
+/** 讀不到檔頭的歌（權限掉了、檔案搬走了）：只在這次執行內記住，下次開啟再試一次。 */
+const failed = new Set<string>();
+const pending = new Map<string, Promise<LocalQualityEntry | null>>();
+
+/**
+ * 檔頭視窗：一般容器 64 KB 就夠；m4a 的 moov 可能很大（封面、章節都放在裡面），讀 2 MB 再試一次。
+ * 讀檔頭很便宜（本機是 slice，連結模式是一次 Range 請求），值得多讀。
+ */
+const HEADER_BYTES = 64 * 1024;
+const HEADER_BYTES_LARGE = 2 * 1024 * 1024;
+const LARGE_HEADER_FILE = /\.(m4a|m4b|mp4|aac|mov)$/i;
+/** 量測切片：12 MB 在 1411 kbps 的 FLAC 上約 85 秒，已遠超 20 秒的分析窗。 */
+const MEASURE_SLICE_BYTES = 12 * 1024 * 1024;
+/**
+ * 這些容器可以從中段開始切：MP3 與 Ogg 的框本身能自我同步，MP4 的 moov 在檔頭（faststart）時也行。
+ * FLAC / WAV / AIFF / DSD 的檔頭（STREAMINFO、fmt、COMM）必須在資料前面，只能從 0 開始切。
+ */
+const MID_SLICE_CODECS = new Set(['mp3', 'ogg', 'vorbis', 'opus', 'aac', 'mp4', 'm4a']);
+
+export const getCachedQuality = (songId: string): LocalQualityEntry | undefined => memory.get(songId);
+
+const store = async (entry: LocalQualityEntry): Promise<LocalQualityEntry> => {
+    memory.set(entry.songId, entry);
+    try {
+        await putCacheEntry(`${CACHE_PREFIX}${entry.songId}`, entry);
+    } catch (error) {
+        console.warn('[LocalQuality] Failed to cache quality entry:', error);
+    }
+    return entry;
+};
+
+const fromHeader = (songId: string, bytes: ArrayBuffer): LocalQualityEntry | null => {
+    const probe = probeContainer(bytes);
+    if (!probe) return null;
+    return {
+        songId,
+        codec: probe.codec,
+        sampleRate: probe.sampleRate,
+        bitDepth: probe.bitDepth,
+        lossless: probe.lossless,
+        // 有損容器沒什麼好驗的；無損才需要後面的量測。
+        verdict: probe.lossless ? null : 'lossy',
+    };
+};
+
+/** 讀檔頭（便宜）；已量過就直接回快取。回 null 代表檔案讀不到或容器不認得。 */
+export const readLocalQuality = async (song: LocalSong): Promise<LocalQualityEntry | null> => {
+    const cached = memory.get(song.id);
+    if (cached) return cached;
+    if (failed.has(song.id)) return null;
+    const inFlight = pending.get(song.id);
+    if (inFlight) return inFlight;
+
+    const task = (async () => {
+        try {
+            const persisted = await readCacheEntry<LocalQualityEntry>(`${CACHE_PREFIX}${song.id}`);
+            if (persisted) {
+                memory.set(song.id, persisted);
+                return persisted;
+            }
+            const first = await getLocalSongHeaderBytes(song, HEADER_BYTES);
+            let entry = first ? fromHeader(song.id, first) : null;
+            if (!entry) {
+                // 再一次、讀大一點：m4a 的 moov 常超過 64 KB，少數 MP3 前面還壓著巨大的封面。
+                const wide = await getLocalSongHeaderBytes(song, LARGE_HEADER_FILE.test(song.fileName) ? HEADER_BYTES_LARGE : 512 * 1024);
+                if (wide) entry = fromHeader(song.id, wide);
+            }
+            if (!entry && LARGE_HEADER_FILE.test(song.fileName)) {
+                // 沒有 faststart 的 m4a 把 moov 放在檔尾：讀尾巴再試一次。
+                const fileSize = Math.max(0, song.fileSize || 0);
+                if (fileSize > HEADER_BYTES) {
+                    const tail = await getLocalSongRangeBytes(song, Math.max(0, fileSize - HEADER_BYTES_LARGE), HEADER_BYTES_LARGE);
+                    const probe = tail ? probeContainerFromTail(tail) : null;
+                    if (probe) {
+                        entry = {
+                            songId: song.id,
+                            codec: probe.codec,
+                            sampleRate: probe.sampleRate,
+                            bitDepth: probe.bitDepth,
+                            lossless: probe.lossless,
+                            verdict: probe.lossless ? null : 'lossy',
+                        };
+                    }
+                }
+            }
+            if (!entry) {
+                failed.add(song.id);
+                return null;
+            }
+            return await store(entry);
+        } catch (error) {
+            console.warn('[LocalQuality] Failed to read header quality:', error);
+            failed.add(song.id);
+            return null;
+        } finally {
+            pending.delete(song.id);
+        }
+    })();
+
+    pending.set(song.id, task);
+    return task;
+};
+
+/**
+ * 量真假無損：讀中段（或檔頭）一小段解 20 秒，量截止點。只有無損容器會被呼叫（有損已經在檔頭段就定案），
+ * 一次只跑一首，同時解好幾首會把手機記憶體打爆。
+ */
+export const measureLocalQuality = async (song: LocalSong): Promise<LocalQualityEntry | null> => {
+    const base = await readLocalQuality(song);
+    if (!base || !base.lossless) return base;
+    if (base.verdict) return base;
+
+    const fileSize = Math.max(0, song.fileSize || 0);
+    // 可自我同步的容器取中段；其餘（FLAC/WAV/DSD）必須連檔頭一起讀。
+    const startAt = MID_SLICE_CODECS.has(base.codec) && fileSize > MEASURE_SLICE_BYTES * 2
+        ? Math.floor(fileSize * 0.45)
+        : 0;
+
+    let result: QualityInspectResult | null = null;
+    try {
+        const slice = await getLocalSongRangeBytes(song, startAt, MEASURE_SLICE_BYTES);
+        if (slice && slice.byteLength > 0) {
+            const known: ContainerProbe = {
+                codec: base.codec,
+                sampleRate: base.sampleRate,
+                bitDepth: base.bitDepth,
+                channels: 2,
+                lossless: base.lossless,
+                durationSec: null,
+            };
+            result = await inspectAudioBytes(slice, song.fileName, known);
+        }
+        // 切片解不開（moov 在檔尾、APE 之類），退回整首讀。這條是慢路徑，但只有少數檔案會走到。
+        if (!result || !result.ok) {
+            const bytes = await getLocalSongArrayBuffer(song);
+            if (bytes) result = await inspectAudioBytes(bytes, song.fileName);
+        }
+    } catch (error) {
+        console.warn('[LocalQuality] Failed to measure quality:', song.fileName, error);
+        return base;
+    }
+    if (!result) return base;
+
+    const fake = result.verdicts.some(verdict => verdict.kind === 'fakeLossless' || verdict.kind === 'upsampled');
+    const narrowed = result.verdicts.some(verdict => verdict.kind === 'narrowBand');
+    // 光譜量到的上限明顯低於容器自稱的頻寬，就是「這份無損被有損轉過」的鐵證：
+    // 128 kbps 的 MP3 上限大約 16.5 kHz，裝進 48 kHz 的 FLAC 就是 24 kHz 裡只到 16.5 kHz。
+    // 判準取 0.8 × Nyquist 且差 3000 Hz 以上：真的 48 kHz 母帶內容通常到 20 kHz 以上，不會誤傷。
+    const measured = result.measured;
+    const narrowByBand = Boolean(
+        measured?.cutoffHz && measured.nyquistHz
+        && measured.cutoffHz <= measured.nyquistHz * 0.8
+        && measured.nyquistHz - measured.cutoffHz >= 3000
+    );
+    const verdict: QualityVerdictLabel = result.ok
+        ? (fake || narrowed || narrowByBand ? 'fakeLossless' : 'trueLossless')
+        : 'unknown';
+    return await store({ ...base, verdict });
+};
+
+/** 把 Hz 縮成列表上看得懂的短字：44100 → 44.1k，48000 → 48k。 */
+export const formatQualityRate = (hz: number): string => {
+    if (!hz) return '';
+    const k = hz / 1000;
+    return `${Number.isInteger(k) ? k.toFixed(0) : k.toFixed(1)}k`;
+};
+
+/** songId → LocalSong（列表只有 id，量測要整首 LocalSong）。 */
+export const resolveLocalSong = async (songId: string): Promise<LocalSong | undefined> => getLocalSong(songId);
diff --git a/src/services/audioQuality/losslessReport.ts b/src/services/audioQuality/losslessReport.ts
new file mode 100644
index 0000000..ca3f4ef
--- /dev/null
+++ b/src/services/audioQuality/losslessReport.ts
@@ -0,0 +1,200 @@
+// src/services/audioQuality/losslessReport.ts
+// 讀 PC 端產生的 lossless-report.json（v0.9.17）。
+//
+// 為什麼要外部報告：App 只有 WKWebView / WebView，塞不進 ffmpeg（APK 會胖 20 MB、授權會傳染、TAK 還是解不了）。
+// 所以做法是「PC 端用完整 ffmpeg／sox 慢慢算，App 只當顯示器」：
+//   1. PC 上用「無損體檢.py」對音樂資料夾跑一次，輸出 lossless-report.json；
+//   2. 把 JSON 丟到車機的音樂資料夾（或 Download）；
+//   3. 面板自動在幾個常見路徑找它，也可以手動貼路徑。
+// 報告裡的判定優先級高於 App 自己的輕量初篩，因為它真的解碼量過頻譜。
+
+import type { LocalSong } from '../../types';
+import { fetchNativeRange, isLinkedStorageSupported } from '../nativeLinkedStorage';
+
+export type ReportVerdict = 'trueLossless' | 'fakeLossless' | 'suspect' | 'unknown';
+
+export interface LosslessReportEntry {
+    name: string;
+    path?: string;
+    size?: number;
+    codec?: string;
+    sampleRate?: number;
+    bitDepth?: number;
+    durationSec?: number;
+    ratio?: number | null;
+    cutoffHz?: number | null;
+    nyquistHz?: number | null;
+    transitionHz?: number | null;
+    encoder?: string | null;
+    verdict: ReportVerdict;
+    notes?: string[];
+}
+
+export interface LosslessReport {
+    version?: number;
+    generatedAt?: string;
+    tool?: string;
+    entries: LosslessReportEntry[];
+}
+
+const REPORT_PATH_KEY = 'folia.losslessReportPath:v1';
+
+/** 面板會自動試的常見位置（Android 外部儲存）。 */
+export const DEFAULT_REPORT_PATHS = [
+    '/storage/emulated/0/Music/lossless-report.json',
+    '/storage/emulated/0/Download/lossless-report.json',
+    '/storage/emulated/0/Documents/lossless-report.json',
+    '/storage/emulated/0/lossless-report.json',
+    '/sdcard/lossless-report.json',
+];
+
+const VERDICTS: ReportVerdict[] = ['trueLossless', 'fakeLossless', 'suspect', 'unknown'];
+
+const normalizeVerdict = (value: unknown): ReportVerdict => (
+    typeof value === 'string' && (VERDICTS as string[]).includes(value)
+        ? value as ReportVerdict
+        : 'unknown'
+);
+
+const baseName = (value: string): string => {
+    const parts = value.split(/[\\/]/);
+    return (parts[parts.length - 1] ?? value).toLowerCase();
+};
+
+let index = new Map<string, LosslessReportEntry>();
+let indexed: LosslessReport | null = null;
+
+export const parseLosslessReport = (text: string): LosslessReport | null => {
+    let raw: unknown;
+    try {
+        raw = JSON.parse(text);
+    } catch {
+        return null;
+    }
+    if (!raw || typeof raw !== 'object') return null;
+    const record = raw as Record<string, unknown>;
+    const list = Array.isArray(record.entries) ? record.entries : Array.isArray(record.files) ? record.files : null;
+    if (!list) return null;
+    const entries: LosslessReportEntry[] = [];
+    for (const item of list) {
+        if (!item || typeof item !== 'object') continue;
+        const entry = item as Record<string, unknown>;
+        const name = typeof entry.name === 'string' ? entry.name : typeof entry.path === 'string' ? entry.path : '';
+        if (!name) continue;
+        entries.push({
+            name,
+            path: typeof entry.path === 'string' ? entry.path : undefined,
+            size: typeof entry.size === 'number' ? entry.size : undefined,
+            codec: typeof entry.codec === 'string' ? entry.codec : undefined,
+            sampleRate: typeof entry.sampleRate === 'number' ? entry.sampleRate : undefined,
+            bitDepth: typeof entry.bitDepth === 'number' ? entry.bitDepth : undefined,
+            durationSec: typeof entry.durationSec === 'number' ? entry.durationSec : undefined,
+            ratio: typeof entry.ratio === 'number' ? entry.ratio : null,
+            cutoffHz: typeof entry.cutoffHz === 'number' ? entry.cutoffHz : null,
+            nyquistHz: typeof entry.nyquistHz === 'number' ? entry.nyquistHz : null,
+            transitionHz: typeof entry.transitionHz === 'number' ? entry.transitionHz : null,
+            encoder: typeof entry.encoder === 'string' ? entry.encoder : null,
+            verdict: normalizeVerdict(entry.verdict),
+            notes: Array.isArray(entry.notes) ? entry.notes.filter(note => typeof note === 'string') as string[] : [],
+        });
+    }
+    return {
+        version: typeof record.version === 'number' ? record.version : undefined,
+        generatedAt: typeof record.generatedAt === 'string' ? record.generatedAt : undefined,
+        tool: typeof record.tool === 'string' ? record.tool : undefined,
+        entries,
+    };
+};
+
+/** 報告索引：以檔名（不分大小寫）配對，同名多筆時用檔案大小再挑一次。 */
+export const indexLosslessReport = (report: LosslessReport | null): void => {
+    indexed = report;
+    index = new Map();
+    if (!report) return;
+    for (const entry of report.entries) {
+        const key = baseName(entry.name);
+        const group = index.get(key);
+        if (!group) index.set(key, entry);
+        else if (group.size && entry.size === group.size) index.set(key, entry);
+    }
+};
+
+export const getIndexedReport = (): LosslessReport | null => indexed;
+export const getReportEntryCount = (): number => indexed?.entries.length ?? 0;
+
+export const findReportEntry = (song: LocalSong): LosslessReportEntry | undefined => {
+    const key = baseName(song.fileName);
+    const hit = index.get(key);
+    if (!hit) return undefined;
+    // 同名不同大小（不同版本、不同轉檔）視為沒配到，寧可空著也不要錯標。
+    if (hit.size && song.fileSize && Math.abs(hit.size - song.fileSize) > 1024) return undefined;
+    return hit;
+};
+
+export const savedReportPath = (): string => {
+    try {
+        return localStorage.getItem(REPORT_PATH_KEY) ?? '';
+    } catch {
+        return '';
+    }
+};
+
+export const rememberReportPath = (path: string): void => {
+    try {
+        if (path) localStorage.setItem(REPORT_PATH_KEY, path);
+        else localStorage.removeItem(REPORT_PATH_KEY);
+    } catch {
+        // 無痕模式寫不進去，不影響本次載入。
+    }
+};
+
+export interface LoadReportResult {
+    report?: LosslessReport;
+    path?: string;
+    error?: string;
+}
+
+const readTextAtPath = async (path: string): Promise<string | null> => {
+    if (!isLinkedStorageSupported()) return null;
+    // 報告通常幾百 KB；上限開到 8 MB，超大的話只讀前 8 MB 也能配對。
+    const bytes = await fetchNativeRange(path, 8 * 1024 * 1024, 0);
+    if (!bytes || bytes.byteLength === 0) return null;
+    return new TextDecoder('utf-8').decode(bytes);
+};
+
+/** 依序試幾個常見路徑；找到第一份能解析的就停。 */
+export const autoLoadLosslessReport = async (): Promise<LoadReportResult> => {
+    const remembered = savedReportPath();
+    const candidates = [remembered, ...DEFAULT_REPORT_PATHS].filter(Boolean);
+    for (const path of candidates) {
+        try {
+            const text = await readTextAtPath(path);
+            if (!text) continue;
+            const report = parseLosslessReport(text);
+            if (!report) continue;
+            indexLosslessReport(report);
+            rememberReportPath(path);
+            return { report, path };
+        } catch (error) {
+            console.warn('[LosslessReport] read failed:', path, error);
+        }
+    }
+    return { error: '沒找到 lossless-report.json（可用下面的路徑欄位手動指定）' };
+};
+
+export const loadLosslessReportAt = async (path: string): Promise<LoadReportResult> => {
+    const trimmed = path.trim();
+    if (!trimmed) return { error: '請先填報告路徑' };
+    if (!isLinkedStorageSupported()) return { error: '目前不是車機／Android 連結模式，讀不到外部檔案' };
+    try {
+        const text = await readTextAtPath(trimmed);
+        if (!text) return { error: '讀不到這個檔案（路徑錯、權限不足或檔案是空的）' };
+        const report = parseLosslessReport(text);
+        if (!report) return { error: '這個檔案不是可解析的 lossless-report.json' };
+        indexLosslessReport(report);
+        rememberReportPath(trimmed);
+        return { report, path: trimmed };
+    } catch (error) {
+        return { error: `讀取失敗：${error instanceof Error ? error.message : String(error)}` };
+    }
+};
