+// src/components/modal/settings/pages/QualityPage.tsx
+// 音樂 → 音質體檢：驗你手上的「無損」是不是真的。
+//
+// 放在「音樂」這一組而不是桌面專屬的「音源」頁，因為這件事在 iPhone 上一樣要做 ——
+// 它只吃本機檔案，不需要主行程，也不需要任何音源連線。
+
+import React from 'react';
+import { useTranslation } from 'react-i18next';
+import QualityCheckSection from '../../../audioQuality/QualityCheckSection';
+import { Group, option, type SettingsGroupDef, type SettingsOptionDef } from '../kit';
+
+const CHECK: SettingsGroupDef = { id: 'qualityCheck', titleKey: 'qualityCheck.title' };
+
+const O = {
+    pick: option(CHECK, 'qualityCheckPick', 'qualityCheck.pickFiles'),
+    scan: option(CHECK, 'qualityCheckScan', 'qualityCheck.scanLibrary'),
+};
+
+export const OPTIONS: SettingsOptionDef[] = Object.values(O);
+
+const QualityPage: React.FC = () => {
+    const { t } = useTranslation();
+    return (
+        <Group def={CHECK} foot={t('qualityCheck.foot')}>
+            <QualityCheckSection pickOption={O.pick} scanOption={O.scan} />
+        </Group>
+    );
+};
+
+export default QualityPage;
