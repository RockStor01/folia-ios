--- /dev/null
+++ b/src/services/audioQuality/localQualityIndex.ts
@@ -0,0 +1,204 @@
+// src/services/audioQuality/localQualityIndex.ts
+// 曲庫列表上的「音質」欄：採樣率／位深幾乎不用算（讀前 64 KB 的檔頭就有），真假無損才要解碼量頻譜。
+// 所以這裡分兩段：
+//   1. 檔頭段：`probeContainer` 讀容器自稱的規格。有損編碼直接標「有損」，到此為止。
+//   2. 量測段：只有無損容器才值得驗——讀中段一小段（預設 12 MB）解 20 秒、量截止點，判斷有沒有被撐大。
+//      切片解不開（moov 在檔尾之類）才回頭整首讀，這是慢路徑。
+// 結果寫進 metadata_cache（key 帶版本號），同一個檔案第二次開清單就不再解碼。
+// v0.9.6：快取前綴升到 v2（舊版留下的 unknown 判決一律重判），並把「讀不到」也記在記憶體裡，
+// 免得每滾一次清單就把同一個壞檔重試一次。
+
+import type { LocalSong } from '../../types';
+import { getLocalSongHeaderBytes, getLocalSongRangeBytes, getLocalSongArrayBuffer } from '../localMusicService';
+import { getLocalSong } from '../db';
+import { putCacheEntry, readCacheEntry } from '../repositories/cacheRepository';
+import { probeContainer, probeContainerFromTail, type ContainerProbe } from './qualityProbe';
+import { inspectAudioBytes, type QualityInspectResult } from './inspectAudioQuality';
+
+/** 量測結論。`unknown` 是解不開／取樣率超出 WebKit 上限，介面上顯示成「待檢」而不是判它假。 */
+export type QualityVerdictLabel = 'trueLossless' | 'fakeLossless' | 'unknown' | 'lossy';
+
+export interface LocalQualityEntry {
+    songId: string;
+    codec: string;
+    sampleRate: number;
+    bitDepth: number;
+    /** 容器本身是否無損（flac / wav / aiff / alac / dsd）。 */
+    lossless: boolean;
+    /** 量測結論；null = 還沒量（無損容器要解碼才算），有損編碼一律 `lossy`。 */
+    verdict: QualityVerdictLabel | null;
+}
+
+/** 舊版（v1）判過 `unknown` 的結果會永遠卡著，換前綴讓它們重判一次。 */
+const CACHE_PREFIX = 'local_quality_v2:';
+/** 記憶體快取：清單滾動時同一首會被反覆問，別每次都打 IndexedDB。 */
+const memory = new Map<string, LocalQualityEntry>();
+/** 讀不到檔頭的歌（權限掉了、檔案搬走了）：只在這次執行內記住，下次開啟再試一次。 */
+const failed = new Set<string>();
+const pending = new Map<string, Promise<LocalQualityEntry | null>>();
+
+/**
+ * 檔頭視窗：一般容器 64 KB 就夠；m4a 的 moov 可能很大（封面、章節都放在裡面），讀 2 MB 再試一次。
+ * 讀檔頭很便宜（本機是 slice，連結模式是一次 Range 請求），值得多讀。
+ */
+const HEADER_BYTES = 64 * 1024;
+const HEADER_BYTES_LARGE = 2 * 1024 * 1024;
+const LARGE_HEADER_FILE = /\.(m4a|m4b|mp4|aac|mov)$/i;
+/** 量測切片：12 MB 在 1411 kbps 的 FLAC 上約 85 秒，已遠超 20 秒的分析窗。 */
+const MEASURE_SLICE_BYTES = 12 * 1024 * 1024;
+/**
+ * 這些容器可以從中段開始切：MP3 與 Ogg 的框本身能自我同步，MP4 的 moov 在檔頭（faststart）時也行。
+ * FLAC / WAV / AIFF / DSD 的檔頭（STREAMINFO、fmt、COMM）必須在資料前面，只能從 0 開始切。
+ */
+const MID_SLICE_CODECS = new Set(['mp3', 'ogg', 'vorbis', 'opus', 'aac', 'mp4', 'm4a']);
+
+export const getCachedQuality = (songId: string): LocalQualityEntry | undefined => memory.get(songId);
+
+const store = async (entry: LocalQualityEntry): Promise<LocalQualityEntry> => {
+    memory.set(entry.songId, entry);
+    try {
+        await putCacheEntry(`${CACHE_PREFIX}${entry.songId}`, entry);
+    } catch (error) {
+        console.warn('[LocalQuality] Failed to cache quality entry:', error);
+    }
+    return entry;
+};
+
+const fromHeader = (songId: string, bytes: ArrayBuffer): LocalQualityEntry | null => {
+    const probe = probeContainer(bytes);
+    if (!probe) return null;
+    return {
+        songId,
+        codec: probe.codec,
+        sampleRate: probe.sampleRate,
+        bitDepth: probe.bitDepth,
+        lossless: probe.lossless,
+        // 有損容器沒什麼好驗的；無損才需要後面的量測。
+        verdict: probe.lossless ? null : 'lossy',
+    };
+};
+
+/** 讀檔頭（便宜）；已量過就直接回快取。回 null 代表檔案讀不到或容器不認得。 */
+export const readLocalQuality = async (song: LocalSong): Promise<LocalQualityEntry | null> => {
+    const cached = memory.get(song.id);
+    if (cached) return cached;
+    if (failed.has(song.id)) return null;
+    const inFlight = pending.get(song.id);
+    if (inFlight) return inFlight;
+
+    const task = (async () => {
+        try {
+            const persisted = await readCacheEntry<LocalQualityEntry>(`${CACHE_PREFIX}${song.id}`);
+            if (persisted) {
+                memory.set(song.id, persisted);
+                return persisted;
+            }
+            const first = await getLocalSongHeaderBytes(song, HEADER_BYTES);
+            let entry = first ? fromHeader(song.id, first) : null;
+            if (!entry) {
+                // 再一次、讀大一點：m4a 的 moov 常超過 64 KB，少數 MP3 前面還壓著巨大的封面。
+                const wide = await getLocalSongHeaderBytes(song, LARGE_HEADER_FILE.test(song.fileName) ? HEADER_BYTES_LARGE : 512 * 1024);
+                if (wide) entry = fromHeader(song.id, wide);
+            }
+            if (!entry && LARGE_HEADER_FILE.test(song.fileName)) {
+                // 沒有 faststart 的 m4a 把 moov 放在檔尾：讀尾巴再試一次。
+                const fileSize = Math.max(0, song.fileSize || 0);
+                if (fileSize > HEADER_BYTES) {
+                    const tail = await getLocalSongRangeBytes(song, Math.max(0, fileSize - HEADER_BYTES_LARGE), HEADER_BYTES_LARGE);
+                    const probe = tail ? probeContainerFromTail(tail) : null;
+                    if (probe) {
+                        entry = {
+                            songId: song.id,
+                            codec: probe.codec,
+                            sampleRate: probe.sampleRate,
+                            bitDepth: probe.bitDepth,
+                            lossless: probe.lossless,
+                            verdict: probe.lossless ? null : 'lossy',
+                        };
+                    }
+                }
+            }
+            if (!entry) {
+                failed.add(song.id);
+                return null;
+            }
+            return await store(entry);
+        } catch (error) {
+            console.warn('[LocalQuality] Failed to read header quality:', error);
+            failed.add(song.id);
+            return null;
+        } finally {
+            pending.delete(song.id);
+        }
+    })();
+
+    pending.set(song.id, task);
+    return task;
+};
+
+/**
+ * 量真假無損：讀中段（或檔頭）一小段解 20 秒，量截止點。只有無損容器會被呼叫（有損已經在檔頭段就定案），
+ * 一次只跑一首，同時解好幾首會把手機記憶體打爆。
+ */
+export const measureLocalQuality = async (song: LocalSong): Promise<LocalQualityEntry | null> => {
+    const base = await readLocalQuality(song);
+    if (!base || !base.lossless) return base;
+    if (base.verdict) return base;
+
+    const fileSize = Math.max(0, song.fileSize || 0);
+    // 可自我同步的容器取中段；其餘（FLAC/WAV/DSD）必須連檔頭一起讀。
+    const startAt = MID_SLICE_CODECS.has(base.codec) && fileSize > MEASURE_SLICE_BYTES * 2
+        ? Math.floor(fileSize * 0.45)
+        : 0;
+
+    let result: QualityInspectResult | null = null;
+    try {
+        const slice = await getLocalSongRangeBytes(song, startAt, MEASURE_SLICE_BYTES);
+        if (slice && slice.byteLength > 0) {
+            const known: ContainerProbe = {
+                codec: base.codec,
+                sampleRate: base.sampleRate,
+                bitDepth: base.bitDepth,
+                channels: 2,
+                lossless: base.lossless,
+                durationSec: null,
+            };
+            result = await inspectAudioBytes(slice, song.fileName, known);
+        }
+        // 切片解不開（moov 在檔尾、APE 之類），退回整首讀。這條是慢路徑，但只有少數檔案會走到。
+        if (!result || !result.ok) {
+            const bytes = await getLocalSongArrayBuffer(song);
+            if (bytes) result = await inspectAudioBytes(bytes, song.fileName);
+        }
+    } catch (error) {
+        console.warn('[LocalQuality] Failed to measure quality:', song.fileName, error);
+        return base;
+    }
+    if (!result) return base;
+
+    const fake = result.verdicts.some(verdict => verdict.kind === 'fakeLossless' || verdict.kind === 'upsampled');
+    const narrowed = result.verdicts.some(verdict => verdict.kind === 'narrowBand');
+    // 光譜量到的上限明顯低於容器自稱的頻寬，就是「這份無損被有損轉過」的鐵證：
+    // 128 kbps 的 MP3 上限大約 16.5 kHz，裝進 48 kHz 的 FLAC 就是 24 kHz 裡只到 16.5 kHz。
+    // 判準取 0.8 × Nyquist 且差 3000 Hz 以上：真的 48 kHz 母帶內容通常到 20 kHz 以上，不會誤傷。
+    const measured = result.measured;
+    const narrowByBand = Boolean(
+        measured?.cutoffHz && measured.nyquistHz
+        && measured.cutoffHz <= measured.nyquistHz * 0.8
+        && measured.nyquistHz - measured.cutoffHz >= 3000
+    );
+    const verdict: QualityVerdictLabel = result.ok
+        ? (fake || narrowed || narrowByBand ? 'fakeLossless' : 'trueLossless')
+        : 'unknown';
+    return await store({ ...base, verdict });
+};
+
+/** 把 Hz 縮成列表上看得懂的短字：44100 → 44.1k，48000 → 48k。 */
+export const formatQualityRate = (hz: number): string => {
+    if (!hz) return '';
+    const k = hz / 1000;
+    return `${Number.isInteger(k) ? k.toFixed(0) : k.toFixed(1)}k`;
+};
+
+/** songId → LocalSong（列表只有 id，量測要整首 LocalSong）。 */
+export const resolveLocalSong = async (songId: string): Promise<LocalSong | undefined> => getLocalSong(songId);
