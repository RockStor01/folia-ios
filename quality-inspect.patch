new file mode 100644
index 0000000..7412b5d
--- /dev/null
+++ b/src/utils/deviceDecodeSupport.ts
@@ -0,0 +1,37 @@
+// src/utils/deviceDecodeSupport.ts
+// 哪些容器「這台裝置」根本沒有解碼器（v0.9.18）。
+//
+// WebView 的 <audio> 只認 Chromium 內建的 FLAC／WAV／MP3／AAC／Ogg。
+// ALAC、APE、WavPack、TAK、TTA、DSD 這幾種要靠原生 MediaCodec 兜底轉 WAV，
+// 但 Android 的 MediaExtractor 連容器都認不得（DSD 更是 1-bit 串流，MediaCodec 沒有解碼器），
+// 有些 ROM 在 setDataSource／createDecoderByType 就直接在原生層 SIGSEGV——JS 抓不到 Throwable，
+// 使用者看到的就是「點播放 → Folia 閃退」。
+//
+// 所以這些格式在 JS 與原生兩邊都先擋掉，回一句看得懂的話，而不是把它丟進解碼器碰運氣。
+
+/** MediaExtractor／MediaCodec 都認不得、硬解會炸的容器。 */
+const UNSUPPORTED_ON_DEVICE = /\.(dsf|dff|ape|wv|tak|tta)$/i;
+
+/** 這種檔案在這台裝置上是不是根本解不開（只能先在 PC 轉成 FLAC／WAV）。 */
+export const isUnsupportedOnDevice = (fileName: string | null | undefined): boolean =>
+    Boolean(fileName && UNSUPPORTED_ON_DEVICE.test(fileName));
+
+/** 給使用者看的格式名：a.dsf → DSD。 */
+export const unsupportedFormatLabel = (fileName: string | null | undefined): string => {
+    const extension = (fileName ?? '').match(/\.([a-z0-9]+)$/i)?.[1]?.toLowerCase() ?? '';
+    switch (extension) {
+        case 'dsf':
+        case 'dff':
+            return 'DSD';
+        case 'ape':
+            return 'APE';
+        case 'wv':
+            return 'WavPack';
+        case 'tak':
+            return 'TAK';
+        case 'tta':
+            return 'TTA';
+        default:
+            return extension ? extension.toUpperCase() : '這個格式';
+    }
+};
