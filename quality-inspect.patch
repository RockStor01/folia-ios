@@ -0,0 +1,111 @@
+// src/hooks/useTrackQualityLabels.ts
+// 曲庫列表「音質」欄的資料來源：把列表上的本機歌 id 一批丟進去，逐首讀檔頭、必要時再量真假無損。
+// 只處理前 MAX_HEADER_ROWS 首（列表一次也看不完那麼多），量測更少（MAX_MEASURE_ROWS），
+// 免得一打開兩千首的曲庫就開始解碼兩千次。
+//
+// v0.9.6 的兩條加速：
+//   1. 檔頭段改成小併發（HEADER_CONCURRENCY）而不是一首一首排隊——本機是 slice + IndexedDB 讀，
+//      連結模式是一次 Range 請求，同時跑幾首才吃得到 I/O 頻寬。
+//   2. 量測段從「整首解碼」改成「讀中段 12 MB 解碼」（見 localQualityIndex），單首成本降一個數量級，
+//      因此可以同時跑 MEASURE_CONCURRENCY 首，並且把上限從 40 提到 80。
+
+import { useEffect, useRef, useState } from 'react';
+import type { LocalSong } from '../types';
+import {
+    measureLocalQuality,
+    readLocalQuality,
+    resolveLocalSong,
+    type LocalQualityEntry,
+} from '../services/audioQuality/localQualityIndex';
+
+/** 讀檔頭的行數上限（很便宜，但也不該一次排兩千個）。 */
+const MAX_HEADER_ROWS = 200;
+/** 真的解碼量光譜的行數上限：切片只有 12 MB、併發 2，量一首的成本已經遠低於整首解碼。 */
+const MAX_MEASURE_ROWS = 200;
+/** 讀檔頭同時跑幾個。車機是 eMMC／USB，4 條就夠吃滿；再多只是讓 WebView 的 microtask 更吵。 */
+const HEADER_CONCURRENCY = 4;
+/** 量測同時跑幾個：每個切片最多 12 MB 位元組 + 20 秒的音訊緩衝，8+128 的車機跑 2 個很安全。 */
+const MEASURE_CONCURRENCY = 2;
+
+export type TrackQualityRow = Pick<LocalQualityEntry, 'sampleRate' | 'bitDepth' | 'verdict'>;
+
+/** 小併發池：固定數量的 worker 依序吃掉 queue，結果照完成順序回報。 */
+const runPool = async <T>(
+    items: readonly T[],
+    concurrency: number,
+    worker: (item: T) => Promise<void>,
+    isCancelled: () => boolean,
+): Promise<void> => {
+    let cursor = 0;
+    const lanes = Array.from({ length: Math.max(1, Math.min(concurrency, items.length)) }, async () => {
+        while (cursor < items.length) {
+            if (isCancelled()) return;
+            const item = items[cursor];
+            cursor += 1;
+            await worker(item);
+        }
+    });
+    await Promise.all(lanes);
+};
+
+/**
+ * `entries` 是「行的鍵 → 本機歌 id」；沒有本機歌的行（在線歌）不放進來，介面顯示成空白。
+ * 回傳的 Map 只用行的鍵當 key，與列表的 entryKey 一致。
+ */
+export const useTrackQualityLabels = (
+    entries: ReadonlyArray<{ key: string; songId: string }>,
+): Map<string, TrackQualityRow> => {
+    const [rows, setRows] = useState<Map<string, TrackQualityRow>>(() => new Map());
+    const entriesRef = useRef(entries);
+    entriesRef.current = entries;
+    // 換清單（換頁／換集合）就從頭再跑：同一份曲庫靠 service 的記憶體與 metadata_cache 命中，成本很低。
+    const signature = entries.slice(0, MAX_HEADER_ROWS).map(entry => entry.songId).join('|');
+
+    useEffect(() => {
+        let cancelled = false;
+        const queue = entriesRef.current.slice(0, MAX_HEADER_ROWS);
+        if (queue.length === 0) {
+            setRows(new Map());
+            return () => { cancelled = true; };
+        }
+
+        const emit = (key: string, row: TrackQualityRow) => {
+            if (cancelled) return;
+            setRows(previous => {
+                const next = new Map(previous);
+                next.set(key, row);
+                return next;
+            });
+        };
+
+        void (async () => {
+            // 第一輪：只讀檔頭。有損編碼在這裡就定案，無損先掛「待量」。
+            const losslessQueue: Array<{ key: string; song: LocalSong }> = [];
+            await runPool(queue, HEADER_CONCURRENCY, async ({ key, songId }) => {
+                const song = await resolveLocalSong(songId);
+                if (!song) return;
+                const entry = await readLocalQuality(song);
+                if (!entry) {
+                    // 讀不到檔頭（檔案搬走、權限掉了、容器認不得）也要給一列，介面才不會留白。
+                    emit(key, { sampleRate: 0, bitDepth: 0, verdict: 'unknown' });
+                    return;
+                }
+                emit(key, { sampleRate: entry.sampleRate, bitDepth: entry.bitDepth, verdict: entry.verdict });
+                if (entry.lossless && !entry.verdict && losslessQueue.length < MAX_MEASURE_ROWS) {
+                    losslessQueue.push({ key, song });
+                }
+            }, () => cancelled);
+
+            // 第二輪：無損容器量光譜。切片小、併發 2，滾動時結果一列一列長出來。
+            await runPool(losslessQueue, MEASURE_CONCURRENCY, async ({ key, song }) => {
+                const entry = await measureLocalQuality(song);
+                if (!entry) return;
+                emit(key, { sampleRate: entry.sampleRate, bitDepth: entry.bitDepth, verdict: entry.verdict });
+            }, () => cancelled);
+        })();
+
+        return () => { cancelled = true; };
+    }, [signature]);
+
+    return rows;
+};
