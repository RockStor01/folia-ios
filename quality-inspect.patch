+/** CP1252 的 0x80–0x9F 被對到特殊字元；要還原成位元組得反查。 */
+const CP1252_HIGH: Record<string, number> = {
+    '\u20ac': 0x80, '\u201a': 0x82, '\u0192': 0x83, '\u201e': 0x84, '\u2026': 0x85, '\u2020': 0x86,
+    '\u2021': 0x87, '\u02c6': 0x88, '\u2030': 0x89, '\u0160': 0x8a, '\u2039': 0x8b, '\u0152': 0x8c,
+    '\u017d': 0x8e, '\u2018': 0x91, '\u2019': 0x92, '\u201c': 0x93, '\u201d': 0x94, '\u2022': 0x95,
+    '\u2013': 0x96, '\u2014': 0x97, '\u02dc': 0x98, '\u2122': 0x99, '\u0161': 0x9a, '\u203a': 0x9b,
+    '\u0153': 0x9c, '\u017e': 0x9e, '\u0178': 0x9f,
+};
+
+/** 字串 → 指定位元組；任何一個字對不回就整個放棄（真中文會在這裡被擋掉）。 */
+const encodeThrough = (text: string, label: 'gbk' | 'big5'): Uint8Array | null => {
+    const table = buildReverseTable(label);
+    const out: number[] = [];
+    for (const char of Array.from(text)) {
+        const code = char.codePointAt(0) ?? 0;
+        if (code < 0x80) { out.push(code); continue; }
+        if (code >= 0x80 && code <= 0x9f) { out.push(code); continue; }
+        const cp1252 = CP1252_HIGH[char];
+        if (cp1252 !== undefined) { out.push(cp1252); continue; }
+        if (code <= 0xff) { out.push(code); continue; }
+        const pair = table.get(char);
+        if (!pair) return null;
+        out.push(pair[0], pair[1]);
+    }
+    return Uint8Array.from(out);
+};
+
+/** 把「被 GBK／Big5 解過一次」的字串還原成原本的 UTF-8 文字。 */
+const tryRoundTrip = (text: string, label: 'gbk' | 'big5'): string | null => {
+    const bytes = encodeThrough(text, label);
+    if (!bytes) return null;
+    const decoded = decode('utf-8', bytes);
+    if (!decoded || decoded === text) return null;
+    if (decoded.split('\ufffd').length - 1 > 0) return null;
+    return acceptableCandidate(text, decoded) ? decoded : null;
+};
+
+
+/**
+ * 尾端有 �：UTF-8 位元組是奇數個，GBK 解完最後剩一個孤兒位元組（「周杰伦」→「鍛ㄦ澃浼�」）。
+ * 少的那個位元組只知道範圍（0x40–0xFE），把每個可能都補上再用 UTF-8 解，取「最像常用字」那個。
+ */
+const tryRoundTripLostTail = (text: string, label: 'gbk' | 'big5'): string | null => {
+    const stripped = text.replace(/\ufffd+$/u, '');
+    if (stripped === text) return null;
+    const head = encodeThrough(stripped, label);
+    if (!head) return null;
+    let best: string | null = null;
+    let bestScore = -Infinity;
+    let runnerUp = -Infinity;
+    for (let byte = 0x40; byte <= 0xfe; byte += 1) {
+        if (byte === 0x7f) continue;
+        const bytes = new Uint8Array(head.length + 1);
+        bytes.set(head, 0);
+        bytes[head.length] = byte;
+        const decoded = decode('utf-8', bytes);
+        if (!decoded || decoded.includes('\ufffd')) continue;
+        // 最後一個字是猜的：不是常用字就不列入（避免「周杰伍」這種）。
+        const last = Array.from(decoded).pop() ?? '';
+        if (!COMMON_CHARS.has(last)) continue;
+        const score = plausibility(decoded);
+        if (score > bestScore) { runnerUp = bestScore; bestScore = score; best = decoded; }
+        else if (score > runnerUp) runnerUp = score;
+    }
+    // 兩個候選分數太接近就代表猜不準（「林俊杰」會被猜成「林俊李」），寧可保留原字串。
+    if (!best || bestScore - runnerUp < 0.5) return null;
+    return acceptableCandidate(text, best) ? best : null;
+};
+
+/** 所有候選一起比：UTF-8 重解、ID3 專用 GBK 修法、GBK 重解、Big5 重解，以及反向的 GBK／Big5 → UTF-8 還原。 */
+const collectCandidates = (text: string): string[] => {
+    const out: string[] = [];
+    const utf8 = tryUtf8Reinterpretation(text);
+    if (utf8) out.push(utf8);
+    const bytes = latin1Bytes(text);
+    if (bytes) {
+        // 舊的 ID3 專用修法只看 0xA1–0xFE 的位元組對，對「整段都是 GBK」最可靠。
+        const legacy = repairLatin1DecodedGbkText(text);
+        if (legacy !== text) out.push(legacy);
+        const gbk = decodeCandidate('gbk', bytes, text);
+        if (gbk) out.push(gbk);
+        const big5 = decodeCandidate('big5', bytes, text);
+        if (big5) out.push(big5);
+    }
+    // 反向：字串本身是中文，但其實是 UTF-8 被 GBK／Big5 解過（「鍛ㄦ澃浼」←「周杰伦」）。
+    const lostGbk = tryRoundTripLostTail(text, 'gbk');
+    if (lostGbk) out.push(lostGbk);
+    const lostBig5 = tryRoundTripLostTail(text, 'big5');
+    if (lostBig5) out.push(lostBig5);
+    const roundGbk = tryRoundTrip(text, 'gbk');
+    if (roundGbk) out.push(roundGbk);
+    const roundBig5 = tryRoundTrip(text, 'big5');
+    if (roundBig5) out.push(roundBig5);
+    return Array.from(new Set(out)).filter(candidate => acceptableCandidate(text, candidate));
+};
+
+/**
+ * 修一個標籤字串。UTF-8 重解、ID3 專用 GBK 修法、GBK 重解、Big5 重解都當候選，
+ * 用「像人話」的分數挑最高的一個；分數沒有明顯變好就原樣返回。
+ * 正常文字（含英數、正常中日韓、重音符號）不會被動到。
+ */
+export const repairTagText = (input: string | null | undefined): string => {
+    if (!input) return input ?? '';
+    const text = input.trim();
+    if (!text) return text;
+    // 全 ASCII 就沒得修；純中文仍要進來，因為可能是「UTF-8 被 GBK 解」的罕用字。
+    if (!/[^\x00-\x7f]/u.test(text)) return text;
+    // 已經正常的中文就不必再猜：除了「幾乎都是中文」，還要「常用字夠多」才放行，
+    // 否則「澶滄洸」這種每個字都是罕用字的中文（其實是 UTF-8 被 GBK 解）會被誤判成正常。
+    if (!looksBroken(text) && cjkProfile(text).ratio >= 0.5 && commonScore(text) >= 0.5) return text;
+
+    const candidates = collectCandidates(text);
+    if (candidates.length === 0) return text;
+    let best = candidates[0];
+    for (const candidate of candidates) {
+        if (plausibility(candidate) > plausibility(best)) best = candidate;
+    }
+    return best;
+};
+
+/** 一次修一組（歌手清單）；空字串與 undefined 原樣保留。 */
+export const repairTagTextList = (input: readonly (string | null | undefined)[] | null | undefined): string[] => (
+    (input ?? []).map(item => repairTagText(item)).filter(item => item.length > 0)
+);
+
+type RepairableSongLike = {
+    title: string;
+    titleOrigin?: string;
+    fileName?: string;
+    importedMetadata?: { title: string; artistNames: string[]; albumName?: string; titleSource?: string };
+};
+
+/** 只修「還是匯入值」的欄位：使用者自己改過的歌名、配對到的線上資料都不動。 */
+export const repairLocalSongTagText = <T extends RepairableSongLike>(song: T): { song: T; changed: boolean } => {
+    let changed = false;
+    const pick = <K extends keyof T>(key: K, value: T[K], next: T[K]) => {
+        if (value === next) return value;
+        changed = true;
+        return next;
+    };
+
+    let nextTitle = song.title;
+    if (song.titleOrigin === 'import' || !song.titleOrigin) {
+        nextTitle = pick('title', song.title, repairTagText(song.title));
+    }
+
+    const originalMetadata = song.importedMetadata;
+    let importedMetadata = originalMetadata;
+    if (originalMetadata) {
+        const repairedTitle = repairTagText(originalMetadata.title);
+        const repairedArtists = repairTagTextList(originalMetadata.artistNames);
+        const repairedAlbum = repairTagText(originalMetadata.albumName);
+        const differs = repairedTitle !== originalMetadata.title
+            || repairedAlbum !== (originalMetadata.albumName ?? '')
+            || repairedArtists.length !== originalMetadata.artistNames.length
+            || repairedArtists.some((name, index) => name !== originalMetadata.artistNames[index]);
+        if (differs) {
+            importedMetadata = {
+                ...originalMetadata,
+                title: repairedTitle,
+                artistNames: repairedArtists,
+                albumName: repairedAlbum,
+            };
+            changed = true;
+        }
+    }
+
+    if (!changed) return { song, changed: false };
+    return {
+        song: { ...song, title: nextTitle, importedMetadata } as T,
+        changed: true,
+    };
+};
