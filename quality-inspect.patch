+import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { AlertTriangle, CheckCircle2, FileJson, Search, Sparkles, X } from 'lucide-react';
+import type { LocalSong } from '../../types';
+import { getLocalSongs, saveLocalSong } from '../../services/db';
+import { getCachedQuality, measureLocalQuality } from '../../services/audioQuality/localQualityIndex';
+import { analyzeLosslessSuspect, type LosslessSuspect } from '../../services/audioQuality/losslessSuspect';
+import {
+    autoLoadLosslessReport,
+    findReportEntry,
+    loadLosslessReportAt,
+    savedReportPath,
+    type LosslessReportEntry,
+} from '../../services/audioQuality/losslessReport';
+import { searchMusicBrainzRecordings, type MusicBrainzMatch } from '../../services/musicbrainzSearch';
+import { useLosslessSearchStore } from './useLosslessSearchStore';
+
+// src/components/lossless-search/LosslessSearchHost.tsx
+// 車機／手機上的「無損搜尋」面板：只在曲庫裡挑無損檔（不連網抓音檔），
+// 並且可以拿歌名＋歌手去 MusicBrainz 補回正確的歌名／歌手／專輯（只查文字資料）。
+// v0.9.17 加上「真無損校驗」：輕量初篩（檔頭＋壓縮比＋編碼器痕跡）、頻譜量測（解 20 秒量截止點），
+// 以及讀取 PC 端產生的 lossless-report.json。
+
+/** 副檔名就能肯定是無損的容器（m4a 可能是 AAC，所以只認 alac）。 */
+const LOSSLESS_EXTENSIONS = /\.(flac|wav|aiff?|alac|ape|wv|tta|tak|dsf|dff|caf)$/i;
+
+const isLossless = (song: LocalSong): boolean => {
+    const cached = getCachedQuality(song.id);
+    if (cached) return cached.lossless;
+    if (/\.(m4a|mp4)$/i.test(song.fileName)) return false;
+    return LOSSLESS_EXTENSIONS.test(song.fileName);
+};
+
+const qualityLabel = (song: LocalSong): string => {
+    const cached = getCachedQuality(song.id);
+    if (cached) {
+        const rate = cached.sampleRate ? `${(cached.sampleRate / 1000).toFixed(1)} kHz` : '';
+        const depth = cached.bitDepth ? `${cached.bitDepth} bit` : '';
+        return [cached.codec.toUpperCase(), rate, depth].filter(Boolean).join(' · ');
+    }
+    const extension = song.fileName.match(/\.([a-z0-9]+)$/i)?.[1]?.toUpperCase() ?? '';
+    return `${extension} · 無損`;
+};
+
+const artistText = (song: LocalSong): string => song.importedMetadata.artistNames.join(' / ');
+
+type BadgeTone = 'good' | 'bad' | 'warn' | 'muted';
+
+interface VerdictView {
+    label: string;
+    tone: BadgeTone;
+    detail?: string;
+    source: 'report' | 'spectrum' | 'local' | 'none';
+}
+
+const toneClass: Record<BadgeTone, string> = {
+    good: 'bg-emerald-500/15 text-emerald-300',
+    bad: 'bg-rose-500/15 text-rose-300',
+    warn: 'bg-amber-500/15 text-amber-300',
+    muted: 'bg-white/10 text-white/55',
+};
+
+/** 報告 > 頻譜量測 > 輕量初篩，三者只留最可信的一個。 */
+const verdictOf = (
+    song: LocalSong,
+    report: LosslessReportEntry | undefined,
+    localCheck: LosslessSuspect | 'loading' | undefined,
+): VerdictView => {
+    if (report) {
+        if (report.verdict === 'trueLossless') {
+            return {
+                label: '真無損',
+                tone: 'good',
+                detail: report.cutoffHz ? `內容到 ${(report.cutoffHz / 1000).toFixed(1)} kHz` : undefined,
+                source: 'report',
+            };
+        }
+        if (report.verdict === 'fakeLossless') {
+            return {
+                label: '假無損',
+                tone: 'bad',
+                detail: report.cutoffHz ? `內容只到 ${(report.cutoffHz / 1000).toFixed(1)} kHz` : undefined,
+                source: 'report',
+            };
+        }
+        if (report.verdict === 'suspect') {
+            return { label: '可疑', tone: 'warn', detail: report.notes?.[0], source: 'report' };
+        }
+        return { label: '報告：無法判斷', tone: 'muted', detail: report.notes?.[0], source: 'report' };
+    }
+
+    const cached = getCachedQuality(song.id);
+    if (cached?.verdict === 'trueLossless') return { label: '真無損（已量頻譜）', tone: 'good', source: 'spectrum' };
+    if (cached?.verdict === 'fakeLossless') return { label: '假無損（已量頻譜）', tone: 'bad', source: 'spectrum' };
+    if (cached?.verdict === 'unknown') return { label: '頻譜量不到', tone: 'muted', source: 'spectrum' };
+
+    if (localCheck === 'loading') return { label: '校驗中…', tone: 'muted', source: 'local' };
+    if (localCheck?.verdict === 'suspect') {
+        return { label: '疑似轉檔', tone: 'warn', detail: localCheck.reasons[0], source: 'local' };
+    }
+    if (localCheck?.verdict === 'clean') {
+        return {
+            label: '未見可疑',
+            tone: 'good',
+            detail: localCheck.ratio ? `壓縮比 ${(localCheck.ratio * 100).toFixed(0)}%` : undefined,
+            source: 'local',
+        };
+    }
+    if (localCheck?.verdict === 'unknown') return { label: '讀不到檔頭', tone: 'muted', source: 'local' };
+    return { label: '未校驗', tone: 'muted', source: 'none' };
+};
+
+const VerdictBadge: React.FC<{ view: VerdictView }> = ({ view }) => (
+    <span className={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] ${toneClass[view.tone]}`}>
+        {view.tone === 'bad' ? <AlertTriangle size={12} /> : view.tone === 'good' ? <CheckCircle2 size={12} /> : null}
+        {view.label}
+        {view.detail ? <span className="opacity-70">· {view.detail}</span> : null}
+    </span>
+);
+
+const LosslessSearchHost: React.FC = () => {
+    const isOpen = useLosslessSearchStore(state => state.isOpen);
+    const close = useLosslessSearchStore(state => state.close);
+    const [songs, setSongs] = useState<LocalSong[]>([]);
+    const [query, setQuery] = useState('');
+    const [matches, setMatches] = useState<Record<string, MusicBrainzMatch[] | 'loading' | 'empty'>>({});
+    const [checks, setChecks] = useState<Record<string, LosslessSuspect | 'loading'>>({});
+    const [measuring, setMeasuring] = useState<Record<string, 'loading' | 'failed'>>({});
+    const [tick, setTick] = useState(0);
+    const [onlySuspect, setOnlySuspect] = useState(false);
+    const [reportCount, setReportCount] = useState(0);
+    const [reportPath, setReportPath] = useState(() => savedReportPath());
+    const [reportMessage, setReportMessage] = useState('');
+    const [reportLoading, setReportLoading] = useState(false);
+    const [showReportBox, setShowReportBox] = useState(false);
+    const [batch, setBatch] = useState<{ done: number; total: number } | null>(null);
+    const batchCancelled = useRef(false);
+
+    useEffect(() => {
+        if (!isOpen) return;
+        let alive = true;
+        void getLocalSongs().then(list => { if (alive) setSongs(list); });
+        return () => { alive = false; };
+    }, [isOpen]);
+
+    // 開面板時自動在幾個常見路徑找報告；找不到不吵，工具列只顯示「沒有 PC 報告」。
+    useEffect(() => {
+        if (!isOpen) return;
+        let alive = true;
+        setReportLoading(true);
+        void autoLoadLosslessReport().then(result => {
+            if (!alive) return;
+            setReportLoading(false);
+            if (result.report) {
+                setReportCount(result.report.entries.length);
+                setReportPath(result.path ?? '');
+                setReportMessage(`已載入 ${result.report.entries.length} 筆`);
+                setTick(value => value + 1);
+            } else {
+                setReportCount(0);
+            }
+        });
+        return () => { alive = false; };
+    }, [isOpen]);
+
+    useEffect(() => {
+        if (!isOpen) return;
+        const onKeyDown = (event: KeyboardEvent) => {
+            if (event.key === 'Escape') close();
+        };
+        window.addEventListener('keydown', onKeyDown);
+        return () => window.removeEventListener('keydown', onKeyDown);
+    }, [isOpen, close]);
+
+    // 關面板就取消批次掃描，不要讓它在背景繼續吃 CPU。
+    useEffect(() => {
+        if (!isOpen) batchCancelled.current = true;
+    }, [isOpen]);
+
+    const losslessSongs = useMemo(() => songs.filter(isLossless), [songs]);
+
+    const results = useMemo(() => {
+        void tick; // 頻譜量測／報告載入完成後要重算徽章
+        const needle = query.trim().toLowerCase();
+        const base = needle
+            ? losslessSongs.filter(song => {
+                const haystack = [song.title, artistText(song), song.importedMetadata.albumName ?? '', song.fileName]
+                    .join('\n').toLowerCase();
+                return haystack.includes(needle);
+            })
+            : losslessSongs;
+        if (!onlySuspect) return base.slice(0, 200);
+        const filtered = base.filter(song => {
+            const entry = findReportEntry(song);
+            if (entry) return entry.verdict === 'fakeLossless' || entry.verdict === 'suspect';
+            const checked = checks[song.id];
+            if (checked && checked !== 'loading') return (checked as LosslessSuspect).verdict === 'suspect';
+            return getCachedQuality(song.id)?.verdict === 'fakeLossless';
+        });
+        return filtered.slice(0, 200);
+    }, [losslessSongs, query, onlySuspect, checks, tick]);
+
+    const lookup = useCallback(async (song: LocalSong) => {
+        setMatches(prev => ({ ...prev, [song.id]: 'loading' }));
+        const found = await searchMusicBrainzRecordings(song.title, artistText(song), 5);
+        setMatches(prev => ({ ...prev, [song.id]: found.length ? found : 'empty' }));
+    }, []);
+
+    const applyMatch = useCallback(async (song: LocalSong, match: MusicBrainzMatch) => {
+        const meta = {
+            ...song.importedMetadata,
+            title: match.title,
+            titleSource: 'embedded' as const,
+            artistNames: match.artist ? match.artist.split(' / ') : song.importedMetadata.artistNames,
+            albumName: match.album ?? song.importedMetadata.albumName,
+        };
+        const next: LocalSong = { ...song, title: match.title, importedMetadata: meta };
+        await saveLocalSong(next);
+        setSongs(prev => prev.map(item => (item.id === song.id ? next : item)));
+        setMatches(prev => ({ ...prev, [song.id]: [{ ...match }] }));
+    }, []);
+
+    const runLocalCheck = useCallback(async (song: LocalSong) => {
+        setChecks(prev => ({ ...prev, [song.id]: 'loading' }));
+        const result = await analyzeLosslessSuspect(song);
+        setChecks(prev => ({ ...prev, [song.id]: result }));
+    }, []);
+
+    const runMeasure = useCallback(async (song: LocalSong) => {
+        setMeasuring(prev => ({ ...prev, [song.id]: 'loading' }));
+        try {
+            const entry = await measureLocalQuality(song);
+            setMeasuring(prev => {
+                const next = { ...prev };
+                if (!entry || !entry.verdict) next[song.id] = 'failed';
+                else delete next[song.id];
+                return next;
+            });
+        } catch {
+            setMeasuring(prev => ({ ...prev, [song.id]: 'failed' }));
+        } finally {
+            setTick(value => value + 1);
+        }
+    }, []);
+
+    const runBatch = useCallback(async () => {
+        if (batch) {
+            batchCancelled.current = true;
+            return;
+        }
+        batchCancelled.current = false;
+        const targets = losslessSongs.slice(0, 500).filter(song => !checks[song.id] && !findReportEntry(song));
+        setBatch({ done: 0, total: targets.length });
+        let done = 0;
+        for (const song of targets) {
+            if (batchCancelled.current) break;
+            const result = await analyzeLosslessSuspect(song);
+            setChecks(prev => ({ ...prev, [song.id]: result }));
+            done += 1;
+            setBatch({ done, total: targets.length });
+            // 讓出主執行緒：車機的 WebView 若被這串迴圈霸佔，觸控會卡。
+            await new Promise(resolve => setTimeout(resolve, 0));
+        }
+        setBatch(null);
+    }, [batch, checks, losslessSongs]);
+
+    const applyReportPath = useCallback(async () => {
+        setReportLoading(true);
+        const result = await loadLosslessReportAt(reportPath);
+        setReportLoading(false);
+        if (result.report) {
+            setReportCount(result.report.entries.length);
+            setReportPath(result.path ?? reportPath);
+            setReportMessage(`已載入 ${result.report.entries.length} 筆`);
+            setTick(value => value + 1);
+        } else {
+            setReportMessage(result.error ?? '讀取失敗');
+        }
+    }, [reportPath]);
+
+    if (!isOpen) return null;
+
+    return (
+        <div className="fixed inset-0 z-[9000] flex items-center justify-center bg-black/55 backdrop-blur-sm p-3">
+            <div className="flex h-full max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#0b0b0e]/95 text-white shadow-2xl">
+                <div className="flex items-center gap-3 border-b border-white/10 px-5 py-3">
+                    <Search size={18} className="shrink-0 opacity-60" />
+                    <input
+                        autoFocus
+                        value={query}
+                        onChange={event => setQuery(event.target.value)}
+                        placeholder="在無損曲庫裡搜歌名、歌手、專輯或檔名"
+                        className="min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:opacity-45"
+                    />
+                    <span className="shrink-0 text-xs opacity-55">
+                        {results.length} / {losslessSongs.length} 首無損
+                    </span>
+                    <button type="button" onClick={close} className="shrink-0 rounded-full p-1.5 hover:bg-white/10" aria-label="關閉">
+                        <X size={18} />
+                    </button>
+                </div>
+
+                <div className="flex flex-wrap items-center gap-2 border-b border-white/10 px-5 py-2 text-xs">
+                    <button
+                        type="button"
+                        onClick={() => void runBatch()}
+                        className={`rounded-full border px-3 py-1.5 ${batch ? 'border-rose-400/40 text-rose-300' : 'border-white/15 hover:bg-white/10'}`}
+                    >
+                        {batch ? `停止（${batch.done}/${batch.total}）` : '全庫輕量校驗'}
+                    </button>
+                    <button
+                        type="button"
+                        onClick={() => setOnlySuspect(value => !value)}
+                        className={`rounded-full border px-3 py-1.5 ${onlySuspect ? 'border-amber-400/50 text-amber-300' : 'border-white/15 hover:bg-white/10'}`}
+                    >
+                        只看可疑
+                    </button>
+                    <button
+                        type="button"
+                        onClick={() => setShowReportBox(value => !value)}
+                        className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 ${reportCount ? 'bg-emerald-500/15 text-emerald-300' : 'bg-white/10 text-white/55'}`}
+                    >
+                        <FileJson size={12} />
+                        {reportLoading ? '讀報告中…' : reportCount ? `PC 報告 ${reportCount} 筆` : '沒有 PC 報告'}
+                    </button>
+                    <span className="opacity-45">輕量校驗＝讀檔頭＋壓縮比＋編碼器痕跡，不解碼也不判死</span>
+                </div>
+
+                {showReportBox && (
+                    <div className="border-b border-white/10 bg-white/[0.03] px-5 py-3 text-xs">
+                        <div className="mb-2 opacity-60">
+                            把 PC 上跑「無損體檢.py」產生的 lossless-report.json 放到車機（Music／Download 底下會自動找到），
+                            或直接填完整路徑。
+                        </div>
+                        <div className="flex items-center gap-2">
+                            <input
+                                value={reportPath}
+                                onChange={event => setReportPath(event.target.value)}
+                                placeholder="/storage/emulated/0/Music/lossless-report.json"
+                                className="min-w-0 flex-1 rounded-xl border border-white/15 bg-black/30 px-3 py-2 outline-none placeholder:opacity-35"
+                            />
+                            <button
+                                type="button"
+                                onClick={() => void applyReportPath()}
+                                className="shrink-0 rounded-xl border border-white/15 px-3 py-2 hover:bg-white/10"
+                            >
+                                讀取
+                            </button>
+                        </div>
+                        {reportMessage && <div className="mt-2 opacity-60">{reportMessage}</div>}
+                    </div>
+                )}
+
+                <div className="min-h-0 flex-1 overflow-y-auto">
+                    {results.length === 0 && (
+                        <div className="p-8 text-center text-sm opacity-60">
+                            {losslessSongs.length === 0
+                                ? '曲庫裡還沒有無損檔（FLAC／WAV／ALAC／APE 等）'
+                                : onlySuspect ? '沒有被判為可疑的檔案' : '沒有符合的無損歌曲'}
+                        </div>
+                    )}
+                    {results.map(song => {
+                        const match = matches[song.id];
+                        const report = findReportEntry(song);
+                        const checked = checks[song.id];
+                        const view = verdictOf(song, report, checked);
+                        const measuringState = measuring[song.id];
+                        return (
+                            <div key={song.id} className="border-b border-white/5 px-5 py-3">
+                                <div className="flex items-start gap-3">
+                                    <div className="min-w-0 flex-1">
+                                        <div className="truncate text-[15px] font-medium">{song.title}</div>
+                                        <div className="truncate text-xs opacity-60">
+                                            {artistText(song) || '未知歌手'}
+                                            {song.importedMetadata.albumName ? ` · ${song.importedMetadata.albumName}` : ''}
+                                        </div>
+                                        <div className="mt-1.5 flex flex-wrap items-center gap-1.5">
+                                            <span className="inline-flex items-center rounded-full bg-white/10 px-2 py-0.5 text-[11px]">
+                                                {qualityLabel(song)}
+                                            </span>
+                                            <VerdictBadge view={view} />
+                                        </div>
+                                    </div>
+                                    <div className="flex shrink-0 flex-wrap items-center justify-end gap-1.5">
+                                        <button
+                                            type="button"
+                                            onClick={() => void runLocalCheck(song)}
+                                            className="rounded-full border border-white/15 px-3 py-1.5 text-xs hover:bg-white/10"
+                                        >
+                                            {checked === 'loading' ? '校驗中…' : '校驗'}
+                                        </button>
+                                        <button
+                                            type="button"
+                                            onClick={() => void runMeasure(song)}
+                                            className="rounded-full border border-white/15 px-3 py-1.5 text-xs hover:bg-white/10"
+                                        >
+                                            {measuringState === 'loading' ? '量測中…' : measuringState === 'failed' ? '量不到' : '量頻譜'}
+                                        </button>
+                                        <button
+                                            type="button"
+                                            onClick={() => void lookup(song)}
+                                            className="rounded-full border border-white/15 px-3 py-1.5 text-xs hover:bg-white/10"
+                                        >
+                                            {match === 'loading' ? '查詢中…' : '線上配對標籤'}
+                                        </button>
+                                    </div>
+                                </div>
+
+                                {checked && checked !== 'loading' && (checked.reasons.length > 0 || checked.notes.length > 0) && (
+                                    <div className="mt-2 rounded-2xl bg-white/5 p-2 text-[11px] leading-relaxed">
+                                        {checked.reasons.map(reason => (
+                                            <div key={reason} className="text-amber-300/90">・{reason}</div>
+                                        ))}
+                                        {checked.notes.map(note => (
+                                            <div key={note} className="opacity-55">・{note}</div>
+                                        ))}
+                                    </div>
+                                )}
+
+                                {report && (report.notes?.length || report.cutoffHz) && (
+                                    <div className="mt-2 text-[11px] opacity-60">
+                                        PC 報告：
+                                        {report.cutoffHz ? `內容到 ${(report.cutoffHz / 1000).toFixed(1)} kHz` : '無頻譜資料'}
+                                        {report.nyquistHz ? `（Nyquist ${(report.nyquistHz / 1000).toFixed(1)} kHz）` : ''}
+                                        {report.notes?.length ? ` · ${report.notes.join('；')}` : ''}
+                                    </div>
+                                )}
+
+                                {Array.isArray(match) && (
+                                    <div className="mt-2 space-y-1.5 rounded-2xl bg-white/5 p-2">
+                                        {match.map(candidate => (
+                                            <button
+                                                key={candidate.recordingId}
+                                                type="button"
+                                                onClick={() => void applyMatch(song, candidate)}
+                                                className="flex w-full items-start gap-2 rounded-xl px-2 py-1.5 text-left text-xs hover:bg-white/10"
+                                            >
+                                                <Sparkles size={13} className="mt-0.5 shrink-0 text-amber-300" />
+                                                <span className="min-w-0">
+                                                    <span className="block truncate text-[13px]">{candidate.title}</span>
+                                                    <span className="block truncate opacity-60">
+                                                        {[candidate.artist, candidate.album, candidate.year].filter(Boolean).join(' · ')}
+                                                    </span>
+                                                </span>
+                                                <span className="ml-auto shrink-0 text-[11px] opacity-45">套用</span>
+                                            </button>
+                                        ))}
+                                    </div>
+                                )}
+                                {match === 'empty' && (
+                                    <div className="mt-2 text-xs opacity-50">MusicBrainz 沒有符合的結果（或目前沒網路）</div>
+                                )}
+                            </div>
+                        );
+                    })}
+                </div>
+
+                <div className="border-t border-white/10 px-5 py-2 text-[11px] opacity-45">
+                    只搜尋本機曲庫裡的無損檔；校驗只讀檔頭與壓縮比、「量頻譜」只解 20 秒在裝置上算，
+                    「線上配對標籤」只查 MusicBrainz 的文字資料。全程不下載任何音檔。
+                </div>
+            </div>
+        </div>
+    );
+};
+
+export default LosslessSearchHost;
