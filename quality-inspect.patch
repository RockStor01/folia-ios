+  --folia-safe-right: env(safe-area-inset-right, 0px);
+}
+
+@media (hover: none) {
+  /* group-hover 的產物在沒有 hover 的裝置上直接顯示，不再等一個永遠不會來的指針。 */
+  .group .group-hover\:opacity-100 { opacity: 1; }
+  .group .group-hover\:w-auto { width: auto; }
+  .group .group-hover\:translate-x-0 { translate: 0 0; transform: none; }
+  .group .group-hover\:max-w-28 { max-width: 7rem; }
+  .group .group-hover\:ml-1\.5 { margin-left: 0.375rem; }
+}
