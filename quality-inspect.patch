+++ b/test/unit/tagPlaceholder.test.ts
@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest';
+import { fileNameToTitle, hasLostChars, planTagPatch } from '@/services/localSongRawTags';
+import type { LocalSong } from '@/types';
+
+// test/unit/tagPlaceholder.test.ts
+// v0.9.18：有些機型把解不開的標籤位元組換成 '?'（而不是 �）。這裡驗「怎麼算壞掉」與「壞掉後補什麼」。
+
+type SongOverrides = Partial<Omit<LocalSong, 'importedMetadata'>> & { importedMetadata?: Partial<LocalSong['importedMetadata']> };
+
+const song = (overrides: SongOverrides = {}): LocalSong => {
+    const base: LocalSong = {
+        id: 'x',
+        fileName: '01 - 晴天.flac',
+        filePath: 'x',
+        duration: 0,
+        fileSize: 100,
+        mimeType: 'audio/flac',
+        addedAt: 0,
+        title: '晴天',
+        titleOrigin: 'import',
+        importedMetadata: { title: '晴天', titleSource: 'embedded', artistNames: ['周杰倫'], albumName: '范特西' },
+    } as LocalSong;
+    return {
+        ...base,
+        ...overrides,
+        importedMetadata: { ...base.importedMetadata, ...(overrides.importedMetadata ?? {}) },
+    } as LocalSong;
+};
+
+describe('hasLostChars', () => {
+    it('正常中文與單一問號不算壞', () => {
+        expect(hasLostChars('晴天')).toBe(false);
+        expect(hasLostChars('你最近好嗎?')).toBe(false);
+        expect(hasLostChars('真的??')).toBe(false);
+        expect(hasLostChars('周?倫')).toBe(false);
+        expect(hasLostChars('')).toBe(false);
+        expect(hasLostChars(undefined)).toBe(false);
+    });
+
+    it('問號型亂碼算壞', () => {
+        expect(hasLostChars('?')).toBe(true);
+        expect(hasLostChars('???')).toBe(true);
+        expect(hasLostChars('周杰倫 - ????')).toBe(true);
+        expect(hasLostChars('周?杰?倫')).toBe(true);
+        expect(hasLostChars('??晴天')).toBe(true);
+    });
+
+    it('U+FFFD 仍然算壞', () => {
+        expect(hasLostChars('晴\uFFFD天')).toBe(true);
+    });
+});
+
+describe('fileNameToTitle', () => {
+    it('去掉副檔名、曲目編號與底線', () => {
+        expect(fileNameToTitle('01 - 晴天.flac')).toBe('晴天');
+        expect(fileNameToTitle('12.夜曲.flac')).toBe('夜曲');
+        expect(fileNameToTitle('[03] 東風破.flac')).toBe('東風破');
+        expect(fileNameToTitle('周杰倫_-_晴天.flac')).toBe('周杰倫 - 晴天');
+    });
+
+    it('檔名本身也壞掉時回空字串', () => {
+        expect(fileNameToTitle('????.flac')).toBe('');
+    });
+});
+
+describe('planTagPatch', () => {
+    it('原始標籤可用就用標籤', () => {
+        const target = song({ title: '????', importedMetadata: { title: '????' } });
+        const fixed = planTagPatch(target, { title: '晴天', artist: '周杰倫' });
+        expect(fixed?.title).toBe('晴天');
+        expect(fixed?.importedMetadata.title).toBe('晴天');
+        expect(fixed?.importedMetadata.artistNames).toEqual(['周杰倫']);
+    });
+
+    it('原始標籤也是壞的，退到檔名', () => {
+        const target = song({ title: '????', importedMetadata: { title: '????' } });
+        const fixed = planTagPatch(target, { title: '???', artist: '???' });
+        expect(fixed?.title).toBe('晴天');
+        expect(fixed?.importedMetadata.titleSource).toBe('filename');
+        expect(fixed?.importedMetadata.artistNames).toEqual(['周杰倫']);
+    });
+
+    it('沒壞就不動', () => {
+        expect(planTagPatch(song(), { title: '晴天' })).toBeNull();
+    });
+});
