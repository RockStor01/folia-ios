+    const candidates = collectCandidates(text);
+    if (candidates.length === 0) return text;
+    let best = candidates[0];
+    for (const candidate of candidates) {
+        if (plausibility(candidate) > plausibility(best)) best = candidate;
+    }
+    return best;
+};
+
+/** 一次修一組（歌手清單）；空字串與 undefined 原樣保留。 */
+export const repairTagTextList = (input: readonly (string | null | undefined)[] | null | undefined): string[] => (
+    (input ?? []).map(item => repairTagText(item)).filter(item => item.length > 0)
+);
+
+type RepairableSongLike = {
+    title: string;
+    titleOrigin?: string;
+    fileName?: string;
+    importedMetadata?: { title: string; artistNames: string[]; albumName?: string; titleSource?: string };
+};
+
+/** 只修「還是匯入值」的欄位：使用者自己改過的歌名、配對到的線上資料都不動。 */
+export const repairLocalSongTagText = <T extends RepairableSongLike>(song: T): { song: T; changed: boolean } => {
+    let changed = false;
+    const pick = <K extends keyof T>(key: K, value: T[K], next: T[K]) => {
+        if (value === next) return value;
+        changed = true;
+        return next;
+    };
+
+    let nextTitle = song.title;
+    if (song.titleOrigin === 'import' || !song.titleOrigin) {
+        nextTitle = pick('title', song.title, repairTagText(song.title));
+    }
+
+    const originalMetadata = song.importedMetadata;
+    let importedMetadata = originalMetadata;
+    if (originalMetadata) {
+        const repairedTitle = repairTagText(originalMetadata.title);
+        const repairedArtists = repairTagTextList(originalMetadata.artistNames);
+        const repairedAlbum = repairTagText(originalMetadata.albumName);
+        const differs = repairedTitle !== originalMetadata.title
+            || repairedAlbum !== (originalMetadata.albumName ?? '')
+            || repairedArtists.length !== originalMetadata.artistNames.length
+            || repairedArtists.some((name, index) => name !== originalMetadata.artistNames[index]);
+        if (differs) {
+            importedMetadata = {
+                ...originalMetadata,
+                title: repairedTitle,
+                artistNames: repairedArtists,
+                albumName: repairedAlbum,
+            };
+            changed = true;
+        }
+    }
+
+    if (!changed) return { song, changed: false };
+    return {
+        song: { ...song, title: nextTitle, importedMetadata } as T,
+        changed: true,
+    };
+};
