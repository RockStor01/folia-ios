+ * showDirectoryPicker 缺失）就不给「导入文件夹」，因为没有它反而会点出一声报错。
+ */
+export const localWallHint = (
+    options: {
+        canImportFolder: boolean;
+        canPickFiles: boolean;
+        onImportFolder?: () => void;
+        onPickFiles?: () => void;
+        importing?: boolean;
+        /** 匯入進度。有就顯示「第幾／共幾首」，因為一次匯入上千首時轉圈圈看起來像卡死。 */
+        progress?: { done: number; total: number; eta?: string | null } | null;
+    },
+    t: TFunction,
+): BravaisWallHint => {
+    const { canImportFolder, canPickFiles, onImportFolder, onPickFiles, importing = false, progress = null } = options;
+    const actions: { label: string; onClick: () => void; primary?: boolean }[] = [];
+
+    if (canPickFiles && onPickFiles) {
+        actions.push({
+            label: importing
+                ? (progress ? t(progress.eta ? 'localMusic.importingProgressEta' : 'localMusic.importingProgress', { done: progress.done, total: progress.total, eta: progress.eta ?? '' }) : t('localMusic.importingFiles'))
+                : t('localMusic.importFiles'),
+            onClick: onPickFiles,
+            primary: true,
+        });
+    }
+    if (canImportFolder && onImportFolder) {
+        actions.push({ label: t('localMusic.importFolder'), onClick: onImportFolder });
+    }
+
+    return {
+        title: t('libraryBravaisHome.wallHint.localTitle'),
+        // 只有导入文件夹时照旧指向缝里那个动作；只能导入文件时说明改指向这台装置实际能做的那件事。
+        body: canImportFolder
+            ? t('libraryBravaisHome.wallHint.localBody', { action: t('localMusic.importFolder') })
+            : t('libraryBravaisHome.wallHint.localBodyFilesOnly'),
+        actions: actions.length > 0 ? actions : undefined,
+    };
+};
 
