+/** 依副檔名挑解析器；認不得就回 null（不是錯誤，只是沒有內嵌歌詞）。 */
+export const extractEmbeddedLyrics = (bytes: Uint8Array, fileName: string): string | null => {
+    const lower = fileName.toLowerCase();
+    try {
+        if (lower.endsWith('.mp3') || bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) {
+            return extractId3Uslt(bytes);
+        }
+        if (lower.endsWith('.flac') || (bytes[0] === 0x66 && bytes[1] === 0x4C && bytes[2] === 0x61 && bytes[3] === 0x43)) {
+            return extractFlacLyrics(bytes);
+        }
+        if (lower.endsWith('.m4a') || lower.endsWith('.mp4') || lower.endsWith('.alac')) {
+            return extractM4aLyrics(bytes);
+        }
+    } catch (error) {
+        console.warn('[FileLyrics] embedded parse failed', error);
+    }
+    return null;
+};
+
+const dirOf = (path: string): string => {
+    const slash = Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\'));
+    return slash >= 0 ? path.slice(0, slash) : path;
+};
+
+const stripExtension = (name: string): string => name.replace(/\.([a-z0-9]{1,6})$/i, '');
+
+const baseNameOf = (filePath: string): string => {
+    const slash = Math.max(filePath.lastIndexOf('/'), filePath.lastIndexOf('\\'));
+    return filePath.slice(slash + 1);
+};
+
+/** 同資料夾歌詞檔的比對順序：track.lrc > track.mp3.lrc > track.vtt，大小寫不分。 */
+const pickSidecar = (
+    directory: string,
+    audioName: string,
+): { name: string; path: string; format?: 'vtt' } | null => {
+    const entries = listNativeLyrics(directory);
+    if (entries.length === 0) return null;
+    const base = stripExtension(audioName).toLowerCase();
+    for (const extension of LYRIC_PREFERENCE) {
+        const candidates = [
+            `${base}.${extension}`,
+            `${audioName.toLowerCase()}.${extension}`,
+        ];
+        for (const candidate of candidates) {
+            const hit = entries.find(entry => entry.name.toLowerCase() === candidate);
+            if (hit) return { name: hit.name, path: hit.path, format: extension === 'vtt' ? 'vtt' : undefined };
+        }
+    }
+    return null;
+};
+
+const fetchText = async (url: string): Promise<Uint8Array | null> => {
+    try {
+        const response = await fetch(url);
+        if (!response.ok) return null;
+        return new Uint8Array(await response.arrayBuffer());
+    } catch (error) {
+        console.warn('[FileLyrics] fetch failed', error);
+        return null;
+    }
+};
+
+/** 讀一首連結歌曲的歌詞：先找旁邊的檔案，再試音檔內嵌。 */
+export const readLinkedSongLyrics = async (song: LocalSong): Promise<FileLyricsPayload | null> => {
+    if (!isLinkedStorageSupported() || !song.linkedFilePath) return null;
+    const path = song.linkedFilePath;
+    const audioName = song.fileName || baseNameOf(path);
+
+    const sidecar = pickSidecar(dirOf(path), audioName);
+    if (sidecar) {
+        const url = nativeAudioUrl(sidecar.path);
+        if (url) {
+            const bytes = await fetchText(url);
+            if (bytes) {
+                const content = decodeLyricBytes(bytes).trim();
+                if (content) {
+                    return {
+                        localLyrics: { content, format: sidecar.format },
+                        origin: `sidecar:${sidecar.name}`,
+                    };
+                }
+            }
+        }
+    }
+
+    // 內嵌歌詞在檔案前段（ID3 標籤總在最前面），讀 2 MB 就夠，不必整首拉進來。
+    const head = await fetchNativeRange(path, Math.min(Math.max(song.fileSize || 0, 64 * 1024), 2 * 1024 * 1024), 0);
+    if (!head) return null;
+    const embedded = extractEmbeddedLyrics(new Uint8Array(head), audioName);
+    if (embedded) {
+        return { embeddedLyrics: embedded, origin: 'embedded' };
+    }
+    return null;
+};
+
+/**
+ * 把讀到的歌詞寫回這首歌並通知曲庫刷新；已經有歌詞（或已匹配線上歌詞）就直接回 null。
+ * 只給連結模式的歌用：其他歌本來就在匯入時解析過。
+ */
+export const ensureLinkedSongLyrics = async (song: LocalSong): Promise<LocalSong | null> => {
+    if (!song.linkedFilePath) return null;
+    const hasLyrics = Boolean(
+        (song.hasLocalLyrics && song.localLyricsContent)
+        || (song.hasEmbeddedLyrics && song.embeddedLyricsContent)
+        || song.matchedLyrics
+        || song.markedPureMusic,
+    );
+    if (hasLyrics) return null;
+
+    const payload = await readLinkedSongLyrics(song);
+    if (!payload) return null;
+
+    const updated: LocalSong = payload.localLyrics
+        ? {
+            ...song,
+            hasLocalLyrics: true,
+            localLyricsContent: payload.localLyrics.content,
+            localLyricsFormat: payload.localLyrics.format,
+            localLyricsOrigin: 'sidecar',
+        }
+        : {
+            ...song,
+            hasEmbeddedLyrics: true,
+            embeddedLyricsContent: payload.embeddedLyrics,
+        };
+
+    try {
+        await putLocalSong(updated);
+        window.dispatchEvent(new CustomEvent(LOCAL_MUSIC_UPDATED_EVENT));
+    } catch (error) {
+        console.warn('[FileLyrics] save failed', error);
+        return null;
+    }
+    console.info(`[FileLyrics] hydrated ${song.fileName} from ${payload.origin}`);
+    return updated;
+};
