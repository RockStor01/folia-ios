   "releaseNotes": {
+    "v0_9_21": {
+      "intro": "0.9.21 is two things: DSD files still cannot be decoded on the head unit (the system has no DSD decoder at all), so playback now falls back to a same-named FLAC; and the question-mark titles that were left half-repaired last time - the cause was that each repair batch only ever took the first 25 songs, so later songs never got a turn.",
+      "dsdSubstitute": {
+        "title": "DSD plays a same-named FLAC instead",
+        "description": "The head unit's decoder list has no DSD (1-bit) support, and an app cannot work around that. When a .dsf / .dff fails to play, the app now looks for a .flac with the same name in the same folder (then in the library by folder plus name) and plays it: title, lyrics and cover still come from the original entry, only the audio comes from the other file. If neither exists it reports \u201ccannot decode on this device\u201d. A PC script, DSD轉FLAC.py, converts DSD to FLAC in place, so nothing has to be configured on the head unit.",
+      },
+      "tagRepair": {
+        "title": "All question-mark titles repaired in one pass",
+        "description": "The previous repair only ever handled the first 25 songs: every batch took items from the front of the queue, songs that could not be fixed kept their slot forever, and later songs never got a turn; tags that could not be read were skipped outright, so the filename fallback never ran. Now one launch scans the whole library (20 songs per batch, yielding between batches), failures are remembered so they are not retried, and unreadable tags still fall back to the filename. A new row in Settings, \u201cRepair now\u201d, rescans the whole library on demand.",
+      },
+      "fixes": {
+        "substitute": "Same-named FLAC lookups are cached for 60 seconds and the library list for 10, so playback does not rescan storage every time.",
+        "queue": "Question-mark repair scans the whole library once; failed songs are remembered and stop taking up slots.",
+        "filename": "Unreadable tags no longer skip the song; the filename is used for the title.",
+        "manual": "Settings \u2192 Storage \u2192 Repair now rescans every bad title in the library.",
+      }
+    },
+    "v0_9_20": {
+      "intro": "0.9.20 makes lyric matching quicker: the sources at the head of the order are asked together instead of one after another, the same words are not searched twice, and the QQ AMLL lookup no longer tries its two ids in sequence.",
+      "fastLyricMatch": {
+        "title": "Lyric matching without the queue",
+        "description": "Matching used to be strictly one source at a time: search, wait, fetch, wait, then the next. A source that answered slowly cost every source after it its own wait. This build starts the first few sources' searches and fetches at the same time, then still decides in the original priority order, so which source wins does not change: whichever answers first no longer sets the pace. The chorus ranges one source lends another are still applied, even when both were fetched together. It is a switch (Lyric settings → Probe lyric sources together) and it is on by default; the cost is a few more requests per match, and turning it off restores the old one-by-one order.",
+      },
+      "fixes": {
+        "parallel": "The first three sources are searched and fetched at once; the winner is still chosen by priority, in order.",
+        "cache": "A match found for the same title, artist and length is reused for 15 minutes; a “nothing found” result for 3, so a song without lyrics is not re-searched on every play.",
+        "dedupe": "The prefetch and the playback that follows it now share one run instead of starting two.",
+        "amll": "The QQ AMLL lookup asks its mid and numeric id at the same time, and the AMLL search is kept for a minute (one album's songs cost one search).",
+      }
+    },
+    "v0_9_19": {
+      "intro": "0.9.19 fixes “album art disappeared”: local covers used to be served entirely by the PWA service worker from OPFS at /__folia_cover/, so when the head unit's WebView never registers the worker every cover 404s. The page now reads OPFS itself and falls back to blob: URLs.",
+      "coverFallback": {
+        "title": "Covers no longer depend on the service worker",
+        "description": "Local covers live in OPFS. They used to be served through the service worker; with no worker (old WebView, failed precache update, right after an update) every request 404s and lists, player and playlists go blank. This build catches the failed image, reads the bytes from OPFS directly and swaps in a blob: URL — one read per cover, at most 120 cached. When the worker works, this path never runs.",
+      },
+      "fixes": {
+        "blob": "Failed covers retry through an OPFS→blob: URL instead of the service worker.",
+        "sw": "Cover 404s caused by a missing or stale service worker are absorbed by the fallback.",
+        "retry": "One read per cover even when several lists ask at once; a blob URL is never attached to another song's image.",
+      }
+    },
+    "v0_9_18": {
+      "intro": "0.9.18 fixes titles turning into question marks: on some head units the media probe doesn't emit U+FFFD but plain '?'. The bytes are equally gone, so the app re-reads the raw tag bytes from the file and only falls back to the file name as a last resort.",
+      "tagPlaceholder": {
+        "title": "Handling titles that became ?",
+        "description": "Detection is stricter but safer: only an all-question-mark string, three or more consecutive '?', two or more '?' between CJK characters, or a string that is mostly '?' counts as lost. A single question mark (“Are you ok?”) is not touched. When the native probe returns question marks during import, the raw ID3/Vorbis/MP4 bytes are read immediately; if the tags themselves were written as '?', the file name (minus track number and extension) becomes the title. Songs already imported are repaired in the background, 25 per launch.",
+      },
+      "undecodable": {
+        "title": "DSD / APE no longer crash the app",
+        "description": "The head unit's MediaExtractor does not recognise dsf/dff/ape/wv/tak/tta, and on some ROMs it fails inside the native layer where JS cannot catch it — the symptom is tapping a song and Folia closing itself. This build blocks it in three places: resolving the playback source returns a plain “no decoder for this format” message, the native transcode entry rejects the format without ever touching MediaExtractor, and the playback-failure fallback no longer retries transcoding. The trade-off is honest: these formats simply will not play on the head unit — convert them to FLAC on a PC first.",
+      },
+      "fixes": {
+        "dsd": "DSD/APE/TAK containers now show a message and skip instead of going into the decoder.",
+        "question": "Question-mark corruption is now detected, not just U+FFFD.",
+        "filename": "Falls back to a title derived from the file name, marked titleSource=filename.",
+        "backfill": "Background repair now covers imported songs as well as linked ones.",
+      }
+    },
+    "v0_9_17": {
+      "intro": "0.9.17 adds a real-lossless check inside the lossless search panel: a fast header-level screening, an on-device spectrum measurement, and loading a lossless-report.json produced on a PC.",
+      "losslessCheck": {
+        "title": "Check whether your lossless files are really lossless",
+        "description": "Every row gets a badge: true lossless / fake lossless / suspected transcode / unchecked. The lightweight check reads only a few hundred KB from the head and tail — tens of milliseconds per file — so “check whole library” can sweep everything. It never condemns a file: it only lists evidence such as an impossibly low compression ratio, leftover LAME/FFmpeg encoder strings, an empty FLAC audio MD5, or a WAV whose data chunk is actually MP3 frames. For a firmer answer press “Measure spectrum”: decode 20 seconds and measure where the content really ends — a 128 kbps MP3 wrapped in FLAC gets flagged. A lossless-report.json generated by the PC script is auto-loaded from Music/Download and overrides the in-app screening.",
+      },
+      "fixes": {
+        "local": "Lightweight check: header, compression ratio, encoder strings, empty FLAC MD5, MP3 bitstream inside WAV — reads a few hundred KB only.",
+        "spectrum": "Each song can be measured on its own; the result goes into the quality cache and the library quality column updates.",
+        "report": "Reads the PC lossless-report.json: auto-detected in Music/Download/Documents or typed manually, matched by file name plus size.",
+        "batch": "“Check whole library” sweeps up to 500 songs and can be stopped anytime; “only suspicious” filters them out.",
+      }
+    },
+    "v0_9_16": {
+      "intro": "0.9.16 adds a lossless search panel: open it from the command palette by typing “lossless”, it lists only lossless files already in your library, and can fill in correct title/artist/album from MusicBrainz.",
+      "losslessSearch": {
+        "title": "Search lossless songs and fix tags online",
+        "description": "The panel reads the library only — it never downloads audio. Lossless is decided from the container and the cached quality entry (flac/wav/aiff/alac/ape/wv/tta/tak/dsf/dff); each row shows codec, sample rate and bit depth. “Match tags online” asks MusicBrainz for recordings by title + artist and lists five candidates; tapping one writes the tags back.",
+      },
+      "fixes": {
+        "panel": "Type “lossless” in the command palette; search by title, artist, album or file name.",
+        "mb": "MusicBrainz matching is text-only and never downloads audio; applying writes to the library immediately.",
+        "offline": "With no network it just reports no matches; search and playback keep working.",
+      }
+    },
+    "v0_9_15": {
+      "intro": "0.9.15 extends raw tag parsing to every lossless container: RIFF INFO and ID3 chunks in wav/aiff, APEv2 in ape/wv/tak, ID3v2 inside tta/dsf/dff, plus the existing flac and alac.",
+      "lossless": {
+        "title": "Tag reading for all lossless formats",
+        "description": "Beyond MP3/FLAC/ALAC: WAV reads LIST/INFO INAM/IART/IPRD or an embedded id3 chunk; AIFF/AIFC reads its ID3 chunk; APE/WV/TAK read the APEv2 footer; TTA/DSF/DFF are scanned for embedded ID3v2. APEv2 and DSF tags sit at the end of the file, so when the head has nothing the last 512 KB is read too. Scanning now accepts .tak/.mp4/.mka.",
+      },
+      "fixes": {
+        "ape": "APEv2 Title/Artist/Album from APE, WavPack and TAK files.",
+        "riff": "RIFF INFO and id3 chunks in WAV, ID3 chunk in AIFF.",
+        "scan": "Scanning and MIME now cover .tak/.mp4/.mka.",
+      }
+    },
+    "v0_9_14": {
+      "intro": "0.9.14 stops repairing strings after the fact: titles, artists and albums are read from the file's raw tag bytes and decoded with the encoding the tag itself declares, so � garbage never reaches the library.",
+      "rawTags": {
+        "title": "Fix mojibake at the source: parse raw tag bytes",
+        "description": "The system metadata reader guesses a charset; when it guesses wrong the bytes are dropped into � and no later repair can bring them back. This release parses ID3v2 TIT2/TPE1/TALB (Latin-1, UTF-16, UTF-16BE, UTF-8), FLAC VORBIS_COMMENT and MP4 ilst ©nam/©ART/©alb itself. Tags that claim Latin-1 but hold GBK bytes are retried as GB18030/Big5. Existing library entries with � are re-read from the file in background batches of 25 on startup.",
+      },
+      "fixes": {
+        "bytes": "Raw tag parsing for MP3, FLAC and M4A instead of trusting the system decoder.",
+        "intro": "Import replaces � titles/artists/albums by re-reading the raw tags on the spot.",
+        "backfill": "Old entries heal in background after startup; no re-import needed.",
+      }
+    },
+    "v0_9_13": {
+      "intro": "0.9.13 takes another pass at mojibake: titles that already look like Chinese but were decoded wrong (“鍛ㄦ澃浼” for 周杰伦, “澶滄洸” for 夜曲) are mapped back to GBK/Big5 bytes and re-decoded as UTF-8.",
+      "mozjibake": {
+        "title": "Second family of mojibake: Chinese-looking text decoded from UTF-8",
+        "description": "The old repair only re-decoded text as GBK. This release adds the reverse path: each character is looked up in the GBK/Big5 table to recover the original bytes, then decoded as UTF-8. Chinese strings made of rare characters are no longer waved through as normal text. When the trailing byte is missing the guess is skipped rather than forced.",
+      },
+      "fixes": {
+        "roundtrip": "New reverse pass: GBK/Big5 bytes → UTF-8 for titles like 鍛ㄦ澃浼 or 澶滄洸.",
+        "gate": "Chinese text with too few common characters is no longer treated as clean.",
+        "safe": "No guess, no change: normal Chinese and accented Latin (Björk) stay untouched.",
+      }
+    },
+    "v0_9_12": {
+      "intro": "0.9.12 clears desktop-only system settings out of the phone UI: the head unit and iOS no longer show switches that only mean something in the Windows/Linux/macOS desktop app.",
+      "desktopCleanup": {
+        "title": "No more desktop settings on the head unit or iOS",
+        "description": "Some switches only ever did anything in the desktop app (window titlebar buttons, player header blur, audio output device, update check and channel, open the player window on launch, voice-input pause, global shortcuts, OBS/Discord integration, GPU preference, background throttling). On Android and iOS they either did nothing or did nothing when tapped. This build removes those rows and the pages behind them from the phone UI; the desktop program itself (Electron, the mpv/HiFi engine) is removed in a later build.",
+      },
+      "fixes": {
+        "window": "Removed the window titlebar and player header blur switches.",
+        "output": "Removed the audio output device picker: phones play to the system output.",
+        "update": "Removed the whole update check / auto update / channel group; phone updates are install packages.",
+        "shortcuts": "Removed global shortcuts and OBS/Discord desktop integration rows; steering-wheel keys and the rest of settings are untouched.",
+        "keep": "Playback, lyrics, quality, the head-unit performance profile, UI scale and Ponder hints stay exactly as they were."
+      }
+    },
+    "v0_9_11": {
+      "intro": "0.9.11 fixes \"tap play and it pauses, every time\": the native layer used to pause whenever another app took audio focus, and now ignores focus by default and drops the fake pause a head unit echoes back.",
+      "playPauseFix": {
+        "title": "The play button no longer turns itself into pause",
+        "description": "Two causes. Head-unit radio and DSP services grab audio focus over and over, and 0.9.8 paused on every focus loss so navigation could take over — so each tap on play was followed by a pause. The other is that some units echo the session's PAUSED right after we report playback started, stopping us with our own state. This build ignores focus changes by default and swallows session pause echoes for 900 ms after playback starts; to still yield to navigation, turn on Settings → Playback → Playback behavior → Pause when another app takes audio focus.",
+      },
+      "fixes": {
+        "focus": "No longer pauses when audio focus is taken, unless the setting is on.",
+        "echo": "A session PAUSED/STOP within 900 ms of starting playback is treated as an echo and ignored.",
+        "toggle": "Settings → Playback → Playback behavior → Pause when another app takes audio focus (Android build only, off by default).",
+        "log": "Diagnostics now include mediaLog: the last 40 focus changes, key presses and dropped echoes."
+      }
+    },
+    "v0_9_10": {
+      "intro": "Starting with 0.9.10, Android updates install over the old app. It used to be impossible because every CI run generated a fresh debug keystore, and a changed signature makes Android refuse the update.",
+      "seamlessUpdate": {
+        "title": "Updates no longer need uninstalling",
+        "description": "The debug and release APKs are now both signed with one fixed key that lives in the repository, and versionCode rises with every build (1000 + CI run number). On the same device any build installs over the previous one: no more INSTALL_FAILED_UPDATE_INCOMPATIBLE and no version-downgrade refusal.",
+      },
+      "fileLyrics": {
+        "title": "Lyrics from the previous build",
+        "description": "The linked-mode lyrics work added in 0.9.9 stays: sidecar .lrc/.vtt plus embedded lyrics read the way Aurora does it.",
+      },
+      "fixes": {
+        "sameKey": "The signing key is fixed (folia-release.jks, RSA 2048, 10000 days) instead of generated per CI run.",
+        "monotonic": "versionCode is based on the CI run number, so each build is higher than the last and Android treats it as an upgrade.",
+        "debugRelease": "Folia-debug.apk and Folia-release.apk now share one signature, so either can replace the other.",
+        "oneTime": "Moving from 0.9.9 (old throwaway key) to this build still needs one uninstall; after that, never again."
+      }
+    },
+    "v0_9_9": {
+      "intro": "0.9.9 brings lyrics to local songs on the car unit: the lyric page now reads them from the files — a .lrc next to the track, or lyrics embedded in the audio (ID3 USLT, FLAC LYRICS, M4A ©lyr). This is how Aurora shows lyrics.",
+      "fileLyrics": {
+        "title": "Lyrics read straight from the file (like Aurora)",
+        "description": "Linked-mode tracks stay where they are, so the lyric page used to be empty: WebView cannot scan folders and the native probe only returned title and cover. Now, when a local song plays, the native layer lists .lrc/.vtt files in its folder and serves their bytes, and the page decodes (UTF-8 → GBK → Big5) and parses them; without a sidecar it reads embedded lyrics (MP3 ID3 USLT, FLAC/Ogg Vorbis LYRICS, M4A ©lyr). The result is saved back, so the next play needs no reading.",
+      },
+      "fixes": {
+        "encoding": "Old .lrc files are often GBK/Big5 with no declaration; decoding tries UTF-8, GBK then Big5 so the page is never mojibake.",
+        "id3size": "ID3v2.3 stores a plain 32-bit size while v2.4 uses synchsafe; both are handled (v2.3 is what old rips use).",
+        "lazy": "Only the first 2 MB of that one track is read, never a per-song pass at import, so a 2000-song library does not slow down.",
+        "cache": "Lyrics are written back and the library is refreshed, so the playing track updates without reopening it."
+      }
+    },
+    "v0_9_8": {
+      "intro": "0.9.8 fixes the steering-wheel pause key (working only the first time) and songs that would not play: media keys are now held the way Aurora does it, and formats WebView cannot decode are handed to the car unit's own decoder.",
+      "steeringWheel": {
+        "title": "The wheel's pause key no longer works only once",
+        "description": "The app only owned keys while it was in the foreground, so after a pause the head unit routed them back to its built-in player; on top of that the MediaSession and Activity entry points each delivered the press and cancelled each other. Now audio focus is taken while playing and released on pause, the playback position is refreshed every second so the session stays live, duplicate deliveries are dropped, and tapping the media panel can bring the app back.",
+      },
+      "formatFallback": {
+        "title": "Undecodable formats go to the car's decoder (Aurora's approach)",
+        "description": "ALAC in m4a, APE, WMA, DSF/DFF and TTA never decoded in WebView. On a decode/unsupported error the native layer now decodes with MediaExtractor + MediaCodec into a 16-bit stereo WAV in the cache and swaps the source to it, so the UI, lyrics, spectrum and wheel keys all keep working. If the car can decode it, it plays — exactly the rule Aurora follows.",
+      },
+      "fixes": {
+        "audioFocus": "AUDIOFOCUS_GAIN is requested while playing and released on pause; navigation prompts and calls pause playback, same as Aurora.",
+        "positionReport": "The page reports its position every second, so the head unit's progress bar and playing state no longer sit at zero.",
+        "mimeSniff": "Unknown formats no longer pretend to be audio/mpeg (which made WebView try an MP3 parse first); octet-stream fails immediately so the transcode can take over.",
+        "cacheLimit": "Converted WAVs are kept for two weeks only (about 50 MB per five-minute song) so storage is not eaten up."
+      }
+    },
+    "v0_9_7": {
+      "intro": "0.9.7 replaces the mojibake heuristic: instead of demanding that a string be 90% Chinese, it compares which decoding looks most like real text. Mixed Chinese/English titles, single-character labels and album names containing English are now repaired.",
+      "mixedTitle": {
+        "title": "Mixed Chinese/English titles are repaired too",
+        "description": "Titles like “Track 01 愛” or “Live 演唱會” used to be left alone because the Chinese share was under nine tenths. UTF-8 reinterpretation, GBK, Big5 and the ID3-specific repair are now scored together, and the most plausible one wins.",
+      },
+      "singleChar": {
+        "title": "Single-character labels (“李”) are repaired",
+        "description": "A title or album with only one character used to be skipped by the “at least two Chinese characters” rule. Short strings now have their own rule, so a single character is recovered as well.",
+      },
+      "noOverFix": {
+        "title": "Real Western text is not forced into Chinese",
+        "description": "“Björk”, “Café” and “Mötley Crüe” stay untouched: a candidate must score clearly better (1.2 points) than the original, and the GBK trail-byte trap (ö + r read as one Chinese character) is rejected.",
+      },
+      "fixes": {
+        "existingLibrary": "Garbled text already in the library is re-judged and written back, no re-import needed (manually renamed titles are left alone).",
+        "filenameFallback": "Tracks without embedded tags that fall back to the file name now get the file name repaired too.",
+        "unitTests": "Nine encoding regression tests added (GBK, Big5, UTF-8, UTF-16, mixed, single character, Western text, artist lists, import snapshot)."
+      }
+    },
+    "v0_9_6": {
+      "intro": "0.9.6 fixes tracks that could not be measured at all, and makes measuring much cheaper: no more decoding the whole file.",
+      "moreFormats": {
+        "title": "m4a / ogg / opus / DSD are recognised now",
+        "description": "Previously only flac, wav, aiff and mp3 were recognised; everything else stayed blank. m4a (AAC/ALAC), ogg (Vorbis/Opus) and dsf/dff (DSD) now report sample rate and bit depth, and m4a without faststart falls back to reading the moov at the end of the file. MP3 sync now requires the next frame to sit exactly where it should, so compressed data is no longer mistaken for 44.1k lossy.",
+      },
+      "sliceDecode": {
+        "title": "Lossless checks read only 12 MB",
+        "description": "Measuring used to read the whole file: a 5-minute 48 kHz FLAC meant hundreds of MB of decoded audio. Now lossless files read the first 12 MB (about 85 seconds), while self-syncing formats such as MP3 start at 45% and read 12 MB. The analysis window is still 20 seconds from the middle, the verdict is the same, and it is an order of magnitude faster. Only files that refuse to decode fall back to a full read.",
+      },
+      "parallelProbe": {
+        "title": "Header reads and measurements run in small batches",
+        "description": "Header pass runs 4 lanes so the head unit's eMMC/USB can actually use its I/O bandwidth; measurements run 2 at a time. Rows computed per list view went from 150 to 200, measured lossless tracks from 40 to 80, and results appear row by row while scrolling.",
+      },
+      "noBlankRow": {
+        "title": "Unreadable files no longer leave a gap",
+        "description": "If a file moved, lost permission or uses a container we truly cannot read, the column shows Unjudged instead of staying blank. Such failures are remembered only for this session and retried on the next launch.",
+      },
+      "fixes": {
+        "m4aMojibake": "m4a family (AAC/ALAC) could not be measured at all; now sample rate, bit depth and lossy/lossless are read.",
+        "mp3Id3Footer": "MP3s with an ID3v2.4 footer or a cover larger than 4 KB used to hide the first frame; they are found now.",
+        "alacDepth": "ALAC bit depth and channel count used to read as 0; they now match the file (24bit, for example).",
+        "unknownRetry": "Results that the previous version gave up on are judged again (cache prefix bumped to v2)."
+      }
+    },
+    "v0_9_5": {
+      "intro": "0.9.5 does one thing: it fixes song titles, albums and artists that came out garbled. Existing libraries do not need re-importing — broken text already stored is repaired the next time the app opens.",
+      "mojibakeFix": {
+        "title": "Automatic mojibake repair (GBK / UTF-8 / Big5)",
+        "description": "Old rips often put GBK bytes into ID3 frames declared as ISO-8859-1, and Android's native tag API returns them the same way. Imports and reads of existing records now try the correct decoding first: UTF-8 misread, GBK misread and Traditional Chinese Big5 misread are all recovered, while normal Chinese, Japanese, Björk or Café are left untouched.",
+      },
+      "carPerf": {
+        "title": "Head-unit performance preset",
+        "description": "Settings → Animation & Performance → Head-unit performance pushes the home background, player blur, lyric canvas and interface motion to smooth-first in one click; Android head units apply it automatically on first launch and can revert on the same page."
+      },
+      "linkedMode": {
+        "title": "Linked mode: no copying",
+        "description": "Import folder (no copy) only registers paths; the music stays on the USB drive or internal storage and streams through a local server on 127.0.0.1, cutting 2,216 tracks from tens of minutes to a few."
+      },
+      "mediaKeys": {
+        "title": "Steering-wheel keys taken over",
+        "description": "The native layer registers a MediaSession and intercepts KeyEvent, so play, pause, next and previous work from the wheel and the head-unit status bar follows along."
+      },
+      "fixes": {
+        "mojibakeExisting": "Garbled text already in the library is repaired automatically, no re-import needed (renamed titles are left alone).",
+        "mojibakeGbk": "GBK Chinese tags (“¸ÃËÀµÄÎÂÈá”) come back as normal Simplified Chinese.",
+        "mojibakeUtf8": "Strings decoded once as Latin-1 (“è¶…çº¦”) come back as normal Chinese.",
+        "mojibakeBig5": "Traditional Chinese Big5 tags (“周杰倫”, “范特西”) are recovered too."
+      }
+    },
+    "v0_9_4": {
+      "intro": "0.9.4 finishes the head-unit path: read an external drive in place without copying, a diagnostics panel when the USB drive is missing, steering-wheel media keys taken over at the native layer, a常駐 Settings entry next to the title, and a one-tap performance preset tuned for Android head units like the Liangshan Dudu S3 (8+128) that applies itself on first launch.",
+      "linkedMode": {
+        "title": "Linked mode: import without copying",
+        "description": "New “Import folder (no copy)”: only the paths are registered, the music stays on the USB drive or internal storage, and playback streams through a local server bound to 127.0.0.1 (seeking included). 2,216 tracks go from tens of minutes to a few minutes, and the quality column still works by reading the file header over HTTP Range."
+      },
+      "usbDiagnose": {
+        "title": "Diagnostics when the USB drive is missing",
+        "description": "Besides /storage/<UUID>, it now scans /mnt/media_rw, /mnt/usb and /udisk, marks unreadable volumes with ⚠ and says why; you can type a path manually; “Diagnostics” lists the SDK, permissions, real mount points and /proc/mounts so a screenshot is enough to tell whether the drive never mounted or the ROM keeps it away from third-party apps."
+      },
+      "carPerf": {
+        "title": "One-tap head-unit performance preset",
+        "description": "Animation & Performance now has a Head-unit performance group: one click turns off the home dynamic background and the player-page native blur, caps the lyric canvas at 60 FPS / 0.75x resolution with antialiasing off, switches the lyric style to Still, and reduces all interface motion. Previous values are saved for reverting, and Android head units apply it once automatically on first launch."
+      },
+      "settingsEntry": {
+        "title": "Settings sits next to the title",
+        "description": "The library home reads folia · Library [Settings] NetEase [Local], and collection pages read [← Back] [Settings]. It opens the full settings window with its sidebar and search box, so typing “size” or “source” finds the page."
+      },
+      "mediaKeys": {
+        "title": "Steering-wheel keys taken over",
+        "description": "A WebView never registers a media session, so head-unit media keys never reached the page. This build both registers a MediaSession and intercepts dispatchKeyEvent, covering both kinds of head units, and reports playback state so the status bar and Bluetooth card follow along."
+      },
+      "releaseNotesEveryUpdate": {
+        "title": "Every update explains what changed",
+        "description": "This window. Each new version lists what was added and what was fixed on the first launch after the update; once seen it stays quiet, and you can reopen it from Settings → Help → Release notes."
+      },
+      "fixes": {
+        "importProgress": "No more two identical progress lines while importing: only the button you pressed shows numbers, the other returns to its own label and greys out.",
+        "importLiveLists": "Thousands of tracks no longer appear only at the end: the list refreshes every 25 songs written, so the library grows during the import.",
+        "carGutter": "Head unit, web and iPhone builds no longer reserve the 32 px desktop title bar strip at the top, so a 9-inch screen shows one or two extra rows.",
+        "linkNotReplied": "A linked import that adds nothing, or skips a whole batch, now says so instead of staying silent."
+      }
+    },
