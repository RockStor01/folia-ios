+++ b/src/services/localCoverBlobFallback.ts
@@ -0,0 +1,104 @@
+// src/services/localCoverBlobFallback.ts
+// 封面顯示的最後一道保險（v0.9.19）。
+//
+// 網頁／車機版的封面是走 /__folia_cover/<assetId> 這條路徑，由 PWA 的 service worker 從 OPFS 讀出來回應。
+// 問題是：車機的 WebView 不一定肯把 worker 註冊起來（老 WebView、precache 太大、更新失敗），
+// 一旦 worker 不在，封面就整批變成 404——清單、播放頁、歌單全部空白，看起來就是「專輯圖片都不見了」。
+//
+// 這支模組不改任何元件：它在 window 上掛一個捕獲階段的 error 監聽，撿到載入失敗的本地封面 <img>，
+// 自己從 OPFS 讀出位元組、開一個 blob: 網址換上去。worker 正常時永遠不會被觸發，worker 壞掉時它兜底。
+
+import { isLocalCoverAssetUrl } from './localCoverAssetUrl';
+import { readLocalCoverBinaryBlob } from './localCoverBinaryStore';
+
+const COVER_URL_PATTERN = /\/__folia_cover\/([^/?#]+)/;
+const ASSET_ID_PATTERN = /^sha256:[0-9a-f]{64}$/;
+/** blob 網址開太多會吃記憶體，超過這個數量就回收最舊的。 */
+const MAX_BLOB_URLS = 120;
+
+const blobUrls = new Map<string, string>();
+
+/** 從封面網址反推 assetId；不是本地封面就回 null。 */
+export const coverAssetIdFromUrl = (url: string | null | undefined): string | null => {
+    if (!url) return null;
+    const match = COVER_URL_PATTERN.exec(url);
+    if (!match) return null;
+    let decoded: string;
+    try {
+        decoded = decodeURIComponent(match[1]);
+    } catch {
+        return null;
+    }
+    return ASSET_ID_PATTERN.test(decoded) ? decoded : null;
+};
+
+const remember = (assetId: string, url: string): string => {
+    if (blobUrls.size >= MAX_BLOB_URLS) {
+        const oldest = blobUrls.keys().next().value;
+        if (oldest) {
+            const stale = blobUrls.get(oldest);
+            blobUrls.delete(oldest);
+            if (stale) URL.revokeObjectURL(stale);
+        }
+    }
+    blobUrls.set(assetId, url);
+    return url;
+};
+
+/** 取這個 assetId 的 blob 網址；讀不到回 null（表示封面真的不在這台裝置上）。 */
+export const resolveLocalCoverBlobUrl = async (assetId: string): Promise<string | null> => {
+    const cached = blobUrls.get(assetId);
+    if (cached) return cached;
+    const blob = await readLocalCoverBinaryBlob(assetId);
+    if (!blob) return null;
+    return remember(assetId, URL.createObjectURL(blob));
+};
+
+const pending = new Map<string, Promise<string | null>>();
+
+/** 同一張封面同時被好幾個 <img> 要求時只讀一次。 */
+const resolveOnce = (assetId: string): Promise<string | null> => {
+    const cached = blobUrls.get(assetId);
+    if (cached) return Promise.resolve(cached);
+    const inFlight = pending.get(assetId);
+    if (inFlight) return inFlight;
+    const task = (async () => {
+        try {
+            return await resolveLocalCoverBlobUrl(assetId);
+        } catch (error) {
+            console.warn('[LocalCoverFallback] read failed', assetId, error);
+            return null;
+        } finally {
+            pending.delete(assetId);
+        }
+    })();
+    pending.set(assetId, task);
+    return task;
+};
+
+const swapImage = async (image: HTMLImageElement): Promise<void> => {
+    const current = image.getAttribute('src');
+    const assetId = coverAssetIdFromUrl(current);
+    if (!assetId) return;
+    const blobUrl = await resolveOnce(assetId);
+    // 換之前再確認一次：使用者可能已經切到別的歌，這個 <img> 的 src 換人了。
+    if (blobUrl && image.isConnected && image.getAttribute('src') === current) {
+        image.src = blobUrl;
+    }
+};
+
+/**
+ * 接住載入失敗的封面。
+ * 注意 error 事件不冒泡，所以要在 window 上以 capture=true 聽；
+ * image 的 error 只觸發一次，換上 blob 網址後若還失敗就由瀏覽器的破圖處理，不再進迴圈。
+ */
+export const installLocalCoverBlobFallback = (): void => {
+    if (typeof window === 'undefined') return;
+    window.addEventListener('error', event => {
+        const target = event.target;
+        if (!(target instanceof HTMLImageElement)) return;
+        const source = target.currentSrc || target.getAttribute('src');
+        if (!isLocalCoverAssetUrl(source)) return;
+        void swapImage(target);
+    }, true);
+};
