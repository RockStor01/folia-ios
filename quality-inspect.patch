+                    // 直接以按鈕掛在這裡；邏輯與 Grid、Bravais 共用 useLocalAudioImport。
+                    {
+                        id: 'import-files',
+                        label: audioImport.importMode === 'files' && audioImport.progress
+                            ? t(audioImport.progress.eta ? 'localMusic.importingProgressEta' : 'localMusic.importingProgress', { done: audioImport.progress.done, total: audioImport.progress.total, eta: audioImport.progress.eta ?? '' })
+                            : t('localMusic.importFiles'),
+                        disabled: audioImport.importing,
+                        pending: audioImport.importMode === 'files',
+                    },
+                    // 車機 APK 才有的第二條路：不複製檔案，直接讀原位置（USB / 內建儲存）。
+                    ...(audioImport.linkedSupported
+                        ? [{
+                            id: 'import-linked-folder',
+                            label: audioImport.importMode === 'linked'
+                                ? (audioImport.progress && audioImport.progress.total > 0
+                                    ? t(audioImport.progress.eta ? 'localMusic.importingProgressEta' : 'localMusic.importingProgress', { done: audioImport.progress.done, total: audioImport.progress.total, eta: audioImport.progress.eta ?? '' })
+                                    : t('localMusic.linkingFolder'))
+                                : t('localMusic.importLinkedFolder'),
+                            disabled: audioImport.importing,
+                            pending: audioImport.importing,
+                        }]
+                        : []),
+                ]}
+                onRun={(id) => {
+                    if (id === 'import-files') audioImport.openPicker();
+                    else if (id === 'import-linked-folder') audioImport.openLinkedPicker();
+                    else runAction(id);
+                }}
             />
+            {audioImport.linkedPickerOpen ? (
+                <LinkedFolderPicker
+                    onCancel={audioImport.closeLinkedPicker}
+                    onImport={audioImport.importLinkedFolder}
+                />
+            ) : null}
             <LibraryTuiDirectory
                 {...common}
                 directoryKey={directoryKey}
