@@ -0,0 +1,103 @@
+// @builtin-sources
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { autoMatchBestLyric, clearAutoMatchBestLyricCache } from '@/utils/lyrics/autoMatchBestLyric';
+import { getOnlineMusicProvider } from '@/services/onlineMusic/providerRegistry';
+
+// test/unit/lyrics/autoMatchFastPath.test.ts
+// The three things that make a match cost less: the same words are not searched twice, two runs for
+// them at once are one run, and asking the sources together changes no winner.
+
+const lyricsOf = (isWordByWord: boolean) => ({
+    lines: [{ fullText: 'Test lyric', startTime: 0, endTime: 1, words: [] }],
+    isWordByWord,
+});
+
+const qqSong = (name: string) => ({
+    id: 201,
+    name,
+    artists: [{ id: 1, name: 'Artist Name' }],
+    album: { id: 2, name: 'Album' },
+    durationMs: 200000,
+    qqMid: 'qq-mid',
+    sourceRef: { kind: 'online' as const, providerId: 'qq', mediaId: '201' },
+});
+
+const spyQq = (songs: unknown[], wordByWord: boolean) => {
+    const provider = getOnlineMusicProvider('qq')!;
+    const search = vi.spyOn(provider.search!, 'searchSongs').mockResolvedValue({
+        items: songs as never,
+        hasMore: false,
+        nextOffset: 1,
+    });
+    const fetch = vi.spyOn(provider.lyrics!, 'getLyrics').mockResolvedValue({
+        lyrics: lyricsOf(wordByWord) as never,
+        isPureMusic: false,
+    });
+    return { search, fetch };
+};
+
+describe('the fast path of the lyric match', () => {
+    beforeEach(() => {
+        vi.restoreAllMocks();
+        clearAutoMatchBestLyricCache();
+    });
+
+    it('answers a second run for the same words without searching again', async () => {
+        const { search } = spyQq([qqSong('Same Words')], true);
+
+        const first = await autoMatchBestLyric('Same Words', 'Artist Name', 200000, { preferredSource: 'qq' });
+        expect(first).toMatchObject({ source: 'qq', id: 201 });
+        const searched = search.mock.calls.length;
+        expect(searched).toBeGreaterThan(0);
+
+        const second = await autoMatchBestLyric('Same Words', 'Artist Name', 200000, { preferredSource: 'qq' });
+        expect(second).toEqual(first);
+        expect(search.mock.calls.length).toBe(searched);
+    });
+
+    it('shares one run between two runs started at the same time', async () => {
+        const { search } = spyQq([qqSong('One Run')], true);
+
+        const [a, b] = await Promise.all([
+            autoMatchBestLyric('One Run', 'Artist Name', 200000, { preferredSource: 'qq' }),
+            autoMatchBestLyric('One Run', 'Artist Name', 200000, { preferredSource: 'qq' }),
+        ]);
+
+        expect(a).toEqual(b);
+        expect(search.mock.calls.length).toBe(1);
+    });
+
+    it('asks the sources together and still gives the same match, in the same order', async () => {
+        // QQ answers with lines only; the word-by-word lyric is the next source's.
+        spyQq([qqSong('Order Kept')], false);
+        const netease = getOnlineMusicProvider('netease')!;
+        vi.spyOn(netease.search!, 'searchSongs').mockResolvedValue({
+            items: [{
+                id: 101,
+                name: 'Order Kept',
+                artists: [{ id: 1, name: 'Artist Name' }],
+                album: { id: 2, name: 'Album' },
+                durationMs: 200000,
+                sourceRef: { kind: 'online', providerId: 'netease', mediaId: '101' },
+            }] as never,
+            hasMore: false,
+            nextOffset: 1,
+        });
+        vi.spyOn(netease.lyrics!, 'getLyrics').mockResolvedValue({
+            lyrics: lyricsOf(true) as never,
+            isPureMusic: false,
+            chorusRanges: [],
+        });
+
+        const serial = await autoMatchBestLyric('Order Kept', 'Artist Name', 200000, { preferredSource: 'qq' });
+        clearAutoMatchBestLyricCache();
+        const parallel = await autoMatchBestLyric('Order Kept', 'Artist Name', 200000, {
+            preferredSource: 'qq',
+            parallelSources: true,
+        });
+
+        expect(parallel).toBeTruthy();
+        expect(parallel).toMatchObject({ source: 'netease', id: 101, lyrics: { isWordByWord: true } });
+        expect((parallel as { source: string }).source).toBe((serial as { source: string } | null)?.source);
+    });
+});
