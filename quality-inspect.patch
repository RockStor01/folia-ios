+                                    </>
+                                ) : null}
+                            </div>
+                        ) : null}
+
+                        <p className="mt-3 text-xs opacity-40">{t('localMusic.linkedFolderHint')}</p>
+                    </>
+                )}
+            </div>
+        </div>
+    );
+};
+
+export default LinkedFolderPicker;
