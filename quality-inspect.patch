 import { getLocalLyricFilePriority, isSameLocalLyricFormatOrder, normalizeLocalLyricFormatOrder, type LocalLyricFileFormat } from '../utils/lyrics/localLyricFormatOrder';
 import { readLyricFile } from '../utils/lyrics/lyricFileDecoding';
@@ -1204,6 +1205,136 @@ export async function importFolder(expectedRootName?: string): Promise<LocalSong
     }
 }
 
+/** 手機／平板匯入的那批歌掛在這個虛擬根目錄下，跟資料夾掃描進來的歌分得開。 */
+export const IMPORTED_LOCAL_ROOT_NAME = '本機匯入';
+
+export interface ImportAudioFilesResult {
+    songs: LocalSong[];
+    skipped: number;
+    failed: { fileName: string; reason: string }[];
+}
+
+/**
+ * 直接吃 <input type=file> 挑回來的檔案，把它們當成本地曲庫裡的歌。
+ *
+ * 存在的理由：iOS 沒有 showDirectoryPicker，資料夾匯入在 iPhone 上根本走不通，於是「本地」
+ * 頁籤永遠是空的。這裡把檔案本體存進 imported 音檔庫，歌曲記錄照資料夾匯入的同一套欄位寫
+ * （時長、抽到的標籤、內嵌封面、ReplayGain 都照舊），所以之後的播放、歌單、歌詞匹配、音質
+ * 體檢都不用改，看到的就是一群普通的本機歌曲。
+ */
+export async function importAudioFiles(files: File[]): Promise<ImportAudioFilesResult> {
+    const result: ImportAudioFilesResult = { songs: [], skipped: 0, failed: [] };
+    const candidates = files.filter(file => KNOWN_AUDIO_EXTENSIONS.test(file.name));
+    if (candidates.length === 0) return result;
+
+    const allSongs = await getLocalSongs();
+    const existingSignatures = new Set(
+        allSongs
+            .filter(song => song.folderName === IMPORTED_LOCAL_ROOT_NAME)
+            .map(song => `${song.fileName}:${song.fileSize}:${song.fileLastModified ?? 0}`),
+    );
+
+    for (let index = 0; index < candidates.length; index += 1) {
+        const file = candidates[index];
+        const signature = `${file.name}:${file.size}:${file.lastModified}`;
+        if (existingSignatures.has(signature)) {
+            result.skipped += 1;
+            continue;
+        }
+
+        try {
+            await putImportedAudio(songIdForFile(file), file);
+
+            let embeddedMetadata: EmbeddedMetadata = {};
+            try {
+                embeddedMetadata = await extractEmbeddedMetadata(file, true);
+            } catch (error) {
+                console.warn(`[LocalMusic][Import] Failed to parse metadata for ${file.name}:`, error);
+            }
+
+            let duration = embeddedMetadata.duration || 0;
+            if (!duration) {
+                try {
+                    duration = await getAudioDuration(file);
+                } catch (error) {
+                    console.warn(`[LocalMusic][Import] Failed to read duration for ${file.name}:`, error);
+                }
+            }
+
+            const metadata = extractMetadataFromFilename(file.name);
+            const songId = songIdForFile(file);
+            const importedMetadata = buildImportedMetadataSnapshot({
+                fileName: file.name,
+                embeddedTitle: embeddedMetadata.title,
+                fallbackTitle: metadata.title,
+                embeddedArtist: embeddedMetadata.artist,
+                embeddedArtists: embeddedMetadata.artists,
+                fallbackArtist: metadata.artist,
+                embeddedAlbum: embeddedMetadata.album,
+            });
+
+            let localCoverAssetId: string | undefined;
+            if (embeddedMetadata.cover && embeddedMetadata.coverAssetId) {
+                if (stageLocalCoverAsset(embeddedMetadata.coverAssetId, embeddedMetadata.cover)) {
+                    localCoverAssetId = embeddedMetadata.coverAssetId;
+                }
+            }
+
+            const localSong: LocalSong = {
+                id: songId,
+                fileName: file.name,
+                filePath: `${IMPORTED_LOCAL_ROOT_NAME}/${file.name}`,
+                duration,
+                fileSize: file.size,
