index 0000000..7b6e632
--- /dev/null
+++ b/src/hooks/useLocalAudioImport.ts
@@ -0,0 +1,160 @@
+// src/hooks/useLocalAudioImport.ts
+// 「從檔案匯入」在每個首頁 suite 裡都一樣：一顆隱藏的 input、一個 busy 旗標、一個 handler。
+// 抽出來是因為 Bravais 空牆、Grid3D 空狀態、TUI 清單都要同一件事，分散寫三份遲早對不上。
+
+import { useCallback, useRef, useState } from 'react';
+import i18n from '../i18n/config';
+import { importAudioFiles, importLinkedAudioPaths, LINKED_LOCAL_ROOT_NAME } from '../services/localMusicService';
+import { setStatusMessage } from '../stores/useStatusMessageStore';
+import { isMetadataParsingAvailable } from '../utils/localMetadataWorkerClient';
+import { isLinkedStorageSupported, scanStorageDirectory } from '../services/nativeLinkedStorage';
+
+export interface LocalAudioImportController {
+    /** 要掛在 input 上的 ref（input 必須真的在 DOM 裡）。 */
+    inputRef: React.RefObject<HTMLInputElement | null>;
+    importing: boolean;
+    /** 這輪匯入是誰起的：選檔（複製）還是連結資料夾；兩顆按鈕都掛著進度時，只有真的那顆該顯示數字。 */
+    importMode: 'files' | 'linked' | null;
+    /** 匯入進度（第 done 首／共 total 首）；沒在匯入時是 null。 */
+    progress: { done: number; total: number; eta: string | null } | null;
+    /** 開系統選檔器（iOS 走「檔案」App，安卓走 SAF 文件選擇器）。 */
+    openPicker: () => void;
+    /** 給 <input type="file" multiple onChange> 用的處理函式。 */
+    handleFiles: (files: FileList | null) => void;
+    lastResult: { count: number; failed: number; skipped: number } | null;
+    /** 車機 APK 的原生層在不在（不在就沒有「不複製」這個選項）。 */
+    linkedSupported: boolean;
+    /** 原生資料夾瀏覽器開著沒有。 */
+    linkedPickerOpen: boolean;
+    openLinkedPicker: () => void;
+    closeLinkedPicker: () => void;
+    /** 選定一個原生資料夾 → 掃描 → 只登記路徑，不複製檔案。 */
+    importLinkedFolder: (rootPath: string, rootName: string) => void;
+}
+
+export const useLocalAudioImport = (): LocalAudioImportController => {
+    const inputRef = useRef<HTMLInputElement | null>(null);
+    const [importing, setImporting] = useState(false);
+    const [importMode, setImportMode] = useState<'files' | 'linked' | null>(null);
+    const [progress, setProgress] = useState<{ done: number; total: number; eta: string | null } | null>(null);
+    // 估剩餘時間用：知道「還要四十分鐘」比看著 10/2216 猜有沒有卡死有用得多。
+    const startedAtRef = useRef(0);
+    const formatEta = (done: number, total: number): string | null => {
+        if (done <= 0 || total <= 0 || !startedAtRef.current) return null;
+        const elapsedMs = Date.now() - startedAtRef.current;
+        const remainingMs = (elapsedMs / done) * (total - done);
+        if (!Number.isFinite(remainingMs) || remainingMs <= 0) return null;
+        if (remainingMs < 60000) {
+            return i18n.t('localMusic.importEtaSeconds', { seconds: Math.max(1, Math.round(remainingMs / 1000)) });
+        }
+        return i18n.t('localMusic.importEtaMinutes', { minutes: Math.max(1, Math.round(remainingMs / 60000)) });
+    };
+    const [lastResult, setLastResult] = useState<LocalAudioImportController['lastResult']>(null);
+    const busyRef = useRef(false);
+    const linkedSupported = isLinkedStorageSupported();
+    const [linkedPickerOpen, setLinkedPickerOpen] = useState(false);
+    const openLinkedPicker = useCallback(() => setLinkedPickerOpen(true), []);
+    const closeLinkedPicker = useCallback(() => setLinkedPickerOpen(false), []);
+
+    const openPicker = useCallback(() => {
+        inputRef.current?.click();
+    }, []);
+
+    const handleFiles = useCallback((files: FileList | null) => {
+        setImportMode('files');
+        // FileList 是活的：清 value 之前先抓成陣列，否則清完就空了。
+        const picked = Array.from(files ?? []);
+        if (inputRef.current) inputRef.current.value = '';
+        if (!picked.length || busyRef.current) return;
+
+        busyRef.current = true;
+        setImporting(true);
+        startedAtRef.current = Date.now();
+        setProgress({ done: 0, total: picked.length, eta: null });
+        void (async () => {
+            try {
+                // 進度每五首刷一次就好：每首刷新等於讓整面牆跟著重繪兩千次，反而更卡。
+                const result = await importAudioFiles(picked, {
+                    onProgress: info => {
+                        if (info.done === 0 || info.done === info.total || info.done % 5 === 0) {
+                            setProgress({ done: info.done, total: info.total, eta: formatEta(info.done, info.total) });
+                        }
+                    },
+                });
+                setLastResult({ count: result.songs.length, failed: result.failed.length, skipped: result.skipped });
+                // 解析 worker 起不來（舊車機 WebView 常見）時，歌照樣進得來，但沒有標籤 / 封面 / 時長，
+                // 這件事要講出來，否則使用者只會看到一堆檔名，以為又是壞掉。
+                if (result.songs.length > 0) {
+                    setStatusMessage({
+                        type: 'success',
+                        text: i18n.t('localMusic.importFinished', { added: result.songs.length, failed: result.failed.length }),
+                    });
+                }
+                if (result.songs.length > 0 && !isMetadataParsingAvailable()) {
+                    setStatusMessage({ type: 'info', text: i18n.t('localMusic.importWithoutTags') });
+                }
+                if (result.failed.length > 0) {
+                    console.warn('[LocalImport] Some files could not be imported:', result.failed);
+                }
+            } catch (error) {
+                console.error('[LocalImport] Import failed', error);
+                setLastResult({ count: 0, failed: picked.length, skipped: 0 });
+            } finally {
+                busyRef.current = false;
+                setImporting(false);
+                setImportMode(null);
+                setProgress(null);
+            }
+        })();
+    }, []);
+
+    const importLinkedFolder = useCallback((rootPath: string, rootName: string) => {
+        if (busyRef.current) return;
+        setLinkedPickerOpen(false);
+        busyRef.current = true;
+        setImporting(true);
+        setImportMode('linked');
+        startedAtRef.current = Date.now();
+        // total 0 代表「還在掃描」：車機上一次掃兩千多筆目錄要幾秒，先把畫面切過去再掃。
+        setProgress({ done: 0, total: 0, eta: null });
+        void (async () => {
+            try {
+                await new Promise<void>(resolve => { setTimeout(resolve, 0); });
+                const files = scanStorageDirectory(rootPath);
+                setProgress({ done: 0, total: files.length, eta: null });
+                const folderName = rootName || LINKED_LOCAL_ROOT_NAME;
+                const result = await importLinkedAudioPaths(files, rootPath, folderName, {
+                    onProgress: info => {
+                        if (info.done === 0 || info.done === info.total || info.done % 5 === 0) {
+                            setProgress({ done: info.done, total: info.total, eta: formatEta(info.done, info.total) });
+                        }
+                    },
+                });
+                setLastResult({ count: result.songs.length, failed: result.failed.length, skipped: result.skipped });
+                if (result.songs.length > 0) {
+                    setStatusMessage({
+                        type: 'success',
+                        text: i18n.t('localMusic.importFinished', { added: result.songs.length, failed: result.failed.length }),
+                    });
+                }
+                if (result.failed.length > 0) {
+                    setStatusMessage({ type: 'info', text: i18n.t('localMusic.linkedFailedProbe') });
+                    console.warn('[LocalImport][Link] Some files were skipped:', result.failed);
+                }
+            } catch (error) {
+                console.error('[LocalImport][Link] Linking a folder failed', error);
+                setLastResult({ count: 0, failed: 0, skipped: 0 });
+            } finally {
+                busyRef.current = false;
+                setImporting(false);
+                setImportMode(null);
+                setProgress(null);
+            }
+        })();
+    }, []);
+
+    return {
+        inputRef, importing, importMode, progress, openPicker, handleFiles, lastResult,
+        linkedSupported, linkedPickerOpen, openLinkedPicker, closeLinkedPicker, importLinkedFolder,
+    };
+};
