@@ -0,0 +1,149 @@
+// src/services/localImportedAudioStore.ts
+// 手機／平板匯入的音檔本體放哪裡。
+//
+// 原本的本地曲庫全靠 FileSystemFileHandle 活著（showDirectoryPicker）。iOS 的 Safari 與 WKWebView
+// 沒有這個 API，於是「本地」頁籤在 iPhone 上永遠是空的。這裡補的是另一條來源：使用者用
+// <input type=file> 挑幾個檔，把 File 原樣存進一個獨立的 IndexedDB，之後播放、算時長、抽封面、
+// 體檢都從這裡拿 bytes。
+//
+// 為什麼不塞進 songs 那張表：整庫讀取時會把所有記錄一起拉出來，把檔案本體掛在歌曲記錄上等於
+// 每次開歌單都在解一堆 Blob。獨立 store 按 song id 取，只有真的要聽那一首時才碰它。
+
+const DB_NAME = 'folia-imported-audio';
+const STORE_NAME = 'audio';
+
+interface ImportedAudioRecord {
+    id: string;
+    file: File;
+    savedAt: number;
+}
+
+let dbPromise: Promise<IDBDatabase> | null = null;
+
+const openOnce = (version: number): Promise<IDBDatabase> => new Promise<IDBDatabase>((resolve, reject) => {
+    const request = version > 0 ? indexedDB.open(DB_NAME, version) : indexedDB.open(DB_NAME);
+    request.onupgradeneeded = () => {
+        const db = request.result;
+        if (!db.objectStoreNames.contains(STORE_NAME)) {
+            db.createObjectStore(STORE_NAME, { keyPath: 'id' });
+        }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error ?? new Error('Could not open imported audio store'));
+});
+
+// 這隻資料庫有可能比我們先存在（版本對得上但沒有 store），open 不會再觸發 upgrade。
+// 遇到這種情況就把版本往上推一格重開，讓 onupgradeneeded 有機會把 store 建出來。
+const openDb = (): Promise<IDBDatabase> => {
+    if (dbPromise) return dbPromise;
+    dbPromise = (async () => {
+        if (typeof indexedDB === 'undefined') throw new Error('IndexedDB is unavailable');
+        // 不帶版本開：這隻庫可能已經被舊版程式的自我修復推高過版本（例如 2），
+        // 硬寫 1 只會換來 VersionError，之後每次讀檔都失敗（「匯入的歌找不到」就是這樣來的）。
+        // 新庫不存在時 open 會自動建在版本 1，onupgradeneeded 照樣會把 store 建出來。
+        let db = await openOnce(0);
+        if (!db.objectStoreNames.contains(STORE_NAME)) {
+            const nextVersion = db.version + 1;
+            db.close();
+            db = await openOnce(nextVersion);
+        }
+        return db;
+    })();
+    dbPromise.catch(() => { dbPromise = null; });
+    return dbPromise;
+};
+
+const runRequest = <T>(request: IDBRequest<T>): Promise<T> => new Promise<T>((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error ?? new Error('IndexedDB request failed'));
+});
+
+export const isImportedAudioStoreSupported = (): boolean => typeof indexedDB !== 'undefined';
+
+export async function putImportedAudio(id: string, file: File): Promise<void> {
+    const db = await openDb();
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    tx.objectStore(STORE_NAME).put({ id, file, savedAt: Date.now() } satisfies ImportedAudioRecord);
+    await new Promise<void>((resolve, reject) => {
+        tx.oncomplete = () => resolve();
+        tx.onerror = () => reject(tx.error ?? new Error('Could not save imported audio'));
+        tx.onabort = () => reject(tx.error ?? new Error('Imported audio transaction aborted'));
+    });
+}
+
+export async function readImportedAudio(id: string): Promise<File | null> {
+    try {
+        const db = await openDb();
+        const record = await runRequest<ImportedAudioRecord | undefined>(
+            db.transaction(STORE_NAME, 'readonly').objectStore(STORE_NAME).get(id),
+        );
+        return record?.file ?? null;
+    } catch (error) {
+        console.warn('[LocalImport] Could not read imported audio', error);
+        return null;
+    }
+}
+
+export async function hasImportedAudio(id: string): Promise<boolean> {
+    try {
+        const db = await openDb();
+        const key = await runRequest<IDBValidKey | undefined>(
+            db.transaction(STORE_NAME, 'readonly').objectStore(STORE_NAME).getKey(id),
+        );
+        return key !== undefined;
+    } catch {
+        return false;
+    }
+}
+
+export async function deleteImportedAudio(id: string): Promise<void> {
+    try {
+        const db = await openDb();
+        const tx = db.transaction(STORE_NAME, 'readwrite');
+        tx.objectStore(STORE_NAME).delete(id);
+        await new Promise<void>((resolve, reject) => {
+            tx.oncomplete = () => resolve();
+            tx.onerror = () => reject(tx.error ?? new Error('Could not delete imported audio'));
+        });
+    } catch (error) {
+        console.warn('[LocalImport] Could not delete imported audio', error);
+    }
+}
+
+export async function deleteImportedAudioMany(ids: string[]): Promise<void> {
+    if (!ids.length) return;
+    try {
+        const db = await openDb();
+        const tx = db.transaction(STORE_NAME, 'readwrite');
+        const store = tx.objectStore(STORE_NAME);
+        ids.forEach(id => store.delete(id));
+        await new Promise<void>((resolve, reject) => {
+            tx.oncomplete = () => resolve();
+            tx.onerror = () => reject(tx.error ?? new Error('Could not delete imported audio'));
+        });
+    } catch (error) {
+        console.warn('[LocalImport] Could not delete imported audio batch', error);
+    }
+}
+
+export async function countImportedAudio(): Promise<number> {
+    try {
+        const db = await openDb();
+        return await runRequest<number>(db.transaction(STORE_NAME, 'readonly').objectStore(STORE_NAME).count());
+    } catch {
+        return 0;
+    }
+}
+
+/** 匯入過的全部 id，用來判斷某首是不是「本機匯入」而不是資料夾掃描進來的。 */
+export async function listImportedAudioIds(): Promise<Set<string>> {
+    try {
+        const db = await openDb();
+        const keys = await runRequest<IDBValidKey[]>(
+            db.transaction(STORE_NAME, 'readonly').objectStore(STORE_NAME).getAllKeys(),
+        );
+        return new Set(keys.map(key => String(key)));
+    } catch {
+        return new Set();
+    }
+}
