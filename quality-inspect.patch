+// src/services/audioQuality/qualitySpectrum.ts
+// 音質體檢的頻譜部分：8192 點 FFT + Welch 平均，得出「內容到底延伸到哪個頻率」。
+//
+// 判斷假無損的關鍵不是「有沒有高頻」，而是兩件事：
+//   1. 截止點 —— 從高往低，連續 3 個 bin 都高於參考電平 −45 dB 的最高頻率；
+//   2. 過渡帶 —— 截止點減去最後一個還站在 −10 dB 以內的頻率。
+// 編碼器低通是斷崖（幾百 Hz 掉 60 dB）；母帶濾波或升頻是緩坡（好幾 kHz 才掉下去）。
+// 全部用原始 bin，不做頻帶平滑，平滑會把斷崖抹平成緩坡，正是先前誤判的原因。
+
+/** FFT 點數：44.1 kHz 下每 bin 5.38 Hz，夠分辨編碼器的低通牆。 */
+export const QUALITY_FFT_SIZE = 8192;
+const HOP = 4096;
+
+export interface Spectrum {
+    /** 每個 bin 的功率，dB。 */
+    db: Float64Array;
+    /** 每個 bin 的頻寬（Hz）。 */
+    freqPerBin: number;
+    /** 參與平均的 FFT 幀數。 */
+    frames: number;
+}
+
+export interface BandSummary {
+    /** 內容實際延伸到哪（Hz）；找不到時為 null。 */
+    cutoffHz: number | null;
+    /** 音樂本體的參考電平（dB），取 1–8 kHz 的中位數。 */
+    refDb: number;
+    /** 從 −10 dB 掉到截止點的寬度（Hz）；斷崖幾百 Hz，緩坡幾 kHz。 */
+    transitionHz: number | null;
+}
+
+const fft = (re: Float64Array, im: Float64Array): void => {
+    const n = re.length;
+    for (let i = 1, j = 0; i < n; i += 1) {
+        let bit = n >> 1;
+        for (; j & bit; bit >>= 1) j ^= bit;
+        j ^= bit;
+        if (i < j) {
+            const tr = re[i]; re[i] = re[j]; re[j] = tr;
+            const ti = im[i]; im[i] = im[j]; im[j] = ti;
+        }
+    }
+    for (let len = 2; len <= n; len <<= 1) {
+        const ang = (-2 * Math.PI) / len;
+        const wr = Math.cos(ang);
+        const wi = Math.sin(ang);
+        for (let i = 0; i < n; i += len) {
+            let cr = 1;
+            let ci = 0;
+            for (let k = 0; k < len / 2; k += 1) {
+                const a = i + k;
+                const b = i + k + len / 2;
+                const vr = re[b] * cr - im[b] * ci;
+                const vi = re[b] * ci + im[b] * cr;
+                re[b] = re[a] - vr; im[b] = im[a] - vi;
+                re[a] += vr; im[a] += vi;
+                const ncr = cr * wr - ci * wi;
+                ci = cr * wi + ci * wr; cr = ncr;
+            }
+        }
+    }
+};
+
+const median = (values: number[]): number => {
+    if (!values.length) return 0;
+    const sorted = [...values].sort((a, b) => a - b);
+    return sorted[Math.floor(sorted.length / 2)];
+};
+
+/** Welch 平均功率譜：單聲道樣本 + 取樣率 → 每個 bin 的 dB。 */
+export const averageSpectrum = (samples: Float32Array, sampleRate: number): Spectrum | null => {
+    const n = QUALITY_FFT_SIZE;
+    const frames = Math.floor((samples.length - n) / HOP) + 1;
+    if (frames <= 0) return null;
+
+    const win = new Float64Array(n);
+    for (let i = 0; i < n; i += 1) win[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (n - 1));
+
+    const acc = new Float64Array(n / 2 + 1);
+    const re = new Float64Array(n);
+    const im = new Float64Array(n);
+    for (let f = 0; f < frames; f += 1) {
+        const offset = f * HOP;
+        for (let i = 0; i < n; i += 1) {
+            re[i] = samples[offset + i] * win[i];
+            im[i] = 0;
+        }
+        fft(re, im);
+        for (let k = 0; k <= n / 2; k += 1) acc[k] += re[k] * re[k] + im[k] * im[k];
+    }
+
+    const db = new Float64Array(acc.length);
+    for (let k = 0; k < acc.length; k += 1) db[k] = 10 * Math.log10(acc[k] / frames + 1e-20);
+    return { db, freqPerBin: sampleRate / n, frames };
+};
+
+/** 截止點、參考電平、過渡帶寬度。 */
+export const summariseBand = (spectrum: Spectrum): BandSummary => {
+    const { db, freqPerBin } = spectrum;
+    const refBins: number[] = [];
+    for (let k = 0; k < db.length; k += 1) {
+        const f = k * freqPerBin;
+        if (f >= 1000 && f <= 8000) refBins.push(db[k]);
+    }
+    const refDb = median(refBins);
+
+    let cutoffHz: number | null = null;
+    for (let k = db.length - 3; k >= 3; k -= 1) {
+        const f = k * freqPerBin;
+        if (f < 2000) break;
+        if (db[k] > refDb - 45 && db[k - 1] > refDb - 45 && db[k - 2] > refDb - 45) {
+            cutoffHz = f;
+            break;
+        }
+    }
+
+    let lastStrongHz: number | null = null;
+    for (let k = db.length - 2; k >= 3; k -= 1) {
+        const f = k * freqPerBin;
+        if (f < 2000) break;
+        if (db[k] >= refDb - 10 && db[k - 1] >= refDb - 10) {
+            lastStrongHz = f;
+            break;
+        }
+    }
+
+    const transitionHz = (cutoffHz !== null && lastStrongHz !== null && cutoffHz > lastStrongHz)
+        ? Math.round(cutoffHz - lastStrongHz)
+        : null;
+
+    return { cutoffHz, refDb, transitionHz };
+};
