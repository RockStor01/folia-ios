+import { describe, expect, it } from 'vitest';
+import { coverAssetIdFromUrl } from '@/services/localCoverBlobFallback';
+
+// test/unit/localCoverBlobFallback.test.ts
+// v0.9.19：封面 404 時要能從 /__folia_cover/ 網址反推 assetId，才讀得到 OPFS 裡的位元組。
+
+const ASSET = 'sha256:' + 'a'.repeat(64);
+
+describe('coverAssetIdFromUrl', () => {
+    it('解出編碼過的 assetId', () => {
+        expect(coverAssetIdFromUrl(`/__folia_cover/${encodeURIComponent(ASSET)}`)).toBe(ASSET);
+        expect(coverAssetIdFromUrl(`https://localhost/__folia_cover/${encodeURIComponent(ASSET)}?size=1024`)).toBe(ASSET);
+    });
+
+    it('不是本地封面網址就回 null', () => {
+        expect(coverAssetIdFromUrl('blob:https://localhost/xyz')).toBeNull();
+        expect(coverAssetIdFromUrl('https://example.com/__folia_cover/nope')).toBeNull();
+        expect(coverAssetIdFromUrl('')).toBeNull();
+        expect(coverAssetIdFromUrl(undefined)).toBeNull();
+    });
+
+    it('格式不對的 assetId 也不採用', () => {
+        expect(coverAssetIdFromUrl(`/__folia_cover/${encodeURIComponent('sha256:123')}`)).toBeNull();
+        expect(coverAssetIdFromUrl('/__folia_cover/sha256%3A' + 'B'.repeat(64))).toBeNull();
+        expect(coverAssetIdFromUrl('/__folia_cover/%E0%A4%A')).toBeNull();
+    });
+});
