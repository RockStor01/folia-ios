+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+// test/unit/localSongRawTagBackfill.test.ts
+// 全库回填：修不了的歌不能永远占住每批的名额（v0.9.18 每次启动只补 25 首，前面救不回来的那批
+// 会让后面的歌永远轮不到）。这里验：修好多少、几首一起推进、试过的下次不再读。
+
+vi.mock('@/services/db', () => ({
+    getLocalSongs: vi.fn(),
+    saveLocalSongs: vi.fn(async () => undefined),
+}));
+vi.mock('@/services/localMusicService', () => ({
+    getLocalSongRangeBytes: vi.fn(async () => null),
+}));
+vi.mock('@/services/nativeLinkedStorage', () => ({
+    fetchNativeRange: vi.fn(),
+}));
+
+import { getLocalSongs, saveLocalSongs } from '@/services/db';
+import { fetchNativeRange } from '@/services/nativeLinkedStorage';
+import { repairLostTags, resetLostTagRepairAttempts } from '@/services/localSongRawTagBackfill';
+
+// 記憶體版 localStorage：模組只在讀寫「試過了」的名單時用到它。
+const store = new Map<string, string>();
+
+const song = (id: string, overrides: Record<string, unknown> = {}) => ({
+    id,
+    fileName: `${id}.mp3`,
+    filePath: `/storage/emulated/0/Music/${id}.mp3`,
+    linkedFilePath: `/storage/emulated/0/Music/${id}.mp3`,
+    duration: 1000,
+    fileSize: 1024,
+    mimeType: 'audio/mpeg',
+    addedAt: 0,
+    title: '???',
+    titleOrigin: 'tag',
+    importedMetadata: { title: '???', artistNames: ['???'], albumName: '???' },
+    ...overrides,
+});
+
+// 一份最小可解析的 ID3v2.4（UTF-8 frame），標題「晴天」。
+const id3 = (title: string): ArrayBuffer => {
+    const payload = [3, ...Array.from(new TextEncoder().encode(title))];
+    const frames = [...Array.from('TIT2').map(char => char.charCodeAt(0)), 0, 0, 0, payload.length, 0, 0, ...payload];
+    const bytes = Uint8Array.from([0x49, 0x44, 0x33, 4, 0, 0, 0, 0, (frames.length >>> 7) & 0x7f, frames.length, ...frames]);
+    return bytes.buffer as ArrayBuffer;
+};
+
+describe('repairLostTags', () => {
+    beforeEach(() => {
+        store.clear();
+        vi.stubGlobal('window', { addEventListener: () => {}, dispatchEvent: () => {} });
+        vi.stubGlobal('localStorage', {
+            getItem: (key: string) => store.get(key) ?? null,
+            setItem: (key: string, value: string) => { store.set(key, value); },
+            removeItem: (key: string) => { store.delete(key); },
+        });
+        resetLostTagRepairAttempts();
+        vi.mocked(getLocalSongs).mockReset();
+        vi.mocked(saveLocalSongs).mockClear();
+        vi.mocked(fetchNativeRange).mockReset();
+    });
+
+    it('fixes a title from the raw tag bytes and counts what it scanned', async () => {
+        vi.mocked(getLocalSongs).mockResolvedValue([song('a')] as never);
+        vi.mocked(fetchNativeRange).mockImplementation(async (_path, length) => id3('晴天').slice(0, length));
+
+        const result = await repairLostTags();
+
+        expect(result).toEqual({ scanned: 1, fixed: 1 });
+        const saved = vi.mocked(saveLocalSongs).mock.calls[0][0] as Array<{ id: string; title: string }>;
+        expect(saved[0]).toMatchObject({ id: 'a', title: '晴天' });
+    });
+
+    it('keeps going past a song it cannot fix, and does not read it again next time', async () => {
+        // a 的檔名本身也壞掉（連檔名退路都沒有），b 可以從標籤救回來。
+        vi.mocked(getLocalSongs).mockResolvedValue([song('a', { fileName: '???.mp3' }), song('b')] as never);
+        vi.mocked(fetchNativeRange).mockImplementation(async path => (
+            path === '/storage/emulated/0/Music/b.mp3' ? id3('七里香') : null
+        ));
+
+        expect(await repairLostTags()).toEqual({ scanned: 2, fixed: 1 });
+        // 第二輪：兩首都讀過了（一成一敗），不再掃任何一首。
+        expect(await repairLostTags()).toEqual({ scanned: 0, fixed: 0 });
+    });
+
+    it('falls back to the file name when the tags themselves are damaged', async () => {
+        vi.mocked(getLocalSongs).mockResolvedValue([song('c', { fileName: '03_夜曲_周杰伦.flac' })] as never);
+        // 標籤整個讀不到：只能靠檔名。
+        vi.mocked(fetchNativeRange).mockResolvedValue(null);
+
+        const result = await repairLostTags();
+
+        expect(result).toEqual({ scanned: 1, fixed: 1 });
+        const saved = vi.mocked(saveLocalSongs).mock.calls[0][0] as Array<{ title: string }>;
+        expect(saved[0].title).toBe('夜曲 周杰伦');
+    });
+});
