@@ -0,0 +1,128 @@
+import { describe, expect, it } from 'vitest';
+import { parseRawTags } from '@/services/localSongRawTags';
+
+// test/unit/localSongRawTags.test.ts
+// 原生探針把標籤解成 � 之後只能回頭讀原始位元組：這裡驗 ID3v2 的三種編碼寫法與 FLAC 的 Vorbis comment。
+
+const frame = (id: string, payload: number[]): number[] => {
+    const size = payload.length;
+    return [
+        ...Array.from(id).map(char => char.charCodeAt(0)),
+        (size >>> 24) & 0xff, (size >>> 16) & 0xff, (size >>> 8) & 0xff, size & 0xff,
+        0, 0,
+        ...payload,
+    ];
+};
+
+const tag = (frames: number[], major: number): Uint8Array => {
+    const size = frames.length;
+    return Uint8Array.from([
+        0x49, 0x44, 0x33, major, 0, 0,
+        (size >>> 21) & 0x7f, (size >>> 14) & 0x7f, (size >>> 7) & 0x7f, size & 0x7f,
+        ...frames,
+    ]);
+};
+
+const gbk = (text: string): number[] => Array.from(new TextEncoder().encode(text));
+
+describe('parseRawTags', () => {
+    it('reads UTF-8 ID3v2.4 frames', () => {
+        const bytes = tag([
+            ...frame('TIT2', [3, ...gbk('晴天')]),
+            ...frame('TPE1', [3, ...gbk('周杰伦')]),
+            ...frame('TALB', [3, ...gbk('叶惠美')]),
+        ], 4);
+        expect(parseRawTags(bytes, 'a.mp3')).toEqual({ title: '晴天', artist: '周杰伦', album: '叶惠美' });
+    });
+
+    it('reads UTF-16 with BOM', () => {
+        const utf16 = (text: string): number[] => [0xff, 0xfe, ...Array.from(text).flatMap(char => {
+            const code = char.charCodeAt(0);
+            return [code & 0xff, (code >>> 8) & 0xff];
+        })];
+        const bytes = tag([...frame('TIT2', [1, ...utf16('夜曲')])], 3);
+        expect(parseRawTags(bytes, 'b.mp3')?.title).toBe('夜曲');
+    });
+
+    it('falls back to GB18030 when the tag claims latin-1 but holds GBK bytes', () => {
+        // ffmpeg 與老車機常見：ID3v2.3 標籤寫 encoding=0，實際位元組是 GBK。
+        const bytes = tag([...frame('TIT2', [0, ...gbk('夜空中最亮的星')])], 3);
+        expect(parseRawTags(bytes, 'c.mp3')?.title).toBe('夜空中最亮的星');
+    });
+
+    it('reads FLAC Vorbis comments', () => {
+        const comment = (key: string, value: string): number[] => {
+            const text = Array.from(new TextEncoder().encode(`${key}=${value}`));
+            return [text.length & 0xff, (text.length >>> 8) & 0xff, 0, 0, ...text];
+        };
+        const body = [
+            0, 0, 0, 0, // vendor 長度 0
+            2, 0, 0, 0, // 兩條 comment
+            ...comment('TITLE', '夜曲'),
+            ...comment('ARTIST', '周杰伦'),
+        ];
+        const bytes = Uint8Array.from([
+            0x66, 0x4c, 0x61, 0x43, // fLaC
+            0x84, (body.length >>> 16) & 0xff, (body.length >>> 8) & 0xff, body.length & 0xff,
+            ...body,
+        ]);
+        expect(parseRawTags(bytes, 'd.flac')).toEqual({ title: '夜曲', artist: '周杰伦' });
+    });
+
+    it('ignores unknown containers', () => {
+        expect(parseRawTags(Uint8Array.from([1, 2, 3, 4]), 'e.wav')).toBeNull();
+    });
+});
+
+describe('parseRawTags：其他無損容器', () => {
+    const le32 = (value: number): number[] => [value & 0xff, (value >>> 8) & 0xff, (value >>> 16) & 0xff, (value >>> 24) & 0xff];
+    const be32 = (value: number): number[] => [(value >>> 24) & 0xff, (value >>> 16) & 0xff, (value >>> 8) & 0xff, value & 0xff];
+    const utf8 = (text: string): number[] => Array.from(new TextEncoder().encode(text));
+
+    it('reads WAV LIST/INFO tags', () => {
+        const info = (id: string, value: string): number[] => {
+            const body = utf8(value);
+            const padded = body.length & 1 ? [...body, 0] : body;
+            return [...Array.from(id).map(char => char.charCodeAt(0)), ...le32(body.length), ...padded];
+        };
+        const sub = [...info('INAM', '晴天'), ...info('IART', '周杰伦')];
+        const list = [...Array.from('LIST').map(char => char.charCodeAt(0)), ...le32(4 + sub.length),
+            ...Array.from('INFO').map(char => char.charCodeAt(0)), ...sub];
+        const bytes = Uint8Array.from([
+            ...Array.from('RIFF').map(char => char.charCodeAt(0)), ...le32(4 + list.length),
+            ...Array.from('WAVE').map(char => char.charCodeAt(0)), ...list,
+        ]);
+        expect(parseRawTags(bytes, 'a.wav')).toEqual({ title: '晴天', artist: '周杰伦' });
+    });
+
+    it('reads AIFF ID3 chunk', () => {
+        const id3 = tag([...frame('TIT2', [3, ...utf8('夜曲')])], 4);
+        const chunk = [...Array.from('ID3 ').map(char => char.charCodeAt(0)), ...be32(id3.length), ...Array.from(id3)];
+        const form = [...Array.from('FORM').map(char => char.charCodeAt(0)), ...be32(4 + chunk.length),
+            ...Array.from('AIFF').map(char => char.charCodeAt(0)), ...chunk];
+        expect(parseRawTags(Uint8Array.from(form), 'b.aiff')?.title).toBe('夜曲');
+    });
+
+    it('reads APEv2 tags (ape / wv / tak)', () => {
+        const item = (key: string, value: string): number[] => {
+            const keyBytes = [...utf8(key), 0];
+            const valueBytes = utf8(value);
+            const size = 8 + keyBytes.length + valueBytes.length;
+            return [...le32(size), ...le32(0), ...keyBytes, ...valueBytes];
+        };
+        const items = [...item('Title', '夜空中最亮的星'), ...item('Artist', '逃跑计划')];
+        const tagSize = items.length + 32;
+        const footer = [
+            ...Array.from('APETAGEX').map(char => char.charCodeAt(0)),
+            ...le32(2000), ...le32(tagSize), ...le32(2), ...le32(0), ...le32(0), ...le32(0),
+        ];
+        const bytes = Uint8Array.from([...items, ...footer]);
+        expect(parseRawTags(bytes, 'c.ape')).toEqual({ title: '夜空中最亮的星', artist: '逃跑计划' });
+    });
+
+    it('finds ID3 tucked inside DSF / DFF containers', () => {
+        const id3 = tag([...frame('TIT2', [3, ...utf8('晴天')])], 4);
+        const bytes = Uint8Array.from([0x44, 0x53, 0x44, 0x20, 0, 0, 0, 0, ...Array.from({ length: 24 }, () => 0), ...Array.from(id3)]);
+        expect(parseRawTags(bytes, 'd.dsf')?.title).toBe('晴天');
+    });
+});
