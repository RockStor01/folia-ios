+++ b/test/unit/losslessCheck.test.ts
@@ -0,0 +1,163 @@
+import { describe, expect, it } from 'vitest';
+import { evaluateLosslessBytes } from '@/services/audioQuality/losslessSuspect';
+import {
+    findReportEntry,
+    indexLosslessReport,
+    parseLosslessReport,
+} from '@/services/audioQuality/losslessReport';
+import type { LocalSong } from '@/types';
+
+// test/unit/losslessCheck.test.ts
+// v0.9.17 的真無損校驗：輕量初篩（檔頭／壓縮比／編碼器痕跡）與外部報告配對。
+
+const buildFlac = (options: { sampleRate?: number; bitDepth?: number; totalSamples?: number; md5Zero?: boolean } = {}): Uint8Array => {
+    const sampleRate = options.sampleRate ?? 44100;
+    const bitDepth = options.bitDepth ?? 16;
+    const totalSamples = options.totalSamples ?? sampleRate * 3;
+    const bytes = new Uint8Array(42);
+    bytes.set([0x66, 0x4c, 0x61, 0x43], 0); // fLaC
+    bytes[4] = 0x80; // last block, type 0 = STREAMINFO
+    bytes[5] = 0;
+    bytes[6] = 0;
+    bytes[7] = 34;
+    const depth = bitDepth - 1;
+    bytes[18] = (sampleRate >>> 12) & 0xff;
+    bytes[19] = (sampleRate >>> 4) & 0xff;
+    bytes[20] = ((sampleRate & 0x0f) << 4) | (1 << 1) | ((depth >> 4) & 0x01); // 2 channels
+    bytes[21] = ((depth & 0x0f) << 4) | (Math.floor(totalSamples / 2 ** 32) & 0x0f);
+    bytes[22] = (totalSamples >>> 24) & 0xff;
+    bytes[23] = (totalSamples >>> 16) & 0xff;
+    bytes[24] = (totalSamples >>> 8) & 0xff;
+    bytes[25] = totalSamples & 0xff;
+    if (!options.md5Zero) for (let i = 26; i < 42; i += 1) bytes[i] = i;
+    return bytes;
+};
+
+const rawBytesOfFlac = (sampleRate: number, bitDepth: number, totalSamples: number): number =>
+    totalSamples * 2 * (bitDepth / 8);
+
+const buildWav = (payloadHead: number[]): Uint8Array => {
+    const dataBytes = 44;
+    const bytes = new Uint8Array(44 + dataBytes);
+    const ascii = (text: string, offset: number) => {
+        for (let i = 0; i < text.length; i += 1) bytes[offset + i] = text.charCodeAt(i);
+    };
+    ascii('RIFF', 0);
+    const riffSize = bytes.length - 8;
+    bytes[4] = riffSize & 0xff; bytes[5] = (riffSize >> 8) & 0xff; bytes[6] = (riffSize >> 16) & 0xff; bytes[7] = (riffSize >> 24) & 0xff;
+    ascii('WAVE', 8);
+    ascii('fmt ', 12);
+    bytes.set([16, 0, 0, 0], 16);
+    bytes.set([1, 0, 2, 0], 20); // PCM, 2 channels
+    bytes.set([0x44, 0xac, 0, 0], 24); // 44100
+    bytes.set([0x10, 0xb1, 0x02, 0], 28); // byte rate
+    bytes.set([4, 0, 16, 0], 32); // block align, 16 bit
+    ascii('data', 36);
+    bytes.set([dataBytes & 0xff, 0, 0, 0], 40);
+    bytes.set(payloadHead, 44);
+    return bytes;
+};
+
+describe('evaluateLosslessBytes', () => {
+    it('正常壓縮的 FLAC 不算可疑', () => {
+        const head = buildFlac();
+        const result = evaluateLosslessBytes({
+            head: head.buffer as ArrayBuffer,
+            fileName: '晴天.flac',
+            fileSize: Math.round(rawBytesOfFlac(44100, 16, 132300) * 0.55),
+        });
+        expect(result.verdict).toBe('clean');
+        expect(result.reasons).toHaveLength(0);
+        expect(result.ratio).toBeGreaterThan(0.4);
+    });
+
+    it('壓縮比低到不可能時判可疑', () => {
+        const result = evaluateLosslessBytes({
+            head: buildFlac().buffer as ArrayBuffer,
+            fileName: '夜曲.flac',
+            fileSize: Math.round(rawBytesOfFlac(44100, 16, 132300) * 0.18),
+        });
+        expect(result.verdict).toBe('suspect');
+        expect(result.reasons.join('')).toContain('壓縮比');
+    });
+
+    it('檔裡留著 LAME 字串就判可疑', () => {
+        const head = buildFlac();
+        const merged = new Uint8Array(head.length + 64);
+        merged.set(head, 0);
+        merged.set(Array.from('LAME3.100').map(char => char.charCodeAt(0)), head.length);
+        const result = evaluateLosslessBytes({
+            head: merged.buffer as ArrayBuffer,
+            fileName: 'a.flac',
+            fileSize: Math.round(rawBytesOfFlac(44100, 16, 132300) * 0.55),
+        });
+        expect(result.verdict).toBe('suspect');
+        expect(result.encoder).toMatch(/LAME/i);
+    });
+
+    it('FLAC 音訊 MD5 全零時判可疑', () => {
+        const result = evaluateLosslessBytes({
+            head: buildFlac({ md5Zero: true }).buffer as ArrayBuffer,
+            fileName: 'b.flac',
+            fileSize: Math.round(rawBytesOfFlac(44100, 16, 132300) * 0.55),
+        });
+        expect(result.verdict).toBe('suspect');
+        expect(result.reasons.join('')).toContain('MD5');
+    });
+
+    it('WAV 的 data 區開始是 MP3 同步字就判可疑', () => {
+        const wav = buildWav([0xff, 0xfb, 0x90, 0x00]);
+        const result = evaluateLosslessBytes({
+            head: wav.buffer as ArrayBuffer,
+            fileName: 'c.wav',
+            fileSize: wav.length,
+        });
+        expect(result.verdict).toBe('suspect');
+        expect(result.reasons.join('')).toContain('MP3');
+    });
+
+    it('小於 16 bytes 的位元組由呼叫端擋掉，這裡對空檔寬鬆處理', () => {
+        const result = evaluateLosslessBytes({ head: new ArrayBuffer(8), fileName: 'empty.flac', fileSize: 0 });
+        expect(result.verdict).toBe('unknown');
+    });
+});
+
+describe('losslessReport', () => {
+    const text = JSON.stringify({
+        version: 1,
+        generatedAt: '2026-11-26T00:00:00Z',
+        tool: 'lossless_report.py',
+        entries: [
+            { name: '晴天.flac', size: 30_000_000, verdict: 'trueLossless', cutoffHz: 21000, nyquistHz: 22050 },
+            { name: '夜曲.flac', size: 20_000_000, verdict: 'fakeLossless', cutoffHz: 16000, nyquistHz: 22050, notes: ['高頻斷崖'] },
+            { name: 'bad', verdict: 'whatever' },
+        ],
+    });
+
+    const song = (fileName: string, fileSize: number): LocalSong => ({
+        id: fileName,
+        fileName,
+        fileSize,
+        title: fileName,
+        importedMetadata: { artistNames: ['周杰倫'], albumName: '范特西' },
+    }) as unknown as LocalSong;
+
+    it('解析報告並把未知判定降級成 unknown', () => {
+        const report = parseLosslessReport(text);
+        expect(report?.entries).toHaveLength(3);
+        expect(report?.entries[2].verdict).toBe('unknown');
+    });
+
+    it('無法解析的內容回 null', () => {
+        expect(parseLosslessReport('not json')).toBeNull();
+        expect(parseLosslessReport('{"foo":1}')).toBeNull();
+    });
+
+    it('用檔名配對，同名但大小差很多時不配', () => {
+        indexLosslessReport(parseLosslessReport(text));
+        expect(findReportEntry(song('晴天.flac', 30_000_000))?.verdict).toBe('trueLossless');
+        expect(findReportEntry(song('/music/晴天.flac', 30_000_100))?.verdict).toBe('trueLossless');
+        expect(findReportEntry(song('晴天.flac', 12_000_000))).toBeUndefined();
+        expect(findReportEntry(song('不存在.flac', 1))).toBeUndefined();
+    });
+});
