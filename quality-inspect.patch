+// src/services/audioQuality/losslessSuspect.ts
+// 「假無損」的輕量初篩（v0.9.17）。
+//
+// 跟 measureLocalQuality 的分工：
+//   - 這裡只讀檔頭＋檔尾共幾百 KB，不解碼、不做 FFT，一首幾十毫秒，所以可以對整個曲庫跑一遍；
+//   - 真正的頻譜量測（解 20 秒、量截止點）還是走 measureLocalQuality，慢但準。
+//
+// 這支模組的結論只有「未見可疑／可疑／無法判斷」三種，**永遠不會判死**，
+// 因為壓縮比與編碼器字串都只是間接證據：真正的結論要嘛來自頻譜，要嘛來自 PC 端產生的 lossless-report.json。
+
+import type { LocalSong } from '../../types';
+import { getLocalSongHeaderBytes, getLocalSongRangeBytes } from '../localMusicService';
+import { probeContainer, type ContainerProbe } from './qualityProbe';
+
+/** 檔頭讀 512 KB：少數 flac 前面壓著大封面，64 KB 會讀不到 STREAMINFO。 */
+const HEAD_BYTES = 512 * 1024;
+/** 檔尾讀 256 KB：APEv2 footer、DSF 的內嵌 ID3 都貼在後面。 */
+const TAIL_BYTES = 256 * 1024;
+
+export type LosslessSuspectVerdict = 'clean' | 'suspect' | 'unknown';
+
+export interface LosslessSuspect {
+    verdict: LosslessSuspectVerdict;
+    /** 可疑證據，按嚴重度排；介面上取第一條顯示。 */
+    reasons: string[];
+    /** 只提到「偏低」但不構成可疑的觀察，不影響 verdict。 */
+    notes: string[];
+    /** 實際壓縮比（檔案大小 ÷ 未壓縮 PCM 大小）；量不到時為 null。 */
+    ratio: number | null;
+    /** 檔頭／檔尾掃到的轉檔工具痕跡。 */
+    encoder: string | null;
+}
+
+const EMPTY: LosslessSuspect = { verdict: 'unknown', reasons: [], notes: [], ratio: null, encoder: null };
+
+/**
+ * 已知的轉檔工具字串。
+ * strong：有損編碼器的名字，出現在無損檔裡幾乎只能是「mp3／aac 轉 flac」；
+ * weak：通用容器工具（例如用 ffmpeg 把 WAV 轉 FLAC 也會留 Lavf），本身不代表有損，只寫成備註。
+ */
+const ENCODER_MARKERS: Array<{ pattern: RegExp; label: string; strength: 'strong' | 'weak' }> = [
+    { pattern: /libmp3lame|lame3\.|lame\d|\blame\b/i, label: 'LAME（MP3 編碼器）', strength: 'strong' },
+    { pattern: /libfaac|\bfaac\b|faac\s?\d/i, label: 'FAAC（AAC 編碼器）', strength: 'strong' },
+    { pattern: /qaac|quicktime\s?aac/i, label: 'qaac（AAC 編碼器）', strength: 'strong' },
+    { pattern: /nero\s?aac|helix|besweet|\bgogo\b/i, label: 'Nero／Helix／BeSweet 轉檔工具', strength: 'strong' },
+    { pattern: /libavcodec|lavf\d|l\\avf|ffmpeg/i, label: 'FFmpeg／libavcodec', strength: 'weak' },
+    { pattern: /tmpgenc|\bavs\b/i, label: 'TMPGEnc／AVS 轉檔工具', strength: 'weak' },
+];
+
+const latin = (bytes: Uint8Array): string => {
+    let text = '';
+    // 逐段 decode 避免超大字串；512 KB 一次 decode 在行動端也可接受。
+    const chunk = 64 * 1024;
+    for (let offset = 0; offset < bytes.length; offset += chunk) {
+        text += String.fromCharCode(...bytes.subarray(offset, Math.min(offset + chunk, bytes.length)));
+    }
+    return text;
+};
+
+const findEncoderMarker = (text: string): { label: string; raw: string; strength: 'strong' | 'weak' } | null => {
+    for (const { pattern, label, strength } of ENCODER_MARKERS) {
+        const match = text.match(pattern);
+        if (match) return { label, raw: match[0], strength };
+    }
+    return null;
+};
+
+/** WAV／AIFF 裡塞的其實是 MP3 位元流：找到 data／SSND 區塊，看它的第一個 frame 是否有 MPEG 同步字。 */
+const mp3StreamInsidePcmContainer = (bytes: Uint8Array, marker: 'data' | 'SSND'): string | null => {
+    const limit = Math.min(bytes.length - 12, 8 * 1024 * 1024);
+    for (let i = 8; i < limit; i += 1) {
+        if (
+            bytes[i] === marker.charCodeAt(0)
+            && bytes[i + 1] === marker.charCodeAt(1)
+            && bytes[i + 2] === marker.charCodeAt(2)
+            && bytes[i + 3] === marker.charCodeAt(3)
+        ) {
+            const start = i + 8 + (marker === 'SSND' ? 8 : 0);
+            if (start + 2 >= bytes.length) return null;
+            const b0 = bytes[start];
+            const b1 = bytes[start + 1];
+            if (b0 === 0xff && (b1 & 0xe0) === 0xe0) return 'MPEG 音訊同步字';
+            if (b0 === 0x49 && b1 === 0x44 && bytes[start + 2] === 0x33) return 'ID3 標頭';
+            return null;
+        }
+    }
+    return null;
+};
+
+/** FLAC 的 STREAMINFO 尾端 16 bytes 是未壓縮音訊的 MD5；全零代表沒收完／串流寫入。 */
+const flacHasEmptyAudioMd5 = (bytes: Uint8Array): boolean => {
+    if (bytes.length < 42) return false;
+    if (bytes[0] !== 0x66 || bytes[1] !== 0x4c || bytes[2] !== 0x61 || bytes[3] !== 0x43) return false;
+    for (let i = 26; i < 42; i += 1) if (bytes[i] !== 0) return false;
+    return true;
+};
+
+const ratioOf = (fileSize: number, probe: ContainerProbe | null): number | null => {
+    if (!fileSize || !probe || !probe.durationSec || !probe.sampleRate) return null;
+    const channels = probe.channels || 2;
+    const bits = probe.bitDepth || 16;
+    const rawBytes = probe.durationSec * probe.sampleRate * channels * (bits / 8);
+    if (!Number.isFinite(rawBytes) || rawBytes <= 0) return null;
+    return fileSize / rawBytes;
+};
+
+const ratioMessage = (ratio: number, codec: string): { suspect: string | null; note: string | null } => {
+    const percent = `${(ratio * 100).toFixed(0)}%`;
+    // WAV／AIFF／DSD 是不壓縮的，正常應該接近 100%；低太多代表音訊被截短或塞的是壓縮位元流。
+    if (codec === 'wav' || codec === 'aiff' || codec === 'aifc' || codec === 'dsd') {
+        if (ratio < 0.6) return { suspect: `未壓縮容器的實際資料只佔 ${percent}，音訊疑似被截短或替換`, note: null };
+        if (ratio < 0.9) return { suspect: null, note: `實際資料佔 ${percent}，比標準未壓縮檔小` };
+        return { suspect: null, note: null };
+    }
+    // FLAC／ALAC／APE／WavPack 的壓縮比通常 0.4～0.8；掉到 0.28 以下幾乎不可能是原生無損。
+    if (ratio < 0.28) return { suspect: `壓縮比只有 ${percent}，原生無損壓不到這麼小`, note: null };
+    if (ratio < 0.4) return { suspect: null, note: `壓縮比 ${percent} 偏低，但仍在無損可能範圍` };
+    if (ratio > 1.02) return { suspect: `檔案比未壓縮的 PCM 還大（${percent}），可能夾了大量非音訊資料`, note: null };
+    return { suspect: null, note: null };
+};
+
+/**
+ * 純函式版：手上已經有檔頭／檔尾位元組時直接算，不碰檔案系統（單元測試走這條）。
+ */
+export const evaluateLosslessBytes = (
+    options: { head: ArrayBuffer; tail?: ArrayBuffer | null; fileName: string; fileSize: number },
+): LosslessSuspect => {
+    const { head, tail, fileName, fileSize } = options;
+    const headBytes = new Uint8Array(head);
+    const tailBytes = tail ? new Uint8Array(tail) : null;
+    const reasons: string[] = [];
+    const notes: string[] = [];
+    const probe = probeContainer(head);
+    const extension = (fileName.match(/\.([a-z0-9]+)$/i)?.[1] ?? '').toLowerCase();
+
+    const marker = findEncoderMarker(latin(headBytes) + (tailBytes ? latin(tailBytes) : ''));
+    const encoder = marker ? marker.raw : null;
+    if (marker && marker.strength === 'strong') {
+        reasons.push(`檔案裡有「${marker.label}」的編碼器字串（${marker.raw}），通常是轉檔留下來的`);
+    } else if (marker) {
+        notes.push(`有「${marker.label}」的工具痕跡，但這類工具也可能只是無損轉無損`);
+    }
+
+    if (extension === 'flac' && flacHasEmptyAudioMd5(headBytes)) {
+        reasons.push('FLAC 的音訊指紋（MD5）是空的，通常是邊轉邊寫、沒寫完的檔案');
+    }
+
+    if (extension === 'wav') {
+        const inside = mp3StreamInsidePcmContainer(headBytes, 'data');
+        if (inside) reasons.push(`這個 WAV 的資料區其實是 MP3 位元流（開頭是${inside}）`);
+    }
+    if (extension === 'aif' || extension === 'aiff' || extension === 'aifc') {
+        const inside = mp3StreamInsidePcmContainer(headBytes, 'SSND');
+        if (inside) reasons.push(`這個 AIFF 的資料區其實是 MP3 位元流（開頭是${inside}）`);
+    }
+
+    if (!probe) {
+        return { verdict: reasons.length ? 'suspect' : 'unknown', reasons, notes, ratio: null, encoder };
+    }
+    if (!probe.sampleRate) notes.push('檔頭讀不到取樣率');
+    if (probe.bitDepth > 32) notes.push(`位深 ${probe.bitDepth} 不合理`);
+
+    const ratio = ratioOf(fileSize, probe);
+    if (ratio !== null) {
+        const message = ratioMessage(ratio, probe.codec);
+        if (message.suspect) reasons.push(message.suspect);
+        if (message.note) notes.push(message.note);
+    }
+
+    return {
+        verdict: reasons.length ? 'suspect' : 'clean',
+        reasons,
+        notes,
+        ratio,
+        encoder,
+    };
+};
+
+/**
+ * 對一首歌做輕量初篩。讀不到檔案（權限掉了、檔案搬走）回 `unknown`，呼叫端不必分辨原因。
+ */
+export const analyzeLosslessSuspect = async (song: LocalSong): Promise<LosslessSuspect> => {
+    const fileSize = Math.max(0, song.fileSize || 0);
+
+    let head: ArrayBuffer | null = null;
+    try {
+        head = await getLocalSongHeaderBytes(song, HEAD_BYTES);
+    } catch (error) {
+        console.warn('[LosslessSuspect] header read failed:', song.fileName, error);
+    }
+    if (!head || head.byteLength < 16) return EMPTY;
+    let tail: ArrayBuffer | null = null;
+    if (fileSize > HEAD_BYTES + TAIL_BYTES) {
+        try {
+            const bytes = await getLocalSongRangeBytes(song, fileSize - TAIL_BYTES, TAIL_BYTES);
+            if (bytes && bytes.byteLength > 0) tail = bytes;
+        } catch {
+            tail = null;
+        }
+    }
+
+    return evaluateLosslessBytes({ head, tail, fileName: song.fileName, fileSize });
+};
