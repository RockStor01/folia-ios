+import { describe, expect, it } from 'vitest';
+import { decodeLyricBytes, extractEmbeddedLyrics } from '../../src/services/localSongFileLyrics';
+
+// 這支只測「檔案裡的字」這一半：連結模式的歌詞要嘛是同資料夾的 .lrc，要嘛是音檔內嵌的
+// USLT／Vorbis LYRICS／©lyr。原生只負責列檔案與串 bytes，解析全在 JS，所以這裡可以逐位元組驗。
+
+const utf16 = (text: string): number[] => {
+    const out: number[] = [0xFF, 0xFE];
+    for (const char of text) {
+        const code = char.codePointAt(0)!;
+        out.push(code & 0xFF, (code >> 8) & 0xFF);
+    }
+    return out;
+};
+
+// ID3v2.3 的長度是普通 32-bit big-endian（v2.4 才是 synchsafe），這裡照真實檔案的寫法造。
+const id3Tag = (frames: number[]): Uint8Array => {
+    const size = frames.length;
+    return new Uint8Array([
+        0x49, 0x44, 0x33, 0x03, 0x00, 0x00, // ID3v2.3
+        (size >> 24) & 0xFF, (size >> 16) & 0xFF, (size >> 8) & 0xFF, size & 0xFF,
+        ...frames,
+    ]);
+};
+
+const id3Frame = (id: string, body: number[]): number[] => [
+    ...[...id].map(char => char.charCodeAt(0)),
+    (body.length >> 24) & 0xFF, (body.length >> 16) & 0xFF, (body.length >> 8) & 0xFF, body.length & 0xFF,
+    0x00, 0x00,
+    ...body,
+];
+
+describe('extractEmbeddedLyrics', () => {
+    it('讀 MP3 的 ID3v2.4 USLT（synchsafe 長度）', () => {
+        const lyrics = '[00:00.00]v24 的歌詞';
+        const body = [0x03, ...'eng'.split('').map(c => c.charCodeAt(0)), 0x00, ...Array.from(new TextEncoder().encode(lyrics))];
+        const frame = id3Frame('USLT', body);
+        const size = frame.length;
+        const tag = new Uint8Array([
+            0x49, 0x44, 0x33, 0x04, 0x00, 0x00,
+            (size >> 21) & 0x7F, (size >> 14) & 0x7F, (size >> 7) & 0x7F, size & 0x7F,
+            ...frame,
+        ]);
+        expect(extractEmbeddedLyrics(tag, 'song.mp3')).toBe(lyrics);
+    });
+
+    it('讀 MP3 的 ID3 USLT（UTF-16）', () => {
+        const frame = id3Frame('USLT', [0x01, ...'eng'.split('').map(c => c.charCodeAt(0)), 0x00, 0x00, ...utf16('[00:01.00]第一句\n[00:05.00]第二句')]);
+        const bytes = id3Tag(frame);
+        const text = extractEmbeddedLyrics(bytes, 'song.mp3');
+        expect(text).toBe('[00:01.00]第一句\n[00:05.00]第二句');
+    });
+
+    it('讀 MP3 的 ID3 USLT（UTF-8，有描述欄位）', () => {
+        const body = [0x03, ...'chi'.split('').map(c => c.charCodeAt(0)), ...'描述'.split('').flatMap(c => [0xE6, 0x8F, 0x8F]), 0x00];
+        const lyrics = [...'[00:00.00]測試歌詞'].map(char => {
+            const bytes: number[] = [];
+            const encoded = new TextEncoder().encode(char);
+            encoded.forEach(byte => bytes.push(byte));
+            return bytes;
+        }).flat();
+        const frame = id3Frame('USLT', [...body, ...lyrics]);
+        const text = extractEmbeddedLyrics(id3Tag(frame), 'song.mp3');
+        expect(text).toBe('[00:00.00]測試歌詞');
+    });
+
+    it('讀 FLAC 的 Vorbis LYRICS 註解', () => {
+        const comment = new TextEncoder().encode('LYRICS=[00:02.00]從檔案裡來的歌詞');
+        const vendor = 'reference libFLAC';
+        const body: number[] = [
+            vendor.length & 0xFF, (vendor.length >> 8) & 0xFF, (vendor.length >> 16) & 0xFF, 0,
+            ...[...vendor].map(c => c.charCodeAt(0)),
+            1, 0, 0, 0, // comment count（little-endian）
+            comment.length & 0xFF, (comment.length >> 8) & 0xFF, (comment.length >> 16) & 0xFF, (comment.length >>> 24) & 0xFF,
+            ...Array.from(comment),
+        ];
+        const blockSize = body.length;
+        const bytes = new Uint8Array([
+            0x66, 0x4C, 0x61, 0x43, // fLaC
+            0x84, (blockSize >> 16) & 0xFF, (blockSize >> 8) & 0xFF, blockSize & 0xFF, // last block, type 4
+            ...body,
+        ]);
+        expect(extractEmbeddedLyrics(bytes, 'song.flac')).toBe('[00:02.00]從檔案裡來的歌詞');
+    });
+
+    it('讀 M4A 的 ©lyr', () => {
+        const text = new TextEncoder().encode('m4a lyric line');
+        const dataSize = 8 + 8 + text.length;
+        const bytes = new Uint8Array([
+            0x00, 0x00, 0x00, 0x00, // 前面一點填充
+            0xA9, 0x6C, 0x79, 0x72, // ©lyr
+            0x00, 0x00, 0x00, 0x08, // 這個 box 的長度（不影響解析）
+            0x00, 0x00, 0x00, (dataSize & 0xFF),
+            0x64, 0x61, 0x74, 0x61, // data
+            0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
+            ...Array.from(text),
+        ]);
+        expect(extractEmbeddedLyrics(bytes, 'song.m4a')).toBe('m4a lyric line');
+    });
+
+    it('沒有歌詞的檔案回 null', () => {
+        expect(extractEmbeddedLyrics(new Uint8Array([0x00, 0x01, 0x02, 0x03]), 'song.mp3')).toBeNull();
+    });
+});
+
+describe('decodeLyricBytes', () => {
+    it('UTF-8 原樣解出', () => {
+        expect(decodeLyricBytes(new TextEncoder().encode('[00:00.00]繁體歌詞'))).toBe('[00:00.00]繁體歌詞');
+    });
+
+    it('GBK 的 .lrc 不會變亂碼', () => {
+        // 「[00:00.00]该死的温柔」用 GBK 編碼的位元組（老盤常見，檔案本身沒有宣告編碼）
+        const gbk = new Uint8Array([
+            0x5B, 0x30, 0x30, 0x3A, 0x30, 0x30, 0x2E, 0x30, 0x30, 0x5D,
+            0xB8, 0xC3, 0xCB, 0xC0, 0xB5, 0xC4, 0xCE, 0xC2, 0xC8, 0xE1,
+        ]);
+        expect(decodeLyricBytes(gbk)).toBe('[00:00.00]该死的温柔');
+    });
+});
