diff --git a/src/hooks/useLocalAudioImport.ts b/src/hooks/useLocalAudioImport.ts
new file mode 100644
index 0000000..b50d19d
--- /dev/null
+++ b/src/hooks/useLocalAudioImport.ts
@@ -0,0 +1,67 @@
+// src/hooks/useLocalAudioImport.ts
+// 「從檔案匯入」在每個首頁 suite 裡都一樣：一顆隱藏的 input、一個 busy 旗標、一個 handler。
+// 抽出來是因為 Bravais 空牆、Grid3D 空狀態、TUI 清單都要同一件事，分散寫三份遲早對不上。
+
+import { useCallback, useRef, useState } from 'react';
+import { importAudioFiles } from '../services/localMusicService';
+
+export interface LocalAudioImportController {
+    /** 要掛在 input 上的 ref（input 必須真的在 DOM 裡）。 */
+    inputRef: React.RefObject<HTMLInputElement | null>;
+    importing: boolean;
+    /** 匯入進度（第 done 首／共 total 首）；沒在匯入時是 null。 */
+    progress: { done: number; total: number } | null;
+    /** 開系統選檔器（iOS 走「檔案」App，安卓走 SAF 文件選擇器）。 */
+    openPicker: () => void;
+    /** 給 <input type="file" multiple onChange> 用的處理函式。 */
+    handleFiles: (files: FileList | null) => void;
+    lastResult: { count: number; failed: number; skipped: number } | null;
+}
+
+export const useLocalAudioImport = (): LocalAudioImportController => {
+    const inputRef = useRef<HTMLInputElement | null>(null);
+    const [importing, setImporting] = useState(false);
+    const [progress, setProgress] = useState<{ done: number; total: number } | null>(null);
+    const [lastResult, setLastResult] = useState<LocalAudioImportController['lastResult']>(null);
+    const busyRef = useRef(false);
+
+    const openPicker = useCallback(() => {
+        inputRef.current?.click();
+    }, []);
+
+    const handleFiles = useCallback((files: FileList | null) => {
+        // FileList 是活的：清 value 之前先抓成陣列，否則清完就空了。
+        const picked = Array.from(files ?? []);
+        if (inputRef.current) inputRef.current.value = '';
+        if (!picked.length || busyRef.current) return;
+
+        busyRef.current = true;
+        setImporting(true);
+        setProgress({ done: 0, total: picked.length });
+        void (async () => {
+            try {
+                // 進度每五首刷一次就好：每首刷新等於讓整面牆跟著重繪兩千次，反而更卡。
+                const result = await importAudioFiles(picked, {
+                    onProgress: info => {
+                        if (info.done === 0 || info.done === info.total || info.done % 5 === 0) {
+                            setProgress({ done: info.done, total: info.total });
+                        }
+                    },
+                });
+                setLastResult({ count: result.songs.length, failed: result.failed.length, skipped: result.skipped });
+                if (result.failed.length > 0) {
+                    console.warn('[LocalImport] Some files could not be imported:', result.failed);
+                }
+            } catch (error) {
+                console.error('[LocalImport] Import failed', error);
+                setLastResult({ count: 0, failed: picked.length, skipped: 0 });
+            } finally {
+                busyRef.current = false;
+                setImporting(false);
+                setProgress(null);
+            }
+        })();
+    }, []);
+
+    return { inputRef, importing, progress, openPicker, handleFiles, lastResult };
+};
