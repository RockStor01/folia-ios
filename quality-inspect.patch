+ * 修一個標籤字串。UTF-8 重解、ID3 專用 GBK 修法、GBK 重解、Big5 重解都當候選，
+ * 用「像人話」的分數挑最高的一個；分數沒有明顯變好就原樣返回。
+ * 正常文字（含英數、正常中日韓、重音符號）不會被動到。
+ */
+export const repairTagText = (input: string | null | undefined): string => {
+    if (!input) return input ?? '';
+    const text = input.trim();
+    if (!text) return text;
+    // 沒有高位字元（全 ASCII）就沒得修。
+    if (!/[\u0080-\u00ff]/u.test(text)) return text;
+    // 已經正常的中文（沒有壞字元）就不必再猜。
+    if (!looksBroken(text) && cjkProfile(text).ratio >= 0.5) return text;
