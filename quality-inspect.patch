+
+const readUint32LE = (bytes: Uint8Array, offset: number): number => (
+    (bytes[offset] & 0xFF)
+    + ((bytes[offset + 1] & 0xFF) << 8)
+    + ((bytes[offset + 2] & 0xFF) << 16)
+    + ((bytes[offset + 3] & 0xFF) * 0x1000000)
+);
+
+const decodeId3Text = (bytes: Uint8Array): string => {
+    // 0 = ISO-8859-1（實務上常是 GBK／Big5），1 = UTF-16（帶 BOM），2 = UTF-16BE，3 = UTF-8。
+    const encoding = bytes[0];
+    const body = bytes.subarray(1);
+    if (encoding === 3) return decodeWith(body, 'utf-8') ?? decodeLyricBytes(body);
+    if (encoding === 1 || encoding === 2) {
+        const label = encoding === 1 ? 'utf-16' : 'utf-16be';
+        return decodeWith(body, label) ?? decodeWith(body, 'utf-16le') ?? '';
+    }
+    const latin = decodeWith(body, 'latin1') ?? '';
+    // 西歐字元以外就當成 CJK 編碼處理：純英文歌詞走這條也得到同樣結果。
+    if (!/[^\x00-\xFF]/.test(latin)) {
+        const text = decodeLyricBytes(body);
+        return text;
+    }
+    return latin;
+};
+
+/** 從 ID3v2 標籤裡找 USLT（未同步歌詞）。 */
+const extractId3Uslt = (bytes: Uint8Array): string | null => {
+    if (bytes.length < 10) return null;
+    const version = bytes[3];
+    // v2.3（老盤最常見）的長度是普通 32-bit big-endian，v2.4 才是 synchsafe。
+    const tagSize = version >= 4 ? readSynchsafe(bytes, 6) : readUint32(bytes, 6);
+    const tagEnd = Math.min(bytes.length, 10 + tagSize);
+    let offset = 10;
+    if ((bytes[5] & 0x40) !== 0) offset += 4; // extended header
+    while (offset + 10 <= tagEnd) {
+        const id = String.fromCharCode(bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
+        if (!/^[\x20-\x7E]{4}$/.test(id)) break;
+        const size = version >= 4 ? readSynchsafe(bytes, offset + 4) : readUint32(bytes, offset + 4);
+        const dataStart = offset + 10;
+        const dataEnd = Math.min(tagEnd, dataStart + size);
+        if (size <= 0 || dataEnd <= dataStart) break;
+        if (id === 'USLT') {
+            const body = bytes.subarray(dataStart, dataEnd);
+            // encoding(1) + language(3) + content descriptor（以終止符結束）+ 歌詞本體
+            const enc = body[0];
+            const terminatorLength = (enc === 1 || enc === 2) ? 2 : 1;
+            let cursor = 4;
+            while (cursor + terminatorLength <= body.length) {
+                const isTerminator = terminatorLength === 2
+                    ? body[cursor] === 0 && body[cursor + 1] === 0
+                    : body[cursor] === 0;
+                cursor += isTerminator ? terminatorLength : 1;
+                if (isTerminator) break;
+            }
+            const text = decodeId3Text(new Uint8Array([enc, ...body.subarray(cursor)]));
+            const trimmed = text.trim();
+            if (trimmed) return trimmed;
+        }
+        offset = dataStart + size;
+    }
+    return null;
+};
+
+/** FLAC：VORBIS_COMMENT 裡的 LYRICS／UNSYNCEDLYRICS。 */
+const extractFlacLyrics = (bytes: Uint8Array): string | null => {
+    if (bytes.length < 8) return null;
+    let offset = 4; // "fLaC"
+    while (offset + 4 <= bytes.length) {
+        const header = bytes[offset];
+        const isLast = (header & 0x80) !== 0;
+        const type = header & 0x7F;
+        const size = (bytes[offset + 1] << 16) | (bytes[offset + 2] << 8) | bytes[offset + 3];
+        const start = offset + 4;
+        const end = Math.min(bytes.length, start + size);
+        if (type === 4) {
+            const vendorLength = readUint32LE(bytes, start);
+            let cursor = start + 4 + vendorLength;
+            if (cursor + 4 > end) return null;
+            const count = readUint32LE(bytes, cursor);
+            cursor += 4;
+            for (let index = 0; index < count && cursor + 4 <= end; index += 1) {
+                const length = readUint32LE(bytes, cursor);
+                cursor += 4;
+                if (cursor + length > end) break;
+                const entry = decodeWith(bytes.subarray(cursor, cursor + length), 'utf-8')
+                    ?? decodeLyricBytes(bytes.subarray(cursor, cursor + length));
+                const equals = entry.indexOf('=');
+                if (equals > 0) {
+                    const key = entry.slice(0, equals).trim().toUpperCase();
+                    if (key === 'LYRICS' || key === 'UNSYNCEDLYRICS' || key === 'UNSYNCED LYRICS') {
+                        const value = entry.slice(equals + 1).replace(/\\n/g, '\n').trim();
+                        if (value) return value;
+                    }
+                }
+                cursor += length;
+            }
+            return null;
+        }
+        if (isLast) break;
+        offset = start + size;
+    }
+    return null;
+};
+
+/** M4A：©lyr 這顆資料 atom（內容是 UTF-8）。 */
+const extractM4aLyrics = (bytes: Uint8Array): string | null => {
+    const marker = [0xA9, 0x6C, 0x79, 0x72]; // '©lyr'
+    for (let index = 0; index + 32 < bytes.length; index += 1) {
+        if (bytes[index] !== marker[0] || bytes[index + 1] !== marker[1]
+            || bytes[index + 2] !== marker[2] || bytes[index + 3] !== marker[3]) continue;
+        // 之後找最近的一個 'data' box，payload 就是歌詞。
+        for (let scan = index + 4; scan + 16 < bytes.length; scan += 4) {
+            if (bytes[scan] !== 0x64 || bytes[scan + 1] !== 0x61 || bytes[scan + 2] !== 0x74 || bytes[scan + 3] !== 0x61) continue;
+            const size = readUint32(bytes, scan - 4);
+            const payloadStart = scan + 12; // 'data' + version/flags(4) + type(4)
+            const payloadEnd = Math.min(bytes.length, scan - 4 + size);
+            if (payloadEnd > payloadStart) {
+                const text = decodeWith(bytes.subarray(payloadStart, payloadEnd), 'utf-8') ?? decodeLyricBytes(bytes.subarray(payloadStart, payloadEnd));
+                const trimmed = text.trim();
+                if (trimmed) return trimmed;
+            }
+            break;
+        }
+    }
+    return null;
+};
+
+/** 依副檔名挑解析器；認不得就回 null（不是錯誤，只是沒有內嵌歌詞）。 */
+export const extractEmbeddedLyrics = (bytes: Uint8Array, fileName: string): string | null => {
+    const lower = fileName.toLowerCase();
+    try {
+        if (lower.endsWith('.mp3') || bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) {
+            return extractId3Uslt(bytes);
+        }
+        if (lower.endsWith('.flac') || (bytes[0] === 0x66 && bytes[1] === 0x4C && bytes[2] === 0x61 && bytes[3] === 0x43)) {
+            return extractFlacLyrics(bytes);
+        }
+        if (lower.endsWith('.m4a') || lower.endsWith('.mp4') || lower.endsWith('.alac')) {
+            return extractM4aLyrics(bytes);
+        }
+    } catch (error) {
+        console.warn('[FileLyrics] embedded parse failed', error);
+    }
+    return null;
+};
+
+const dirOf = (path: string): string => {
+    const slash = Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\'));
+    return slash >= 0 ? path.slice(0, slash) : path;
+};
+
+const stripExtension = (name: string): string => name.replace(/\.([a-z0-9]{1,6})$/i, '');
+
+const baseNameOf = (filePath: string): string => {
+    const slash = Math.max(filePath.lastIndexOf('/'), filePath.lastIndexOf('\\'));
+    return filePath.slice(slash + 1);
+};
+
+/** 同資料夾歌詞檔的比對順序：track.lrc > track.mp3.lrc > track.vtt，大小寫不分。 */
+const pickSidecar = (
+    directory: string,
+    audioName: string,
+): { name: string; path: string; format?: 'vtt' } | null => {
+    const entries = listNativeLyrics(directory);
+    if (entries.length === 0) return null;
+    const base = stripExtension(audioName).toLowerCase();
+    for (const extension of LYRIC_PREFERENCE) {
+        const candidates = [
+            `${base}.${extension}`,
+            `${audioName.toLowerCase()}.${extension}`,
+        ];
+        for (const candidate of candidates) {
+            const hit = entries.find(entry => entry.name.toLowerCase() === candidate);
+            if (hit) return { name: hit.name, path: hit.path, format: extension === 'vtt' ? 'vtt' : undefined };
+        }
+    }
+    return null;
+};
+
+const fetchText = async (url: string): Promise<Uint8Array | null> => {
+    try {
+        const response = await fetch(url);
+        if (!response.ok) return null;
+        return new Uint8Array(await response.arrayBuffer());
+    } catch (error) {
+        console.warn('[FileLyrics] fetch failed', error);
+        return null;
+    }
+};
+
+/** 讀一首連結歌曲的歌詞：先找旁邊的檔案，再試音檔內嵌。 */
+export const readLinkedSongLyrics = async (song: LocalSong): Promise<FileLyricsPayload | null> => {
+    if (!isLinkedStorageSupported() || !song.linkedFilePath) return null;
+    const path = song.linkedFilePath;
+    const audioName = song.fileName || baseNameOf(path);
+
+    const sidecar = pickSidecar(dirOf(path), audioName);
+    if (sidecar) {
+        const url = nativeAudioUrl(sidecar.path);
+        if (url) {
+            const bytes = await fetchText(url);
+            if (bytes) {
+                const content = decodeLyricBytes(bytes).trim();
+                if (content) {
+                    return {
+                        localLyrics: { content, format: sidecar.format },
+                        origin: `sidecar:${sidecar.name}`,
+                    };
+                }
+            }
+        }
+    }
+
+    // 內嵌歌詞在檔案前段（ID3 標籤總在最前面），讀 2 MB 就夠，不必整首拉進來。
+    const head = await fetchNativeRange(path, Math.min(Math.max(song.fileSize || 0, 64 * 1024), 2 * 1024 * 1024), 0);
+    if (!head) return null;
+    const embedded = extractEmbeddedLyrics(new Uint8Array(head), audioName);
+    if (embedded) {
+        return { embeddedLyrics: embedded, origin: 'embedded' };
+    }
+    return null;
+};
+
+/**
+ * 把讀到的歌詞寫回這首歌並通知曲庫刷新；已經有歌詞（或已匹配線上歌詞）就直接回 null。
+ * 只給連結模式的歌用：其他歌本來就在匯入時解析過。
+ */
+export const ensureLinkedSongLyrics = async (song: LocalSong): Promise<LocalSong | null> => {
+    if (!song.linkedFilePath) return null;
+    const hasLyrics = Boolean(
+        (song.hasLocalLyrics && song.localLyricsContent)
+        || (song.hasEmbeddedLyrics && song.embeddedLyricsContent)
+        || song.matchedLyrics
+        || song.markedPureMusic,
+    );
+    if (hasLyrics) return null;
+
+    const payload = await readLinkedSongLyrics(song);
+    if (!payload) return null;
+
+    const updated: LocalSong = payload.localLyrics
+        ? {
+            ...song,
+            hasLocalLyrics: true,
+            localLyricsContent: payload.localLyrics.content,
+            localLyricsFormat: payload.localLyrics.format,
+            localLyricsOrigin: 'sidecar',
+        }
+        : {
+            ...song,
+            hasEmbeddedLyrics: true,
+            embeddedLyricsContent: payload.embeddedLyrics,
+        };
+
+    try {
+        await putLocalSong(updated);
+        window.dispatchEvent(new CustomEvent(LOCAL_MUSIC_UPDATED_EVENT));
+    } catch (error) {
+        console.warn('[FileLyrics] save failed', error);
+        return null;
+    }
+    console.info(`[FileLyrics] hydrated ${song.fileName} from ${payload.origin}`);
+    return updated;
+};
