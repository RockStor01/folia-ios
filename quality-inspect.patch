   "releaseNotes": {
+    "v0_9_9": {
+      "intro": "0.9.9 brings lyrics to local songs on the car unit: the lyric page now reads them from the files — a .lrc next to the track, or lyrics embedded in the audio (ID3 USLT, FLAC LYRICS, M4A ©lyr). This is how Aurora shows lyrics.",
+      "fileLyrics": {
+        "title": "Lyrics read straight from the file (like Aurora)",
+        "description": "Linked-mode tracks stay where they are, so the lyric page used to be empty: WebView cannot scan folders and the native probe only returned title and cover. Now, when a local song plays, the native layer lists .lrc/.vtt files in its folder and serves their bytes, and the page decodes (UTF-8 → GBK → Big5) and parses them; without a sidecar it reads embedded lyrics (MP3 ID3 USLT, FLAC/Ogg Vorbis LYRICS, M4A ©lyr). The result is saved back, so the next play needs no reading.",
+      },
+      "fixes": {
+        "encoding": "Old .lrc files are often GBK/Big5 with no declaration; decoding tries UTF-8, GBK then Big5 so the page is never mojibake.",
+        "id3size": "ID3v2.3 stores a plain 32-bit size while v2.4 uses synchsafe; both are handled (v2.3 is what old rips use).",
+        "lazy": "Only the first 2 MB of that one track is read, never a per-song pass at import, so a 2000-song library does not slow down.",
+        "cache": "Lyrics are written back and the library is refreshed, so the playing track updates without reopening it."
+      }
+    },
+    "v0_9_8": {
+      "intro": "0.9.8 fixes the steering-wheel pause key (working only the first time) and songs that would not play: media keys are now held the way Aurora does it, and formats WebView cannot decode are handed to the car unit's own decoder.",
+      "steeringWheel": {
+        "title": "The wheel's pause key no longer works only once",
+        "description": "The app only owned keys while it was in the foreground, so after a pause the head unit routed them back to its built-in player; on top of that the MediaSession and Activity entry points each delivered the press and cancelled each other. Now audio focus is taken while playing and released on pause, the playback position is refreshed every second so the session stays live, duplicate deliveries are dropped, and tapping the media panel can bring the app back.",
+      },
+      "formatFallback": {
+        "title": "Undecodable formats go to the car's decoder (Aurora's approach)",
+        "description": "ALAC in m4a, APE, WMA, DSF/DFF and TTA never decoded in WebView. On a decode/unsupported error the native layer now decodes with MediaExtractor + MediaCodec into a 16-bit stereo WAV in the cache and swaps the source to it, so the UI, lyrics, spectrum and wheel keys all keep working. If the car can decode it, it plays — exactly the rule Aurora follows.",
+      },
+      "fixes": {
+        "audioFocus": "AUDIOFOCUS_GAIN is requested while playing and released on pause; navigation prompts and calls pause playback, same as Aurora.",
+        "positionReport": "The page reports its position every second, so the head unit's progress bar and playing state no longer sit at zero.",
+        "mimeSniff": "Unknown formats no longer pretend to be audio/mpeg (which made WebView try an MP3 parse first); octet-stream fails immediately so the transcode can take over.",
+        "cacheLimit": "Converted WAVs are kept for two weeks only (about 50 MB per five-minute song) so storage is not eaten up."
+      }
+    },
+    "v0_9_7": {
+      "intro": "0.9.7 replaces the mojibake heuristic: instead of demanding that a string be 90% Chinese, it compares which decoding looks most like real text. Mixed Chinese/English titles, single-character labels and album names containing English are now repaired.",
+      "mixedTitle": {
+        "title": "Mixed Chinese/English titles are repaired too",
+        "description": "Titles like “Track 01 愛” or “Live 演唱會” used to be left alone because the Chinese share was under nine tenths. UTF-8 reinterpretation, GBK, Big5 and the ID3-specific repair are now scored together, and the most plausible one wins.",
+      },
+      "singleChar": {
+        "title": "Single-character labels (“李”) are repaired",
+        "description": "A title or album with only one character used to be skipped by the “at least two Chinese characters” rule. Short strings now have their own rule, so a single character is recovered as well.",
+      },
+      "noOverFix": {
+        "title": "Real Western text is not forced into Chinese",
+        "description": "“Björk”, “Café” and “Mötley Crüe” stay untouched: a candidate must score clearly better (1.2 points) than the original, and the GBK trail-byte trap (ö + r read as one Chinese character) is rejected.",
+      },
+      "fixes": {
+        "existingLibrary": "Garbled text already in the library is re-judged and written back, no re-import needed (manually renamed titles are left alone).",
+        "filenameFallback": "Tracks without embedded tags that fall back to the file name now get the file name repaired too.",
+        "unitTests": "Nine encoding regression tests added (GBK, Big5, UTF-8, UTF-16, mixed, single character, Western text, artist lists, import snapshot)."
+      }
+    },
+    "v0_9_6": {
+      "intro": "0.9.6 fixes tracks that could not be measured at all, and makes measuring much cheaper: no more decoding the whole file.",
+      "moreFormats": {
+        "title": "m4a / ogg / opus / DSD are recognised now",
+        "description": "Previously only flac, wav, aiff and mp3 were recognised; everything else stayed blank. m4a (AAC/ALAC), ogg (Vorbis/Opus) and dsf/dff (DSD) now report sample rate and bit depth, and m4a without faststart falls back to reading the moov at the end of the file. MP3 sync now requires the next frame to sit exactly where it should, so compressed data is no longer mistaken for 44.1k lossy.",
+      },
+      "sliceDecode": {
+        "title": "Lossless checks read only 12 MB",
+        "description": "Measuring used to read the whole file: a 5-minute 48 kHz FLAC meant hundreds of MB of decoded audio. Now lossless files read the first 12 MB (about 85 seconds), while self-syncing formats such as MP3 start at 45% and read 12 MB. The analysis window is still 20 seconds from the middle, the verdict is the same, and it is an order of magnitude faster. Only files that refuse to decode fall back to a full read.",
+      },
+      "parallelProbe": {
+        "title": "Header reads and measurements run in small batches",
+        "description": "Header pass runs 4 lanes so the head unit's eMMC/USB can actually use its I/O bandwidth; measurements run 2 at a time. Rows computed per list view went from 150 to 200, measured lossless tracks from 40 to 80, and results appear row by row while scrolling.",
+      },
+      "noBlankRow": {
+        "title": "Unreadable files no longer leave a gap",
+        "description": "If a file moved, lost permission or uses a container we truly cannot read, the column shows Unjudged instead of staying blank. Such failures are remembered only for this session and retried on the next launch.",
