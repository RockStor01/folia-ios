diff --git a/src/services/audioQuality/inspectAudioQuality.ts b/src/services/audioQuality/inspectAudioQuality.ts
new file mode 100644
index 0000000..8b1935b
--- /dev/null
+++ b/src/services/audioQuality/inspectAudioQuality.ts
@@ -0,0 +1,212 @@
+// src/services/audioQuality/inspectAudioQuality.ts
+// 一次體檢：檔頭讀容器的自稱規格 → 用 Web Audio 解碼 → 量頻譜 → 出結論。
+//
+// 這是 Aurora（com.aurora.music）那套「音質檢測」的網頁／iOS 版：iOS 沒有 ffmpeg，
+// 所以解碼靠 decodeAudioData，量化靠 qualitySpectrum.ts 的 FFT。平台限制也寫在這裡：
+// WebKit 的 OfflineAudioContext 取樣率上限 96 kHz，超過的檔案只能標記為「無法在此裝置判斷」。
+
+import { decodeAtRate } from '../analysis/trackAudio';
+import { probeContainer, type ContainerProbe } from './qualityProbe';
+import { averageSpectrum, summariseBand } from './qualitySpectrum';
+
+export type QualityLevel = 'ok' | 'info' | 'warn' | 'bad';
+
+export type QualityVerdictKind =
+    | 'ok'
+    | 'fakeLossless'
+    | 'narrowBand'
+    | 'upsampled'
+    | 'depthMismatch'
+    | 'lossy'
+    | 'containerUnknown';
+
+export interface QualityVerdict {
+    kind: QualityVerdictKind;
+    /** 已經格式化好的字串，直接丟進 i18n 的 {{}} 佔位符。 */
+    params: Record<string, string>;
+}
+
+export interface QualityMeasurement {
+    cutoffHz: number | null;
+    nyquistHz: number;
+    transitionHz: number | null;
+    refDb: number;
+    frames: number;
+    /** 畫圖用的頻譜曲線：對數頻率軸上等距取樣，值是相對參考電平的 dB（已夾在 −90…+5）。 */
+    curve: QualityCurve | null;
+}
+
+export interface QualityCurve {
+    /** 取樣點數。第 i 點的頻率是 20 * (nyquist / 20) ** (i / (points - 1))。 */
+    points: number[];
+    /** 對數軸的起點與終點（Hz），畫圖時用它把第 i 點換回頻率。 */
+    minHz: number;
+    maxHz: number;
+}
+
+export interface QualityInspectResult {
+    fileName: string;
+    ok: boolean;
+    /** 失敗原因，也是 i18n 鍵（qualityCheck.error.*）。 */
+    error?: 'unsupportedContainer' | 'decodeFailed' | 'tooShort' | 'hiresTooWide';
+    container: ContainerProbe | null;
+    measured: QualityMeasurement | null;
+    verdicts: QualityVerdict[];
+    level: QualityLevel;
+}
+
+/** 分析的窗長（秒）、WebKit 的取樣率上限，以及 FFT 至少需要一整窗。 */
+const WINDOW_SECONDS = 20;
+const MAX_CONTEXT_RATE = 96000;
+const QUALITY_MIN_SAMPLES = 8192;
+
+/** 有損編碼器按截止點反推的碼率區間；只是粗略對照，不是量測。 */
+const approximateBitrate = (cutoffHz: number): string => {
+    const ratio = cutoffHz / 44100;
+    if (ratio < 0.35) return '64–96';
+    if (ratio < 0.42) return '128';
+    if (ratio < 0.47) return '192';
+    if (ratio < 0.49) return '256–320';
+    return '';
+};
+
+const fmtK = (hz: number): string => (hz / 1000).toFixed(2);
+const fmtRate = (hz: number): string => (hz / 1000).toFixed(hz % 1000 === 0 ? 0 : 1);
+
+/** 取中段一段樣本，避開片頭淡入與靜音段。 */
+const pickWindow = (buffer: AudioBuffer): Float32Array => {
+    const rate = buffer.sampleRate;
+    const wantFrames = Math.min(buffer.length, Math.round(WINDOW_SECONDS * rate));
+    const start = buffer.length > wantFrames * 2
+        ? Math.min(Math.round(buffer.length * 0.25), buffer.length - wantFrames)
+        : 0;
+    const left = buffer.getChannelData(0);
+    const samples = new Float32Array(wantFrames);
+    if (buffer.numberOfChannels > 1) {
+        const right = buffer.getChannelData(1);
+        for (let i = 0; i < wantFrames; i += 1) samples[i] = (left[start + i] + right[start + i]) / 2;
+    } else {
+        for (let i = 0; i < wantFrames; i += 1) samples[i] = left[start + i];
+    }
+    return samples;
+};
+
+/** 曲線點數：夠密看不出折線，又不至於讓每筆結果變成一大塊資料。 */
+const CURVE_POINTS = 240;
+const CURVE_MIN_HZ = 20;
+
+/** 把 dB 譜換成對數頻率軸上的等距取樣，供頻譜圖直接畫。 */
+const buildCurve = (db: Float64Array, freqPerBin: number, refDb: number, nyquist: number): QualityCurve => {
+    const points: number[] = [];
+    for (let i = 0; i < CURVE_POINTS; i += 1) {
+        const hz = CURVE_MIN_HZ * (nyquist / CURVE_MIN_HZ) ** (i / (CURVE_POINTS - 1));
+        const bin = Math.min(db.length - 1, Math.max(0, Math.round(hz / freqPerBin)));
+        const relative = db[bin] - refDb;
+        points.push(Math.max(-90, Math.min(5, Math.round(relative * 10) / 10)));
+    }
+    return { points, minHz: CURVE_MIN_HZ, maxHz: nyquist };
+};
+
+const judge = (container: ContainerProbe | null, cutoffHz: number | null, transitionHz: number | null): { verdicts: QualityVerdict[]; level: QualityLevel } => {
+    const verdicts: QualityVerdict[] = [];
+    let level: QualityLevel = 'ok';
+
+    if (!container || !container.sampleRate) {
+        verdicts.push({ kind: 'containerUnknown', params: {} });
+        return { verdicts, level: 'info' };
+    }
+
+    const nyquist = container.sampleRate / 2;
+    const gap = cutoffHz ? nyquist - cutoffHz : null;
+
+    if (container.lossless && cutoffHz && gap !== null && gap > 1500 && cutoffHz < nyquist * 0.97) {
+        if (transitionHz !== null && transitionHz < 800) {
+            verdicts.push({ kind: 'fakeLossless', params: { sampleRate: fmtRate(container.sampleRate), cutoff: fmtK(cutoffHz), transition: String(transitionHz) } });
+            level = 'bad';
+        } else {
+            verdicts.push({ kind: 'narrowBand', params: { cutoff: fmtK(cutoffHz), transition: String(transitionHz ?? 0) } });
+            level = 'warn';
+        }
+    }
+
+    if (container.sampleRate >= 88200 && cutoffHz && cutoffHz <= nyquist * 0.6) {
+        verdicts.push({ kind: 'upsampled', params: { sampleRate: fmtRate(container.sampleRate), cutoff: fmtK(cutoffHz) } });
+        level = 'bad';
+    }
+
+    if (container.bitDepth > 0 && container.bitDepth <= 16 && container.sampleRate >= 88200) {
+        verdicts.push({ kind: 'depthMismatch', params: { bitDepth: String(container.bitDepth), sampleRate: fmtRate(container.sampleRate) } });
+        if (level !== 'bad') level = 'warn';
+    }
+
+    if (!container.lossless && cutoffHz) {
+        const bitrate = approximateBitrate(cutoffHz);
+        verdicts.push({
+            kind: 'lossy',
+            params: { codec: container.codec.toUpperCase(), cutoff: fmtK(cutoffHz), bitrate },
+        });
+        if (level === 'ok') level = 'info';
+    }
+
+    if (!verdicts.length) {
+        verdicts.push({
+            kind: 'ok',
+            params: {
+                sampleRate: fmtRate(container.sampleRate),
+                bitDepth: container.bitDepth ? String(container.bitDepth) : '?',
+                cutoff: fmtK(cutoffHz ?? nyquist),
+            },
+        });
+    }
+    return { verdicts, level };
+};
+
+/** 檢查一份音訊的位元組。檔案名稱只用來判斷格式與顯示。 */
+export const inspectAudioBytes = async (bytes: ArrayBuffer, fileName: string): Promise<QualityInspectResult> => {
+    const container = probeContainer(bytes);
+    const failed = (error: QualityInspectResult['error']): QualityInspectResult => ({
+        fileName, ok: false, error, container, measured: null, verdicts: [], level: 'warn',
+    });
+
+    if (container && container.sampleRate > MAX_CONTEXT_RATE) return failed('hiresTooWide');
+
+    // 容器取樣率就是解碼取樣率：decodeAudioData 會重採樣到 context 的取樣率，
+    // 用它自己的取樣率建 context，量到的 Nyquist 才跟容器說的一致。
+    const rate = container?.sampleRate
+        ? Math.min(Math.max(container.sampleRate, 8000), MAX_CONTEXT_RATE)
+        : 48000;
+    const decoded = await decodeAtRate(bytes, rate);
+    if (!decoded) return failed('decodeFailed');
+    if (decoded.length < QUALITY_MIN_SAMPLES) return failed('tooShort');
+
+    const spectrum = averageSpectrum(pickWindow(decoded), decoded.sampleRate);
+    if (!spectrum) return failed('tooShort');
+    const band = summariseBand(spectrum);
+    const { verdicts, level } = judge(container, band.cutoffHz, band.transitionHz);
+
+    return {
+        fileName,
+        ok: true,
+        container,
+        measured: {
+            cutoffHz: band.cutoffHz,
+            nyquistHz: decoded.sampleRate / 2,
+            transitionHz: band.transitionHz,
+            refDb: Math.round(band.refDb * 10) / 10,
+            frames: spectrum.frames,
+            curve: buildCurve(spectrum.db, spectrum.freqPerBin, band.refDb, decoded.sampleRate / 2),
+        },
+        verdicts,
+        level,
+    };
+};
+
+/** 檔案選擇器拿到的 File。 */
+export const inspectAudioFile = async (file: File): Promise<QualityInspectResult> => {
+    try {
+        return await inspectAudioBytes(await file.arrayBuffer(), file.name);
+    } catch (error) {
+        console.warn('[QualityInspect] could not read file', error);
+        return { fileName: file.name, ok: false, error: 'decodeFailed', container: null, measured: null, verdicts: [], level: 'warn' };
+    }
+};
diff --git a/src/services/audioQuality/inspectLocalLibrary.ts b/src/services/audioQuality/inspectLocalLibrary.ts
new file mode 100644
index 0000000..5eb0584
--- /dev/null
+++ b/src/services/audioQuality/inspectLocalLibrary.ts
@@ -0,0 +1,53 @@
+// src/services/audioQuality/inspectLocalLibrary.ts
+// 掃本地曲庫：把每一首已經在庫裡的本機檔案拿來體檢，找出被撐大的「無損」。
+//
+// 一次只讀一首、量完就丟（decodeAudioData 的 AudioBuffer 動輒幾十 MB，iOS 上不能留），
+// 而且照順序跑：同時解碼好幾首會直接把手機記憶體打爆。掃描可以中止，結果逐筆回報。
+
+import { getLocalSongs } from '../db';
+import { getLocalSongArrayBuffer } from '../localMusicService';
+import type { LocalSong } from '../../types';
+import { inspectAudioBytes, type QualityInspectResult } from './inspectAudioQuality';
+
+export interface LibraryScanOptions {
+    /** 最多檢查幾首（從最近加入的開始）；不給就全部。 */
+    limit?: number;
+    abort?: AbortSignal;
+    /** 每完成一首就回報一次，讓介面即時長出結果。 */
+    onProgress?: (done: number, total: number) => void;
+    onResult?: (result: QualityInspectResult) => void;
+}
+
+const AUDIO_FILE = /\.(flac|wav|aiff|aif|mp3|m4a|aac|ogg|opus|wma|ape|wv|dsf|dff)$/i;
+
+/** 讀不到的檔案（權限掉了、檔案搬走了）不算結果，跳過就好。 */
+export const scanLocalLibraryQuality = async ({ limit, abort, onProgress, onResult }: LibraryScanOptions = {}): Promise<QualityInspectResult[]> => {
+    const songs = (await getLocalSongs() as LocalSong[])
+        .filter(song => AUDIO_FILE.test(song.fileName))
+        .sort((a, b) => (b.addedAt ?? 0) - (a.addedAt ?? 0));
+    const queue = limit && limit > 0 ? songs.slice(0, limit) : songs;
+
+    const results: QualityInspectResult[] = [];
+    for (let index = 0; index < queue.length; index += 1) {
+        if (abort?.aborted) break;
+        const song = queue[index];
+        try {
+            const bytes = await getLocalSongArrayBuffer(song);
+            if (bytes) {
+                const result = await inspectAudioBytes(bytes, song.fileName);
+                results.push(result);
+                onResult?.(result);
+            }
+        } catch (error) {
+            console.warn('[QualityInspect] could not inspect a local song', song.fileName, error);
+        }
+        onProgress?.(index + 1, queue.length);
+    }
+    return results;
+};
+
+/** 曲庫裡有多少首能檢查的檔案（介面上先說清楚範圍）。 */
+export const countInspectableLocalSongs = async (): Promise<number> => {
+    const songs = await getLocalSongs() as LocalSong[];
+    return songs.filter(song => AUDIO_FILE.test(song.fileName)).length;
+};
diff --git a/src/services/audioQuality/qualityProbe.ts b/src/services/audioQuality/qualityProbe.ts
new file mode 100644
index 0000000..d4475a1
--- /dev/null
+++ b/src/services/audioQuality/qualityProbe.ts
@@ -0,0 +1,160 @@
+// src/services/audioQuality/qualityProbe.ts
+// 只讀檔頭：容器「自稱」是幾 kHz、幾 bit，不碰音訊資料。
+//
+// Web Audio 的 decodeAudioData 只給回解碼後的 AudioBuffer，取樣率已經被重採樣到 context 的
+// 取樣率，所以「容器標稱」必須從位元組自己讀，否則量到的 Nyquist 永遠是我們自己選的。
+// 這裡只處理常見的幾種容器；讀不出來的（m4a、ogg…）交給呼叫端當「無法判斷容器」處理。
+
+export interface ContainerProbe {
+    codec: string;
+    /** 容器自稱的取樣率（Hz）；0 = 讀不出來。 */
+    sampleRate: number;
+    /** 容器自稱的位元（FLAC / WAV / AIFF 才有）；0 = 不知道。 */
+    bitDepth: number;
+    channels: number;
+    /** 容器本身是否無損（判斷「假無損」的前提）。 */
+    lossless: boolean;
+    /** 總長（秒）；null = 不知道。 */
+    durationSec: number | null;
+}
+
+const MPEG1_RATES = [44100, 48000, 32000];
+const MPEG2_RATES = [22050, 24000, 16000];
+const MPEG25_RATES = [11025, 12000, 8000];
+
+const probeFlac = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 34 || bytes[0] !== 0x66 || bytes[1] !== 0x4c || bytes[2] !== 0x61 || bytes[3] !== 0x43) return null;
+    // STREAMINFO 的資料從 offset 8 開始：minBlock 2 + maxBlock 2 + minFrame 3 + maxFrame 3 = 10 bytes
+    // 之後 8 bytes 依序是：取樣率 20 bit、聲道 3 bit、位深 5 bit、總樣本數 36 bit。
+    const b18 = bytes[18];
+    const b19 = bytes[19];
+    const b20 = bytes[20];
+    const b21 = bytes[21];
+    const sampleRate = (b18 << 12) | (b19 << 4) | (b20 >> 4);
+    const channels = ((b20 >> 1) & 0x07) + 1;
+    const bitDepth = (((b20 & 0x01) << 4) | (b21 >> 4)) + 1;
+    const totalSamples = (b21 & 0x0f) * 2 ** 32
+        + bytes[22] * 2 ** 24 + bytes[23] * 2 ** 16 + bytes[24] * 2 ** 8 + bytes[25];
+    if (!sampleRate) return null;
+    return {
+        codec: 'flac',
+        sampleRate,
+        bitDepth,
+        channels,
+        lossless: true,
+        durationSec: totalSamples ? totalSamples / sampleRate : null,
+    };
+};
+
+const probeWav = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 44) return null;
+    const tag = String.fromCharCode(bytes[0], bytes[1], bytes[2], bytes[3]);
+    if (tag !== 'RIFF') return null;
+    if (String.fromCharCode(bytes[8], bytes[9], bytes[10], bytes[11]) !== 'WAVE') return null;
+
+    let offset = 12;
+    let sampleRate = 0;
+    let channels = 0;
+    let bitDepth = 0;
+    let dataBytes = 0;
+    while (offset + 8 <= bytes.length) {
+        const id = String.fromCharCode(bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
+        const size = bytes[offset + 4] | (bytes[offset + 5] << 8) | (bytes[offset + 6] << 16) | (bytes[offset + 7] << 24);
+        const body = offset + 8;
+        if (id === 'fmt ' && body + 16 <= bytes.length) {
+            channels = bytes[body + 2] | (bytes[body + 3] << 8);
+            sampleRate = bytes[body + 4] | (bytes[body + 5] << 8) | (bytes[body + 6] << 16) | (bytes[body + 7] << 24);
+            bitDepth = bytes[body + 14] | (bytes[body + 15] << 8);
+            if (!bitDepth) {
+                // WAVE_FORMAT_EXTENSIBLE：容器位深在 validBitsPerSample
+                const valid = body + 18 <= bytes.length ? (bytes[body + 18] | (bytes[body + 19] << 8)) : 0;
+                bitDepth = valid || 0;
+            }
+        } else if (id === 'data') {
+            dataBytes = Math.max(0, size);
+            break;
+        }
+        offset = body + size + (size % 2);
+        if (size <= 0) break;
+    }
+    if (!sampleRate) return null;
+    const durationSec = (channels && bitDepth && dataBytes)
+        ? dataBytes / (sampleRate * channels * Math.max(1, bitDepth / 8))
+        : null;
+    return { codec: 'wav', sampleRate, bitDepth, channels, lossless: true, durationSec };
+};
+
+/** AIFF 的取樣率是 80-bit IEEE 754 extended 格式。 */
+const readExtendedFloat = (bytes: Uint8Array, offset: number): number => {
+    const sign = bytes[offset] & 0x80 ? -1 : 1;
+    const exponent = ((bytes[offset] & 0x7f) << 8) | bytes[offset + 1];
+    if (exponent === 0 && bytes[offset + 2] === 0) return 0;
+    let mantissa = 0;
+    for (let i = 0; i < 8; i += 1) mantissa = mantissa * 256 + bytes[offset + 2 + i];
+    return sign * mantissa * 2 ** (exponent - 16383 - 63);
+};
+
+const probeAiff = (bytes: Uint8Array): ContainerProbe | null => {
+    if (bytes.length < 12) return null;
+    if (String.fromCharCode(bytes[0], bytes[1], bytes[2], bytes[3]) !== 'FORM') return null;
+    const form = String.fromCharCode(bytes[8], bytes[9], bytes[10], bytes[11]);
+    if (form !== 'AIFF' && form !== 'AIFC') return null;
+
+    let offset = 12;
+    while (offset + 8 <= bytes.length) {
+        const id = String.fromCharCode(bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
+        const size = bytes[offset + 4] * 2 ** 24 + bytes[offset + 5] * 2 ** 16 + bytes[offset + 6] * 2 ** 8 + bytes[offset + 7];
+        const body = offset + 8;
+        if (id === 'COMM' && body + 18 <= bytes.length) {
+            const channels = bytes[body] * 2 ** 8 + bytes[body + 1];
+            const frames = bytes[body + 2] * 2 ** 24 + bytes[body + 3] * 2 ** 16 + bytes[body + 4] * 2 ** 8 + bytes[body + 5];
+            const bitDepth = bytes[body + 6] * 2 ** 8 + bytes[body + 7];
+            const sampleRate = readExtendedFloat(bytes, body + 8);
+            if (!sampleRate) return null;
+            return {
+                codec: form === 'AIFC' ? 'aifc' : 'aiff',
+                sampleRate: Math.round(sampleRate),
+                bitDepth,
+                channels,
+                lossless: true,
+                durationSec: frames ? frames / sampleRate : null,
+            };
+        }
+        if (size <= 0) break;
+        offset = body + size + (size % 2);
+    }
+    return null;
+};
+
+const probeMp3 = (bytes: Uint8Array): ContainerProbe | null => {
+    let start = 0;
+    if (bytes.length > 10 && bytes[0] === 0x49 && bytes[1] === 0x44 && bytes[2] === 0x33) {
+        // ID3v2 標頭 10 bytes，大小是 syncsafe 整數
+        const size = (bytes[6] & 0x7f) * 2 ** 21 + (bytes[7] & 0x7f) * 2 ** 14 + (bytes[8] & 0x7f) * 2 ** 7 + (bytes[9] & 0x7f);
+        start = 10 + size;
+    }
+    const limit = Math.min(bytes.length - 4, start + 4096);
+    for (let i = start; i < limit; i += 1) {
+        if (bytes[i] !== 0xff || (bytes[i + 1] & 0xe0) !== 0xe0) continue;
+        const versionBits = (bytes[i + 1] >> 3) & 0x03;
+        const layerBits = (bytes[i + 1] >> 1) & 0x03;
+        const rateIndex = (bytes[i + 2] >> 2) & 0x03;
+        if (layerBits === 0 || rateIndex === 3) continue;
+        const rates = versionBits === 3 ? MPEG1_RATES : versionBits === 2 ? MPEG2_RATES : MPEG25_RATES;
+        return {
+            codec: 'mp3',
+            sampleRate: rates[rateIndex],
+            bitDepth: 0,
+            channels: ((bytes[i + 3] >> 6) & 0x03) === 3 ? 1 : 2,
+            lossless: false,
+            durationSec: null,
+        };
+    }
+    return null;
+};
+
+/** 讀檔頭得到容器自稱的規格；讀不出來時回 null。 */
+export const probeContainer = (buffer: ArrayBuffer): ContainerProbe | null => {
+    const bytes = new Uint8Array(buffer, 0, Math.min(buffer.byteLength, 64 * 1024));
+    return probeFlac(bytes) ?? probeWav(bytes) ?? probeAiff(bytes) ?? probeMp3(bytes);
+};
