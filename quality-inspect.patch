+// src/utils/textEncodingRepair.ts
+// 車機與舊曲庫最常見的兩種亂碼，都是「字串被當成別的編碼解了一次」：
+//   1. UTF-8 的位元組被當成 ISO-8859-1 解（"Ã¦ÂµÂÃ"、"â€™" 這類），中文歌名就變成 ÀÌ…
+//   2. 中文 GBK 位元組被當成 ISO-8859-1 解（"¸ÃËÀµÄÎÂÈá"），既有的 legacyTagTextRepair 只修 ID3，
+//      Android 的 MediaMetadataRetriever 與某些容器不帶「這是 ID3」的線索，所以在這裡放寬。
+// 另外補一個 Big5（繁中標籤）的嘗試。每個候選都要通過嚴格驗證才採用，正常文字一律原樣返回。
+
+const CJK_TEXT_PATTERN = /[\u3000-\u303f\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uff01-\uff60]/u;
+const SUSPICIOUS_LATIN1_PATTERN = /[\u00c2\u00c3\u00e2\u00f0]/;
+const SUSPICIOUS_LOW_LATIN1 = /[\u00a8\u00a1\u0080-\u009f]/;
+
+const decode = (label: string, bytes: Uint8Array): string | null => {
+    try {
+        return new TextDecoder(label, { fatal: true }).decode(bytes);
+    } catch {
+        return null;
+    }
+};
+
+const latin1Bytes = (text: string): Uint8Array | null => {
+    const bytes = new Uint8Array(text.length);
+    for (let index = 0; index < text.length; index += 1) {
+        const code = text.charCodeAt(index);
+        if (code > 0xff) return null;
+        bytes[index] = code;
+    }
+    return bytes;
+};
+
+/** 「看得出來是壞的」：拉丁補充區的常見開頭字元、控制區殘留，或解碼留下的替換字元。 */
+const looksBroken = (text: string): boolean => (
+    SUSPICIOUS_LATIN1_PATTERN.test(text)
+    || SUSPICIOUS_LOW_LATIN1.test(text)
+    || /\ufffd/u.test(text)
+);
+
+const tryUtf8Reinterpretation = (text: string): string | null => {
+    const bytes = latin1Bytes(text);
+    if (!bytes) return null;
