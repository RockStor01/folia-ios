diff --git a/src/index.css b/src/index.css
index 45c14da..a9fce0d 100644
--- a/src/index.css
+++ b/src/index.css
@@ -462,3 +462,26 @@ html[data-click-through='active'] body .click-through-interactive * {
     animation: none;
     opacity: 0.9;
 }
+
+/* ── 觸屏與 iPhone 安全區 ────────────────────────────────────────────────
+   兩件事只動「手指用得到什麼」，不改任何版面比例或視覺風格：
+
+   1. iOS 沒有 hover。原本靠 group-hover 才浮出來的操作（待播清單列右邊的按鈕、
+      卡片上的播放遮罩、拖拽把手）在觸屏上永遠出不來，這裡讓它們常顯。
+   2. 安全區只有 viewport-fit=cover + env() 才算得出來；底部膠囊的讓位在
+      FloatingPlayerControls 裡吃 --folia-safe-bottom。家指示條、劉海都不再壓住東西。 */
+:root {
+  --folia-safe-bottom: env(safe-area-inset-bottom, 0px);
+  --folia-safe-top: env(safe-area-inset-top, 0px);
+  --folia-safe-left: env(safe-area-inset-left, 0px);
+  --folia-safe-right: env(safe-area-inset-right, 0px);
+}
+
+@media (hover: none) {
+  /* group-hover 的產物在沒有 hover 的裝置上直接顯示，不再等一個永遠不會來的指針。 */
+  .group .group-hover\:opacity-100 { opacity: 1; }
+  .group .group-hover\:w-auto { width: auto; }
+  .group .group-hover\:translate-x-0 { translate: 0 0; transform: none; }
+  .group .group-hover\:max-w-28 { max-width: 7rem; }
+  .group .group-hover\:ml-1\.5 { margin-left: 0.375rem; }
+}
