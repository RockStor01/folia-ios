+import { describe, expect, it } from 'vitest';
+import { isUnsupportedOnDevice, unsupportedFormatLabel } from '@/utils/deviceDecodeSupport';
+
+// test/unit/deviceDecodeSupport.test.ts
+// v0.9.18：車機沒有解碼器的容器要在 JS 先擋掉，否則 MediaExtractor 碰到 DSD 可能在原生層崩掉。
+
+describe('deviceDecodeSupport', () => {
+    it('把 DSD／APE／WavPack／TAK／TTA 認成解不開', () => {
+        for (const name of ['a.dsf', 'b.DFF', 'c.ape', 'd.wv', 'e.tak', 'f.tta']) {
+            expect(isUnsupportedOnDevice(name)).toBe(true);
+        }
+    });
+
+    it('FLAC／WAV／ALAC／MP3 仍然照常播', () => {
+        for (const name of ['a.flac', 'b.wav', 'c.m4a', 'd.mp3', 'e.aiff']) {
+            expect(isUnsupportedOnDevice(name)).toBe(false);
+        }
+    });
+
+    it('空值不算，也不因為路徑片段誤判', () => {
+        expect(isUnsupportedOnDevice(undefined)).toBe(false);
+        expect(isUnsupportedOnDevice('')).toBe(false);
+        expect(isUnsupportedOnDevice('曲目.dsforce.flac')).toBe(false);
+    });
+
+    it('格式標籤給使用者看得懂的名字', () => {
+        expect(unsupportedFormatLabel('專輯/track01.dsf')).toBe('DSD');
+        expect(unsupportedFormatLabel('x.DFF')).toBe('DSD');
+        expect(unsupportedFormatLabel('x.ape')).toBe('APE');
+        expect(unsupportedFormatLabel('x.wv')).toBe('WavPack');
+        expect(unsupportedFormatLabel('x.tak')).toBe('TAK');
+        expect(unsupportedFormatLabel('x.tta')).toBe('TTA');
+        expect(unsupportedFormatLabel('x.bin')).toBe('BIN');
+        expect(unsupportedFormatLabel(undefined)).toBe('這個格式');
+    });
+});
