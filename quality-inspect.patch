+++ b/src/hooks/useNativeMediaKeys.ts
@@ -0,0 +1,96 @@
+import type React from 'react';
+// src/hooks/useNativeMediaKeys.ts
+// 車機方控（方向盤按鍵）在 WebView 裡接不到的原因：WebView 不向系統註冊 MediaSession，
+// navigator.mediaSession 只對 Chromium 自己的媒體鍵路由有效。原生層（FoliaNativeStorage.java）
+// 因此建了一個真的 MediaSession + dispatchKeyEvent 攔截，把按鍵用 evaluateJavascript 丟進來。
+//
+// 這裡就是那個接收端：把 'playPause' / 'pause' / 'next' / 'prev' 對到播放器既有的控制函式，
+// 並把目前的播放狀態與位置回報給原生層（否則系統無法判斷 PLAY_PAUSE 該播還是該停）。
+//
+// v0.9.8：判斷「現在是在播還是停」改成直接讀音訊元素的真實狀態。
+// 之前讀的是 store 裡的 displayPlayerState，混音（automix）換歌的那一小段它可能是 IDLE，
+// 於是一按 PLAY_PAUSE 就被當成「要播放」，再按還是「要播放」——方控看起來就整顆失效。
+// 另外每秒把 position 回報一次，車機的媒體面板才不會把按鍵路由回內建播放器。
+
+import { useEffect, useRef } from 'react';
+import { reportNativePlayback, setNativePauseOnFocusLoss } from '../services/nativeLinkedStorage';
+import { useAudioSettingsStore } from '../stores/useAudioSettingsStore';
+
+interface NativeMediaKeyOptions {
+    playRef: React.RefObject<() => Promise<void>>;
+    pauseRef: React.RefObject<() => void>;
+    prevRef: React.RefObject<() => void>;
+    nextRef: React.RefObject<() => Promise<void> | void>;
+    playerState: string;
+    /** 音訊元素的真實狀態；有它就不再依賴（可能落後的）store 狀態。 */
+    audioRef?: React.RefObject<HTMLAudioElement | null>;
+}
+
+type MediaKey = 'playPause' | 'play' | 'pause' | 'next' | 'prev';
+
+const start = (fn: (() => Promise<void> | void) | undefined) => {
+    if (!fn) return;
+    try {
+        const result = fn();
+        if (result && typeof (result as Promise<void>).catch === 'function') {
+            (result as Promise<void>).catch(() => undefined);
+        }
+    } catch {
+        // 控制函式自己會處理失敗；這裡只是不讓方控的按鍵把整個 hook 帶走。
+    }
+};
+
+export const useNativeMediaKeys = ({ playRef, pauseRef, prevRef, nextRef, playerState, audioRef }: NativeMediaKeyOptions): void => {
+    const stateRef = useRef(playerState);
+    stateRef.current = playerState;
+
+    useEffect(() => {
+        const isPlayingNow = () => {
+            const element = audioRef?.current;
+            if (element) return !element.paused && !element.ended;
+            return stateRef.current === 'playing';
+        };
+        const handler = (key: MediaKey) => {
+            // 方控多數只給一顆 PLAY_PAUSE，所以依目前狀態自己決定方向；
+            // 明確的 play / pause 還是照傳進來的走（有些車機是兩顆鍵）。
+            if (key === 'playPause') {
+                if (isPlayingNow()) start(pauseRef.current);
+                else start(playRef.current);
+                return;
+            }
+            if (key === 'play') { start(playRef.current); return; }
+            if (key === 'pause') { start(pauseRef.current); return; }
+            if (key === 'next') { start(nextRef.current); return; }
+            if (key === 'prev') { start(prevRef.current); }
+        };
+
+        (window as unknown as Record<string, unknown>).__foliaNativeMediaKey = handler;
+        return () => {
+            delete (window as unknown as Record<string, unknown>).__foliaNativeMediaKey;
+        };
+    }, [audioRef, nextRef, pauseRef, playRef, prevRef]);
+
+    // v0.9.11：把「被搶焦點時要不要暫停」的設定下发给原生層。預設關——車機的電台/DSP 反覆搶
+    // 焦點時，一搶就暫停會讓播放鍵看起來壞掉（點播放立刻變暫停、怎麼點怎麼暫停）。
+    const pauseOnFocusLoss = useAudioSettingsStore(state => state.pauseOnAudioFocusLoss);
+    useEffect(() => {
+        setNativePauseOnFocusLoss(pauseOnFocusLoss);
+    }, [pauseOnFocusLoss]);
+
+    useEffect(() => {
+        reportNativePlayback(playerState === 'playing', audioRef?.current?.currentTime ?? 0, audioRef?.current?.duration ?? 0);
+    }, [audioRef, playerState]);
+
+    // 播放中每秒上報一次位置：車機的媒體面板據此畫進度，也據此認為 session 還活著。
+    useEffect(() => {
+        const timer = window.setInterval(() => {
+            const element = audioRef?.current;
+            const isPlaying = element ? !element.paused && !element.ended : stateRef.current === 'playing';
+            if (!isPlaying) return;
+            reportNativePlayback(true, element?.currentTime ?? 0, element?.duration ?? 0);
+        }, 1000);
+        return () => window.clearInterval(timer);
+    }, [audioRef]);
+};
+
+export default useNativeMediaKeys;
